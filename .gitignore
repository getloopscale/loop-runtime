# ============================================
# LoopZero — .gitignore
# Monorepo: TypeScript (CLI) + Go (API + Operators) + Infra
# ============================================

# --------------------------------------------
# OS & Editor
# --------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
prompts
# Driver prompts for .claude/ halt-loop skills are part of the ecosystem contract
# (per-skill ralph-loop driver). Override the generic `prompts` rule above.
!.claude/skills/**/prompts/
!.claude/skills/**/prompts/**
continue.txt
.yarn
MELHORIAS.txt
ralph-loop.local.md
.claude/ralph-loop.local.md
*.tgz
# --------------------------------------------
# Node.js / TypeScript (cli/)
# --------------------------------------------
node_modules/
dist/
build/

# Dashboard build artifacts + vendored references (355MB, do not commit)
cloud/dashboard/storybook-static/
cloud/dashboard/referencia/

# Composio plugin cache (per-machine, never tracked)
.od/
# Exempt the script module infra/scripts/build/ — it is hand-written sources,
# not Node build output. Without this negation any NEW file added there would
# be silently ignored (catastrophic — see line ~68).
!infra/scripts/build/
*.tsbuildinfo
coverage/
.nyc_output/
*.js.map

# npm / pnpm
*.log
npm-debug.log*
pnpm-debug.log*

# --------------------------------------------
# Go (operators/)
# --------------------------------------------
# Binaries
bin/
!cli/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled Go binaries (should never be committed)
api/main
api/loopzero-api
api/loopzero-controller
api/controller
operators/main
# Per CHG-2026-04-30-INFRA-NORMALIZE D1: 4 split operator binaries
# produced by `go build ./cmd/<op>-operator/`. Built at top level when
# someone forgets to redirect output via -o. Ignored to prevent commit.
operators/app-operator
operators/platform-operator
operators/preview-operator
operators/tenant-operator
cloud/main
# /cmd was previously fully-ignored — but per same lesson as /scripts (2026-05-20),
# silently ignoring a whole top-level dir is catastrophic because CI/build paths
# point inside. Phase 0 T0.1 of plan 2026-05-22-shell-script-strategic-plan.md
# requires cmd/loopzero-ops to be a committed Go package. Allow source files; still
# block compiled binaries.
!/cmd/
/cmd/*/loopzero-ops
/cmd/*/main
# /scripts — REMOVED 2026-05-20 (was catastrophically ignoring directory
# containing 5+ CI-referenced scripts: audit-security-context.sh,
# check-action-pinning.sh, check-divergence-matrix.sh, check-taskfile-
# interface.sh, run-polaris.sh. CI jobs in infra-gates.yml were silently
# failing because their `bash scripts/<name>.sh` commands found no file
# in checkouts.) The original `/scripts` rule was likely intended to
# ignore a top-level `scripts/` directory used as scratch space by some
# previous tooling — but the same path was reused for CI-critical
# scripts and the rule was never re-evaluated.

# Test output
*.test
*.out
__debug_bin*

# kubebuilder
operators/testbin/
operators/config/crd/bases/*.bak

# --------------------------------------------
# Kubernetes / Helm / Infra
# --------------------------------------------
# Tilt
.tilt-dev/
tilt_modules/

# Frontend build artifacts (cloud/dashboard)
dist/
.next/
out/

# Helm — sub-chart .tgz are generated by `helm dependency update`
infra/helm/**/charts/
infra/helm/**/*.tgz
charts/**/charts/*.tgz

# kubeconfig generated by k3d
*.kubeconfig
kubeconfig*

# --------------------------------------------
# Secrets & Environment
# --------------------------------------------
.env
.env.*
!.env.example
Taskfile.local.yml
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

# --------------------------------------------
# Testing & Coverage
# --------------------------------------------
junit*.xml
test-results/
.test-reports/
.test-reports-cleanroom/
__snapshots__/

# --------------------------------------------
# Review artifacts (generated by deep review loop)
# --------------------------------------------
review-output/

# --------------------------------------------
# Miscellaneous
# --------------------------------------------
tmp/
.tmp/
*.bak
*.orig
.env.local
.claude/ralph-loop.local.md
.claude/governance-gate.local.md
.claude/loop-state.local.md

# Reference projects for golden-harvest testing (not part of the codebase)
referencias/
builds/
.actrc
.act-secrets

*.pyc
__pycache__/

# Operator-local files (not committed; T7.1 plan moved canonical Caddyfile to infra/local/)
.local/

# T1.1.c (plan 2026-06-11-code-review-remediation-147-findings v1.2):
# Tilt-rendered helm ConfigMap+Secret output — re-generated on each tilt up
.tilt-rendered/
