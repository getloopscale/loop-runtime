# ============================================
# LoopZero — .gitignore
# Monorepo: TypeScript (CLI) + Go (API + Operators) + Infra
# ============================================

# --------------------------------------------
# OS & Editor
# --------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
prompts
continue.txt
.yarn
MELHORIAS.txt
ralph-loop.local.md
.claude/ralph-loop.local.md
*.tgz
# --------------------------------------------
# Node.js / TypeScript (cli/)
# --------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo
coverage/
.nyc_output/
*.js.map

# npm / pnpm
*.log
npm-debug.log*
pnpm-debug.log*

# --------------------------------------------
# Go (operators/)
# --------------------------------------------
# Binaries
bin/
!cli/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled Go binaries (should never be committed)
api/main
api/loopzero-api
api/loopzero-controller
api/controller
operators/main
# Per CHG-2026-04-30-INFRA-NORMALIZE D1: 4 split operator binaries
# produced by `go build ./cmd/<op>-operator/`. Built at top level when
# someone forgets to redirect output via -o. Ignored to prevent commit.
operators/app-operator
operators/platform-operator
operators/preview-operator
operators/tenant-operator
cloud/main
/cmd
/scripts

# Test output
*.test
*.out
__debug_bin*

# kubebuilder
operators/testbin/
operators/config/crd/bases/*.bak

# --------------------------------------------
# Kubernetes / Helm / Infra
# --------------------------------------------
# Tilt
.tilt-dev/
tilt_modules/

# Frontend build artifacts (cloud/dashboard)
dist/
.next/
out/

# Helm — sub-chart .tgz are generated by `helm dependency update`
infra/helm/**/charts/
infra/helm/**/*.tgz
charts/**/charts/*.tgz

# kubeconfig generated by k3d
*.kubeconfig
kubeconfig*

# --------------------------------------------
# Secrets & Environment
# --------------------------------------------
.env
.env.*
!.env.example
Taskfile.local.yml
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

# --------------------------------------------
# Testing & Coverage
# --------------------------------------------
junit*.xml
test-results/
.test-reports/
.test-reports-cleanroom/
__snapshots__/

# --------------------------------------------
# Review artifacts (generated by deep review loop)
# --------------------------------------------
review-output/

# --------------------------------------------
# Miscellaneous
# --------------------------------------------
tmp/
.tmp/
*.bak
*.orig
.env.local
.claude/ralph-loop.local.md
.claude/governance-gate.local.md
.claude/loop-state.local.md

# Reference projects for golden-harvest testing (not part of the codebase)
referencias/
builds/
.actrc
.act-secrets
