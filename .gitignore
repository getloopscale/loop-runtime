# ============================================
# LoopZero — .gitignore
# Monorepo: TypeScript (CLI) + Go (API + Operators) + Infra
# ============================================

# --------------------------------------------
# OS & Editor
# --------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
prompts

# --------------------------------------------
# Node.js / TypeScript (cli/)
# --------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo
coverage/
.nyc_output/
*.js.map

# npm / pnpm
*.log
npm-debug.log*
pnpm-debug.log*

# --------------------------------------------
# Go (operators/)
# --------------------------------------------
# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test output
*.test
*.out
__debug_bin*

# kubebuilder
operators/testbin/
operators/config/crd/bases/*.bak

# --------------------------------------------
# Kubernetes / Helm / Infra
# --------------------------------------------
# Tilt
.tilt-dev/
tilt_modules/

# Helm
infra/helm/**/charts/
infra/helm/**/*.tgz

# kubeconfig generated by k3d
*.kubeconfig
kubeconfig*

# --------------------------------------------
# Secrets & Environment
# --------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

# --------------------------------------------
# Testing & Coverage
# --------------------------------------------
junit*.xml
test-results/
__snapshots__/

# --------------------------------------------
# Miscellaneous
# --------------------------------------------
tmp/
.tmp/
*.bak
*.orig
