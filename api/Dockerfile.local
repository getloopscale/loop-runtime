#
# OPERATOR LOCAL-REBUILD Dockerfile — uses local loopzero-contracts via go.mod replace
# (the canonical local-dev path per CLAUDE.md "Local equals production") so the GHCR
# rebuild does NOT depend on the sponsor-managed gomod_token PAT.
#
# Created 2026-06-27 per Red Team #95 P0 — the canonical Dockerfile requires a
# gomod_token that had expired, blocking the engine rebuild needed to ship the
# #92 missing-parent-guard fix LIVE. This file mirrors loopzero-cloud/Dockerfile.local
# (same pattern, same workspace layout, same outcome).
#
# Build context: <meta-dir> (o diretório que contém os dois checkouts), so both `loopzero/` and
# `loopzero-contracts/` are in the BuildKit context. The local replace points
# loopzero-contracts at the workspace sibling repo, bypassing the public-module
# fetch that requires the token.
#
# Usage (operator):
#   cd <meta-dir>
#   docker buildx build --platform linux/amd64 \
#     -f loopzero/api/Dockerfile.local \
#     -t ghcr.io/getloopscale/loopzero-api:develop \
#     -t ghcr.io/getloopscale/loopzero-api:redteam-projects-<sha> \
#     --push .
#
# This file is SIBLING of the canonical Dockerfile (which fetches loopzero-contracts
# from GitHub via gomod_token). The canonical Dockerfile remains the source of
# truth for CI / GHCR canonical builds; this file is the OPERATOR escape hatch
# for local-replace rebuilds when the token is unavailable. Per CLAUDE.md
# "Local equals production": both files produce the SAME image with the SAME
# CGO_ENABLED=0 static binary — the only difference is HOW loopzero-contracts is
# resolved during go mod download.

FROM golang:1.26.1-alpine3.22 AS builder
WORKDIR /workspace

ENV GOWORK=off

# Stage loopzero-contracts INTO the build context so the local replace points at a
# directory that BuildKit actually has.
COPY loopzero-contracts/ ./loopzero-contracts/

# Stage loopzero go.mod + go.sum and inject the local replace at build time.
COPY loopzero/pkg/go.mod ./loopzero/pkg/go.mod
COPY loopzero/operators/api/go.mod loopzero/operators/api/go.sum ./loopzero/operators/api/
COPY loopzero/operators/api/v1 ./loopzero/operators/api/v1
COPY loopzero/api/go.mod loopzero/api/go.sum ./loopzero/api/

# Inject replace directive so go mod download resolves loopzero-contracts from the
# in-context directory (no network fetch, no token).
RUN echo "replace github.com/getloopscale/loopzero-contracts => ../../loopzero-contracts" >> ./loopzero/api/go.mod \
    && echo "replace github.com/getloopscale/loopzero-contracts => ../../loopzero-contracts" >> ./loopzero/pkg/go.mod

# Download deps WITHOUT a gomod_token mount — the replace resolves loopzero-contracts
# locally, and every OTHER dep is public.
RUN --mount=type=cache,target=/root/go/pkg/mod \
    cd loopzero/api && go mod download

COPY loopzero/pkg/ ./loopzero/pkg/
COPY loopzero/api/ ./loopzero/api/

# Re-apply the replace AFTER COPY (the COPY overwrites the modified go.mod).
RUN echo "replace github.com/getloopscale/loopzero-contracts => ../../loopzero-contracts" >> ./loopzero/api/go.mod \
    && echo "replace github.com/getloopscale/loopzero-contracts => ../../loopzero-contracts" >> ./loopzero/pkg/go.mod

RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd loopzero/api && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /loopzero-api ./cmd/ \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /loopzero-controller ./cmd/controller/

# Build migrate from source (same Go toolchain) to avoid CVEs in pre-compiled binary.
FROM golang:1.26.1-alpine3.22 AS migrate-builder
RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go install -tags 'postgres' -trimpath -ldflags="-s -w" \
    github.com/golang-migrate/migrate/v4/cmd/migrate@v4.19.1

FROM alpine:3.22

LABEL org.opencontainers.image.source="https://github.com/getloopscale/loopzero"
LABEL org.opencontainers.image.title="loopzero-api"
LABEL org.opencontainers.image.description="LoopZero PaaS API server (operator local-replace build)"

RUN apk add --no-cache ca-certificates git && adduser -D -u 1000 loopzero
COPY --from=builder /loopzero-api /loopzero-api
COPY --from=builder /loopzero-controller /loopzero-controller
COPY --from=migrate-builder /go/bin/migrate /usr/local/bin/migrate
COPY --from=builder /workspace/loopzero/api/internal/db/migrations/ /migrations/
USER 1000
EXPOSE 8080 9090 9091

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:8080/healthz || exit 1

CMD ["/loopzero-api"]
