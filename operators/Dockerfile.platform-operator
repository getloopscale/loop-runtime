FROM golang:1.26.1-alpine3.22 AS builder
WORKDIR /workspace

ENV GOWORK=off
ENV GOPRIVATE=github.com/getloopscale/*

# loopzero-contracts is a PINNED private module (M5 cutover, via pkg). Fetched with GOPRIVATE +
# a buildx --secret token (never baked in a layer). git is required for the module VCS fetch.
RUN apk add --no-cache git

COPY pkg/go.mod ./pkg/go.mod
COPY operators/go.mod operators/go.sum ./operators/

RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=secret,id=gomod_token \
    sh -c 'if [ -s /run/secrets/gomod_token ]; then \
      git config --global url."https://x-access-token:$(cat /run/secrets/gomod_token)@github.com/getloopscale/".insteadOf "https://github.com/getloopscale/"; \
    fi' \
    && cd operators && go mod download

COPY pkg/ ./pkg/
COPY operators/ ./operators/

RUN --mount=type=cache,target=/root/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd operators && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /loopzero-platform-operator ./cmd/platform-operator/main.go

FROM gcr.io/distroless/static-debian12:nonroot

LABEL org.opencontainers.image.source="https://github.com/getloopscale/loopzero"
LABEL org.opencontainers.image.title="loopzero-platform-operator"
LABEL org.opencontainers.image.description="LoopZero PaaS Platform Infrastructure operator"

COPY --from=builder /loopzero-platform-operator /usr/local/bin/loopzero-platform-operator
EXPOSE 8080 8081

# T8.1 of deep-review-remediation-plan (closes find_infra_001 HIGH).
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/loopzero-platform-operator", "--healthcheck-probe"]

ENTRYPOINT ["loopzero-platform-operator"]
CMD ["--leader-elect=true"]
