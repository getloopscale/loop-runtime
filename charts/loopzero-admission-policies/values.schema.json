{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "loopzero-admission-policies values",
  "description": "Schema for loopzero-admission-policies chart. Defines ValidatingAdmissionPolicies (VAP) + ClusterImagePolicy + alerts for LoopZero platform constraints. Per INF-G17 + ADR-0040 (charts SOTA T1.2 — alignment with infra/helm/admission-policies).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "domain": { "type": "string", "minLength": 1 },
    "registries": {
      "type": "object",
      "properties": {
        "docrPrefix": { "type": "string" },
        "harborPrefix": { "type": "string" },
        "additionalPrefixes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "vaps": {
      "type": "object",
      "description": "VAP toggles — unified schema, matches infra/helm/admission-policies bootstrap",
      "properties": {
        "disallowLatestTag": { "type": "boolean" },
        "restrictRegistries": { "type": "boolean" },
        "requireResourceLimits": { "type": "boolean" },
        "protectPlatformNetworkpolicies": { "type": "boolean" },
        "argocdManagedBy": { "type": "boolean" },
        "requireImageSignature": { "type": "boolean" },
        "tenantNamespace": { "type": "boolean" },
        "noRuntimeImageMutations": { "type": "boolean" },
        "noRuntimeImageMutationsAction": {
          "type": "string",
          "enum": ["Deny", "Warn", "Audit"]
        },
        "noRuntimeImageMutationsFailurePolicy": {
          "type": "string",
          "enum": ["Fail", "Ignore"]
        }
      }
    },
    "namespaceSelector": {
      "type": "object",
      "properties": {
        "matchExpressions": { "type": "array" },
        "matchLabels": { "type": "object" }
      }
    },
    "validationActions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["Deny", "Warn", "Audit"]
      }
    },
    "clusterImagePolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["enforce", "warn"] },
        "staticAction": { "type": "string", "enum": ["pass", "fail"] },
        "imageGlobs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "clusterImagePolicyKeyless": {
      "type": "object",
      "description": "INF-G16 + MEET-2026-05-03-063 — keyless cosign via Fulcio + Rekor",
      "properties": {
        "enabled": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "mode": { "type": "string", "enum": ["enforce", "warn"] },
        "imageGlobs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fulcioURL": { "type": "string", "format": "uri" },
        "rekorURL": { "type": "string", "format": "uri" },
        "oidcIssuer": { "type": "string", "format": "uri" },
        "identityRegexp": { "type": "string", "minLength": 1 }
      }
    },
    "alerts": {
      "type": "object",
      "description": "PrometheusRule toggle for policy-controller + tenant-namespace alerts",
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": { "type": "string", "minLength": 1 },
        "prometheusReleaseLabel": { "type": "string", "minLength": 1 }
      }
    }
  }
}
