{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loopzero-admission-policies values",
  "description": "Schema for loopzero-admission-policies chart. Defines ValidatingAdmissionPolicies (VAP) + ClusterImagePolicy + alerts for LoopZero platform constraints. Per INF-G17 + ADR-0040 (charts SOTA T1.2 \u2014 alignment with infra/helm/admission-policies).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registries": {
      "type": "object",
      "properties": {
        "docrPrefix": {
          "type": "string",
          "minLength": 5,
          "pattern": "^[^\\s]+/$",
          "description": "DOCR prefix MUST end with '/' and contain no whitespace (B16 + anchored pattern bug class, symmetric with infra/helm/admission-policies fix 2026-05-20)."
        },
        "harborPrefix": {
          "type": "string",
          "minLength": 5,
          "pattern": "^[^\\s]+/$",
          "description": "Harbor prefix. Same constraint as docrPrefix."
        },
        "additionalPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\s]+/$"
          }
        }
      }
    },
    "vaps": {
      "type": "object",
      "description": "VAP toggles \u2014 unified schema, matches infra/helm/admission-policies bootstrap",
      "properties": {
        "disallowLatestTag": {
          "type": "boolean"
        },
        "restrictRegistries": {
          "type": "boolean"
        },
        "requireResourceLimits": {
          "type": "boolean"
        },
        "protectPlatformNetworkpolicies": {
          "type": "boolean"
        },
        "argocdManagedBy": {
          "type": "boolean"
        },
        "requireImageSignature": {
          "type": "boolean"
        },
        "tenantNamespace": {
          "type": "boolean"
        },
        "noRuntimeImageMutations": {
          "type": "boolean"
        },
        "noRuntimeImageMutationsAction": {
          "type": "string",
          "enum": [
            "Deny",
            "Warn",
            "Audit"
          ]
        },
        "noRuntimeImageMutationsFailurePolicy": {
          "type": "string",
          "enum": [
            "Fail",
            "Ignore"
          ]
        }
      }
    },
    "clusterImagePolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "enforce",
            "warn"
          ]
        },
        "staticAction": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "imageGlobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "clusterImagePolicyKeyless": {
      "type": "object",
      "description": "INF-G16 + MEET-2026-05-03-063 \u2014 keyless cosign via Fulcio + Rekor",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "enforce",
            "warn"
          ]
        },
        "imageGlobs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fulcioURL": {
          "type": "string",
          "pattern": "^https?://[^\\s/$.?#].[^\\s]*$",
          "description": "Fulcio URL. Pattern enforced (format:uri silently permissive \u2014 see infra/helm/admission-policies/values.schema.json 2026-05-20 finding)."
        },
        "rekorURL": {
          "type": "string",
          "pattern": "^https?://[^\\s/$.?#].[^\\s]*$",
          "description": "Rekor URL. Pattern-based per format:uri bug class."
        },
        "oidcIssuer": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s/$.?#].[^\\s]*$",
          "description": "OIDC issuer URL \u2014 MUST be BUILD cluster's external OIDC URL. T1.4 v1.1 EC-NEW-4. Empty default + chart fail-fast."
        },
        "identityRegexp": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "alerts": {
      "type": "object",
      "description": "PrometheusRule toggle for policy-controller + tenant-namespace alerts",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "prometheusReleaseLabel": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tufRootCeremonyDate": {
      "type": "string"
    },
    "systemActorExemptions": {
      "type": "object",
      "description": "Identities no admission policy may block (templates/_helpers.tpl loopzero-admission.systemActorExemptions). ServiceAccount names in loopzero-system. At least two, or the negated `in` list denies the platform's own controllers (EC-2).",
      "required": [
        "platformServiceAccounts"
      ],
      "additionalProperties": false,
      "properties": {
        "platformServiceAccounts": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          }
        }
      }
    }
  }
}
