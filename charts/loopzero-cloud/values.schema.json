{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loopzero-cloud values",
  "description": "Schema for loopzero-api Helm chart. Per INF-G17 + plan ADR D4, schema is mandatory for all published charts in charts/.",
  "type": "object",
  "required": [
    "image",
    "replicaCount"
  ],
  "additionalProperties": false,
  "properties": {
    "existingSecret": {
      "type": "string",
      "description": "Name of a pre-existing K8s Secret supplying the cloud-API secret env (Stripe, session, service-auth, themory). When set, the chart references it via envFrom and skips the inline admin Secret. The operator populates it however they choose (ESO, CSI, sops, kubectl) — see SECRETS.md (install-config-contract Slice 1, ADR D1 existingSecret floor)."
    },
    "wiringConfigMap": {
      "type": "string",
      "description": "Name of a pre-existing cross-capability wiring ConfigMap mounted via envFrom (loopzero-cloud#249). Supplies data-plane base URLs the cloud-API resolves per-environment, e.g. THEMORY_BASE_URL. Empty by default; when set (and present in-cluster) it enables the SDK + dashboard memory surfaces. Optional in the mount, so a missing ConfigMap is not fatal."
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": [
        "object",
        "array"
      ]
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "loopzero-common": {
      "type": "object",
      "description": "Values block consumed by the loopzero-common library subchart (labels, security contexts)."
    },
    "global": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)*$",
          "description": "Container image repository (lowercase, no protocol prefix; optional :port on the registry host, e.g. k3d-loopzero-registry:5000/loopzero-cloud)"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Optional sha256 digest for INF-G19 reproducibility"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "priorityClassName": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "podLabels": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "config": {
      "type": "object",
      "description": "Non-secret settings rendered into the ConfigMap. Only these keys reach the pod; any other key is refused rather than ignored.",
      "additionalProperties": false,
      "properties": {
        "listenAddr": {
          "type": "string"
        },
        "kratosPublicUrl": {
          "type": "string"
        },
        "kratosAdminUrl": {
          "type": "string"
        },
        "hydraPublicUrl": {
          "type": "string"
        },
        "hydraAdminUrl": {
          "type": "string"
        },
        "hydraClientId": {
          "type": "string"
        },
        "engineApiUrl": {
          "type": "string"
        },
        "loopzeroEnv": {
          "type": "string"
        },
        "githubAppSlug": {
          "type": "string"
        },
        "appPublicUrl": {
          "type": "string"
        },
        "authCookieDomain": {
          "type": "string"
        }
      }
    },
    "reloader": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "description": "Opt-in Stakater Reloader (install-config-contract Slice 2): rolling restart on referenced-Secret change. Operator installs the controller."
    },
    "billing": {
      "type": "object",
      "description": "Declara que este ambiente cobra de verdade. Quando required=true os Secrets de cobranca deixam de ser opcionais e o pod nao sobe sem eles — medido em 2026-08-11, o painel rodou 20h sem o segredo que verifica pagamentos, Running, sem um evento.",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean",
          "description": "Falso por padrao: preserva o boot sem Stripe no ambiente hermetico."
        }
      }
    }
  }
}
