{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loopzero-cloud values",
  "description": "Schema for loopzero-api Helm chart. Per INF-G17 + plan ADR D4, schema is mandatory for all published charts in charts/.",
  "type": "object",
  "required": [
    "image",
    "replicaCount"
  ],
  "additionalProperties": false,
  "properties": {
    "existingSecret": {
      "type": "string",
      "description": "Name of a pre-existing K8s Secret supplying the cloud-API secret env (Stripe, session, service-auth, themory). When set, the chart references it via envFrom and skips the inline admin Secret. The operator populates it however they choose (ESO, CSI, sops, kubectl) — see SECRETS.md (install-config-contract Slice 1, ADR D1 existingSecret floor)."
    },
    "wiringConfigMap": {
      "type": "string",
      "description": "Name of a pre-existing cross-capability wiring ConfigMap mounted via envFrom (loopzero-cloud#249). Supplies data-plane base URLs the cloud-API resolves per-environment, e.g. THEMORY_BASE_URL. Empty by default; when set (and present in-cluster) it enables the SDK + dashboard memory surfaces. Optional in the mount, so a missing ConfigMap is not fatal."
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "networkPolicy": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": [
        "object",
        "array"
      ]
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "loopzero-common": {
      "type": "object",
      "description": "Values block consumed by the loopzero-common library subchart (labels, security contexts)."
    },
    "global": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)*$",
          "description": "Container image repository (lowercase, no protocol prefix; optional :port on the registry host, e.g. k3d-loopzero-registry:5000/loopzero-cloud)"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Optional sha256 digest for INF-G19 reproducibility"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "priorityClassName": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "podLabels": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767,
          "description": "Fixed node port of the http port when service.type is NodePort; null lets the cluster pick one."
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "config": {
      "type": "object",
      "description": "Non-secret settings rendered into the ConfigMap. Only these keys reach the pod; any other key is refused rather than ignored.",
      "additionalProperties": false,
      "properties": {
        "listenAddr": {
          "type": "string"
        },
        "kratosPublicUrl": {
          "type": "string"
        },
        "kratosAdminUrl": {
          "type": "string"
        },
        "hydraPublicUrl": {
          "type": "string"
        },
        "hydraAdminUrl": {
          "type": "string"
        },
        "hydraClientId": {
          "type": "string"
        },
        "engineApiUrl": {
          "type": "string"
        },
        "loopzeroEnv": {
          "type": "string"
        },
        "githubAppSlug": {
          "type": "string"
        },
        "appPublicUrl": {
          "type": "string"
        },
        "authCookieDomain": {
          "type": "string"
        },
        "kratosInternalUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$",
          "description": "Cluster-internal Kratos URL for server-side calls (KRATOS_INTERNAL_URL). Rendered only when set."
        },
        "jwtIssuer": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$",
          "description": "Exact JWT issuer, compared byte for byte (JWT_ISSUER). Rendered only when set."
        },
        "billingReturnUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$",
          "description": "Where Stripe checkout returns the browser (BILLING_RETURN_URL). Rendered only when set."
        },
        "ragBaseUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$",
          "description": "loopzero-rag base URL; unset leaves the RAG dashboard surface off (RAG_BASE_URL)."
        },
        "lensBaseUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$",
          "description": "loopzero-lens base URL; unset leaves the lens dashboard surface off (LENS_BASE_URL)."
        },
        "traefikMcpBaseUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$",
          "description": "loopzero-traefik-mcp base URL for the status panel (TRAEFIK_MCP_BASE_URL)."
        },
        "prometheusUrl": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$",
          "description": "Prometheus the cost aggregator reads; unset, the aggregator does not start (LOOPZERO_PROMETHEUS_URL)."
        }
      }
    },
    "reloader": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "description": "Opt-in Stakater Reloader (install-config-contract Slice 2): rolling restart on referenced-Secret change. Operator installs the controller."
    },
    "billing": {
      "type": "object",
      "description": "Declares that this environment really charges. With required=true the billing Secrets stop being optional and the pod does not start without them — measured 2026-08-11, the dashboard ran 20h without the secret that verifies payments, Running, with not one event.",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean",
          "description": "False by default: keeps the boot path without Stripe in the hermetic install."
        },
        "apiKeysSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
          "description": "Secret with the Stripe API keys, mounted with the optionality of loopzero-stripe-webhook. Empty: not mounted."
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Secrets this chart does not create. Every optional entry carries its reason.",
      "properties": {
        "additionalSources": {
          "type": "array",
          "description": "Secrets this chart does not create, mounted whole through envFrom after the chart's own sources.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "optional"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "optional": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 30,
                "description": "Why the pod may start without this Secret, and what happens when it is absent. Required when optional is true: optional is the mechanism by which a dependency vanishes without the startup saying anything (B-104)."
              }
            },
            "if": {
              "properties": {
                "optional": {
                  "const": true
                }
              },
              "required": [
                "optional"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        },
        "keyRefs": {
          "type": "array",
          "description": "One key of a Secret this chart does not create, mapped onto the variable the binary reads. An explicit variable outranks every envFrom source.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "secretName",
              "key",
              "optional"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "secretName": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[-._a-zA-Z0-9]+$"
              },
              "optional": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 30,
                "description": "Why the pod may start without this Secret, and what happens when it is absent. Required when optional is true: optional is the mechanism by which a dependency vanishes without the startup saying anything (B-104)."
              }
            },
            "if": {
              "properties": {
                "optional": {
                  "const": true
                }
              },
              "required": [
                "optional"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        }
      }
    },
    "tmpVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi)$"
        }
      }
    },
    "ingressRoute": {
      "type": "object",
      "additionalProperties": false,
      "description": "Traefik IngressRoute to the Service (loopzero-common.ingressRoute). Off by default: a published chart does not assume an ingress controller.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "middlewares": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "namespace"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              }
            }
          }
        },
        "certIssuer": {
          "type": "string",
          "minLength": 1,
          "description": "ClusterIssuer of the Certificate emitted for the host, or CFManaged when TLS terminates at the Cloudflare edge (no Certificate)."
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "host": {
            "minLength": 1
          }
        },
        "required": [
          "host"
        ]
      }
    },
    "rag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalSecretEnabled": {
          "type": "boolean"
        },
        "secretStoreName": {
          "type": "string",
          "minLength": 1
        },
        "openBaoPath": {
          "type": "string",
          "minLength": 1
        },
        "openBaoProperty": {
          "type": "string",
          "minLength": 1
        },
        "externalSecretRefreshInterval": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        }
      },
      "description": "loopzero-rag platform-admin key ExternalSecret (loopzero-rag-admin-key)."
    },
    "lens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "externalSecretEnabled": {
          "type": "boolean"
        },
        "secretStoreName": {
          "type": "string",
          "minLength": 1
        },
        "openBaoPath": {
          "type": "string",
          "minLength": 1
        },
        "openBaoProperty": {
          "type": "string",
          "minLength": 1
        },
        "externalSecretRefreshInterval": {
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        }
      },
      "description": "loopzero-lens platform-admin key ExternalSecret (loopzero-lens-admin-key)."
    }
  }
}
