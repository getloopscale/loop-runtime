{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loopzero-platform umbrella values",
  "description": "Schema for loopzero-platform umbrella chart. Validates global.registry + sub-chart enable toggles. charts-sota T4.1 + ADR-0037. loopzero-controller ghost removed per ADR-0042.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9.-]*(/[a-z0-9._-]+)*$",
          "description": "Container image registry (FQDN, no protocol). Default: registry.digitalocean.com/loopzero-system. First char MUST be [a-z0-9] (catches leading-dot/leading-dash garbage per 2026-05-20 shadow bug audit). Subsequent chars allow [a-z0-9.-] for FQDN segments + optional /path."
        },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "object" }
        },
        "environment": {
          "type": "string",
          "enum": ["dev", "staging", "prod"]
        }
      }
    },
    "loopzero-crds": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-api": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-tenant-operator": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-app-operator": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-preview-operator": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-platform-operator": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-cloud": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-dashboard": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-build-cwts": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-monitoring": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    },
    "loopzero-admission-policies": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } }
    }
  }
}
