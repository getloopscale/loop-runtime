{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loop-runtime-monitoring values",
  "description": "Schema for loop-runtime-monitoring (PrometheusRules, dashboards, alert configs). Per INF-G17.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prometheusRules": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object"
        },
        "additionalLabels": {
          "type": "object"
        },
        "groups": {
          "type": "array"
        }
      }
    },
    "dashboards": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configMapLabels": {
          "type": "object"
        }
      }
    }
  }
}
