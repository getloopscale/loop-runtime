{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loopzero-monitoring values",
  "description": "Schema for loopzero-monitoring (PrometheusRules, dashboards, alert configs). Per INF-G17.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "prometheusRules": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object"
        },
        "additionalLabels": {
          "type": "object"
        },
        "groups": {
          "type": "array"
        }
      }
    },
    "dashboards": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configMapLabels": {
          "type": "object"
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        }
      }
    },
    "alerts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        }
      }
    },
    "slo": {
      "type": "object",
      "description": "SLO definitions (Sloth-generated)",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "annotations": {
      "type": "object"
    },
    "labels": {
      "type": "object"
    }
  }
}
