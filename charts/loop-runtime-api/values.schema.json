{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loop-runtime-api values",
  "description": "Schema for loop-runtime-api Helm chart. Per INF-G17 + plan ADR D4, schema is mandatory for all published charts in charts/.",
  "type": "object",
  "required": [
    "image",
    "replicaCount"
  ],
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)*$",
          "description": "Container image repository (lowercase, no protocol prefix)"
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Optional sha256 digest for INF-G19 reproducibility"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "priorityClassName": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "podLabels": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer",
            "ExternalName"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767,
          "description": "Fixed node port of the http port when service.type is NodePort; null lets the cluster pick one."
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "legacyClusterWideSecrets": {
          "type": "boolean"
        },
        "argocdApplications": {
          "type": "boolean",
          "description": "Grant get/list/watch/patch/delete on argoproj.io applications (release attribution, tenant eviction). Off by default."
        },
        "controlPlaneSecrets": {
          "type": "boolean",
          "description": "Role in the release namespace granting secrets get/create/update/delete (secret-sync broker, ArgoCD token provider). Off by default."
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "port": {
          "type": "string"
        },
        "metricsPort": {
          "type": "string"
        },
        "loopRuntimeEnv": {
          "type": "string"
        },
        "logLevel": {
          "type": "string"
        },
        "baseDomain": {
          "type": "string"
        },
        "serverReadHeaderTimeout": {
          "type": "string"
        },
        "serverReadTimeout": {
          "type": "string"
        },
        "serverIdleTimeout": {
          "type": "string"
        },
        "serverGracefulShutdown": {
          "type": "string"
        },
        "dbMaxConns": {
          "type": "string"
        },
        "dbMinConns": {
          "type": "string"
        },
        "dbMaxConnIdleTime": {
          "type": "string"
        },
        "dbMaxConnLifetime": {
          "type": "string"
        },
        "dbHealthCheckPeriod": {
          "type": "string"
        },
        "dbConnectTimeout": {
          "type": "string"
        },
        "dbStatementTimeout": {
          "type": "string"
        },
        "httpClientTimeout": {
          "type": "string"
        },
        "argocdUrl": {
          "type": "string"
        },
        "argocdClientTimeout": {
          "type": "string"
        },
        "argocdInsecure": {
          "type": "string"
        },
        "argocdPollInterval": {
          "type": "string"
        },
        "argocdSyncTimeout": {
          "type": "string"
        },
        "argoNamespace": {
          "type": "string"
        },
        "argocdNamespace": {
          "type": "string"
        },
        "apiCrossClusterUrl": {
          "type": "string"
        },
        "giteaUrl": {
          "type": "string"
        },
        "giteaCrossClusterUrl": {
          "type": "string"
        },
        "giteaOrg": {
          "type": "string"
        },
        "mgmtKubeContext": {
          "type": "string"
        },
        "buildKubeContext": {
          "type": "string"
        },
        "runtimeKubeContext": {
          "type": "string"
        },
        "minioEndpoint": {
          "type": "string"
        },
        "minioCrossClusterEndpoint": {
          "type": "string"
        },
        "sourceBucket": {
          "type": "string"
        },
        "staticAssetsBucket": {
          "type": "string"
        },
        "registryUrl": {
          "type": "string"
        },
        "registryInsecure": {
          "type": "string"
        },
        "workloadIngressUrl": {
          "type": "string"
        },
        "loopRuntimePreviewPublicDomain": {
          "type": "string"
        },
        "loopRuntimePublicDomain": {
          "type": "string"
        },
        "loopRuntimeClusterIssuer": {
          "type": "string"
        },
        "loopRuntimePrometheusAddress": {
          "type": "string"
        },
        "lokiUrl": {
          "type": "string"
        },
        "loopRuntimeGrafanaBaseUrl": {
          "type": "string"
        },
        "githubAppId": {
          "type": "string"
        },
        "githubApiBaseUrl": {
          "type": "string"
        },
        "billingReturnUrl": {
          "type": "string"
        },
        "billingUpgradeUrl": {
          "type": "string"
        },
        "cfAccountId": {
          "type": "string"
        },
        "cfKvNamespaceId": {
          "type": "string"
        },
        "edgeKvsArn": {
          "type": "string"
        },
        "cfZoneManagement": {
          "type": "string"
        },
        "loopRuntimeCosignKeyless": {
          "type": "string"
        },
        "loopRuntimeCosignAttestEnabled": {
          "type": "string"
        },
        "loopRuntimeCosignInsecureSkipSctVerify": {
          "type": "string"
        },
        "loopRuntimeCosignTufRootPinned": {
          "type": "string"
        },
        "loopRuntimeFulcioUrl": {
          "type": "string"
        },
        "loopRuntimeRekorUrl": {
          "type": "string"
        },
        "loopRuntimeCosignImage": {
          "type": "string"
        },
        "buildWorkspaceStorageClass": {
          "type": "string",
          "description": "StorageClass of the build workspace PVC; empty selects the build cluster's default class."
        },
        "loopRuntimeSyftImage": {
          "type": "string"
        },
        "openbaoTransitEnabled": {
          "type": "string"
        },
        "openbaoVaultAddr": {
          "type": "string"
        },
        "openbaoSpkiPinSha256": {
          "type": "string"
        },
        "loopRuntimeServiceAuthEd25519PublicCurrent": {
          "type": "string"
        },
        "loopRuntimeServiceAuthEd25519PublicPrevious": {
          "type": "string"
        },
        "loopRuntimeServiceAuthNonceRedisAddr": {
          "type": "string"
        },
        "loopRuntimeServiceAuthRequireSignature": {
          "type": "string"
        },
        "loopRuntimeServiceAuthSecretCreatedAt": {
          "type": "string"
        },
        "cbKey": {
          "type": "string"
        },
        "cbOpenThreshold": {
          "type": "string"
        },
        "cbCloseThreshold": {
          "type": "string"
        },
        "cbRetryInterval": {
          "type": "string"
        },
        "buildQueueTimeout": {
          "type": "string"
        },
        "buildRunningTimeout": {
          "type": "string"
        },
        "buildReleasingTimeout": {
          "type": "string"
        },
        "buildCancelTimeout": {
          "type": "string"
        },
        "buildReaperInterval": {
          "type": "string"
        },
        "releaseReadyTimeout": {
          "type": "string"
        },
        "releasePendingTimeout": {
          "type": "string"
        },
        "releaseReaperInterval": {
          "type": "string"
        },
        "buildReconcileInterval": {
          "type": "string"
        },
        "sseHeartbeatInterval": {
          "type": "string"
        },
        "ssePollInterval": {
          "type": "string"
        },
        "sseSafetyTimeout": {
          "type": "string"
        },
        "sseMaxConcurrentStreams": {
          "type": "string"
        },
        "authCacheTtl": {
          "type": "string"
        },
        "sourceMaxBundleSize": {
          "type": "string"
        },
        "sourceMultipartMaxMemory": {
          "type": "string"
        },
        "loopRuntimeDisableLegacyLoops": {
          "type": "string"
        },
        "loopRuntimeAdmissionControl": {
          "type": "string"
        },
        "maxConcurrentBuildsPerCell": {
          "type": "string"
        },
        "maxTenantsPerCell": {
          "type": "string"
        },
        "maxConcurrentBuildsPerTenant": {
          "type": "string"
        },
        "pgCircuitBreakerThresholdPct": {
          "type": "string"
        },
        "loopRuntimeUsePgClaims": {
          "type": "string"
        },
        "loopRuntimeKedaEnabled": {
          "type": "string"
        },
        "corsAllowedOrigin": {
          "type": "string"
        },
        "jwksUrl": {
          "type": "string"
        },
        "jwtIssuer": {
          "type": "string"
        },
        "loopRuntimeAdminApi": {
          "type": "string"
        },
        "loopRuntimeMaintenanceMode": {
          "type": "string"
        },
        "loopRuntimeProgressiveDelivery": {
          "type": "string"
        },
        "loopRuntimeLeanResources": {
          "type": "string"
        },
        "loopRuntimeEnvBlocklistMode": {
          "type": "string"
        },
        "loopRuntimeEnvReadinessChecker": {
          "type": "string"
        },
        "loopRuntimeTrustedProxyCidrs": {
          "type": "string"
        },
        "otelExporterOtlpEndpoint": {
          "type": "string"
        },
        "loopRuntimeTracingEnabled": {
          "type": "string"
        },
        "loopRuntimePprofAddr": {
          "type": "string"
        },
        "loopRuntimePprofEnabled": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "kubeconfig": {
      "type": "object",
      "properties": {
        "build": {
          "type": "object",
          "properties": {
            "existingConfigMap": {
              "type": "string"
            }
          }
        },
        "cell0": {
          "type": "object",
          "properties": {
            "existingConfigMap": {
              "type": "string"
            }
          }
        },
        "clusterSecret": {
          "type": "object",
          "additionalProperties": false,
          "description": "One Secret with core.kubeconfig, build.kubeconfig and cell-0.kubeconfig, mounted at /etc/loop-runtime/kubeconfigs. Exclusive with the per-cluster ConfigMaps.",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "optional": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "optional": {
                "const": true
              }
            },
            "required": [
              "optional"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 30,
                "description": "Why the pod may start without this Secret, and what happens when it is absent. Required when optional is true: optional is the mechanism by which a dependency vanishes without the startup saying anything (B-104)."
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      }
    },
    "livenessProbe": {
      "type": "object"
    },
    "readinessProbe": {
      "type": "object"
    },
    "startupProbe": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "dataPlanePoller": {
      "type": "object",
      "description": "Readiness poller (Red Team loop-console#128): the elected api leader records per-environment ready replicas from Prometheus into environment_targets for the dashboard badge. Off by default.",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "prometheusUrl": {
          "type": "string"
        },
        "interval": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$"
        }
      }
    },
    "networkPolicy": {
      "type": "object"
    },
    "secrets": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string"
        },
        "databaseUrl": {
          "type": "string"
        },
        "loopRuntimeWorkerDatabaseUrl": {
          "type": "string"
        },
        "loopRuntimeApiDatabaseUrl": {
          "type": "string"
        },
        "giteaToken": {
          "type": "string"
        },
        "argocdToken": {
          "type": "string"
        },
        "minioAccessKey": {
          "type": "string"
        },
        "minioSecretKey": {
          "type": "string"
        },
        "loopRuntimeArgoCallbackSecret": {
          "type": "string"
        },
        "loopRuntimeBootstrapSecret": {
          "type": "string"
        },
        "loopRuntimeSecretEncryptionKey": {
          "type": "string"
        },
        "openbaoVaultRoleId": {
          "type": "string"
        },
        "openbaoVaultSecretId": {
          "type": "string"
        },
        "cfApiToken": {
          "type": "string"
        },
        "coreKubeconfig": {
          "type": "string"
        },
        "buildKubeconfig": {
          "type": "string"
        },
        "cell0Kubeconfig": {
          "type": "string"
        },
        "stripeSecretKey": {
          "type": "string"
        },
        "githubAppPrivateKey": {
          "type": "string"
        },
        "githubWebhookSecret": {
          "type": "string"
        },
        "loopRuntimeAdminApiKey": {
          "type": "string"
        },
        "loopRuntimeAdminApiKeyPrevious": {
          "type": "string"
        },
        "loopRuntimeAdminServiceAuthSecret": {
          "type": "string"
        },
        "loopRuntimeAdminServiceAuthSecretPrevious": {
          "type": "string"
        },
        "loopRuntimeBrokerToken": {
          "type": "string"
        },
        "loopRuntimeBrokerTokens": {
          "type": "string",
          "description": "cell=token pairs, comma-separated; loop-runtime-api refuses a malformed list at boot"
        },
        "loopRuntimeEdgeRouteToken": {
          "type": "string"
        },
        "loopRuntimeServiceAuthSecret": {
          "type": "string"
        },
        "loopRuntimeServiceAuthSecretPrevious": {
          "type": "string"
        },
        "loopRuntimeServiceAuthNonceRedisPassword": {
          "type": "string"
        },
        "additionalSources": {
          "type": "array",
          "description": "Secrets this chart does not create, mounted whole through envFrom after the chart's own sources.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "optional"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "optional": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 30,
                "description": "Why the pod may start without this Secret, and what happens when it is absent. Required when optional is true: optional is the mechanism by which a dependency vanishes without the startup saying anything (B-104)."
              }
            },
            "if": {
              "properties": {
                "optional": {
                  "const": true
                }
              },
              "required": [
                "optional"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        },
        "keyRefs": {
          "type": "array",
          "description": "One key of a Secret this chart does not create, mapped onto the variable the binary reads. An explicit variable outranks every envFrom source.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "secretName",
              "key",
              "optional"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "secretName": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[-._a-zA-Z0-9]+$"
              },
              "optional": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 30,
                "description": "Why the pod may start without this Secret, and what happens when it is absent. Required when optional is true: optional is the mechanism by which a dependency vanishes without the startup saying anything (B-104)."
              }
            },
            "if": {
              "properties": {
                "optional": {
                  "const": true
                }
              },
              "required": [
                "optional"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "vault": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "topologySpreadConstraints": {
      "type": [
        "object",
        "array"
      ]
    },
    "loop-runtime-common": {
      "type": "object",
      "description": "Values block consumed by the loop-runtime-common library subchart."
    },
    "secretFetchLoadBalancer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Internal ALB (AWS Load Balancer Controller Ingress) forwarding only /internal/v1/secret-fetch to the API, for the cells' External Secrets. Off by default. HTTPS with certificateArn unless plaintextListener.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "certificateArn": {
          "type": "string",
          "pattern": "^$|^arn:aws[a-z-]*:acm:[a-z0-9-]+:[0-9]{12}:certificate/[A-Za-z0-9-]+$"
        },
        "plaintextListener": {
          "type": "boolean"
        }
      }
    },
    "reloader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "description": "Seconds Kubernetes waits for in-flight work before killing the pod. Sized for SSE streams reporting on a tenant canary (renderer progressDeadlineSeconds is 300), not for the 30s default."
    },
    "tmpVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi)$"
        }
      }
    },
    "ingressRoute": {
      "type": "object",
      "additionalProperties": false,
      "description": "Traefik IngressRoute to the Service (loop-runtime-common.ingressRoute). Off by default: a published chart does not assume an ingress controller.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "entryPoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "middlewares": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "namespace"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              }
            }
          }
        },
        "streamMiddlewares": {
          "description": "Middlewares of the route for GET .../stream endpoints (Server-Sent Events). Set it without any buffering middleware such as body-limit, which holds the response until it ends. Unset, no such route is rendered.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "namespace"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
                "maxLength": 253
              }
            }
          }
        },
        "certIssuer": {
          "type": "string",
          "minLength": 1,
          "description": "ClusterIssuer of the Certificate emitted for the host, or CFManaged when TLS terminates at the Cloudflare edge (no Certificate)."
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "properties": {
          "host": {
            "minLength": 1
          }
        },
        "required": [
          "host"
        ]
      }
    }
  }
}
