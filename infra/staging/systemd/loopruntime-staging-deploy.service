# Deploys the head of develop to staging (infra/staging/deploy.sh). Started by
# loopruntime-staging-deploy.timer; a run that finds nothing new exits at once.
[Unit]
Description=Deploy the head of develop to staging
After=network-online.target aws-emulator.service aws-emulator-eks.service
Wants=network-online.target

[Service]
Type=oneshot
# root, as `task staging:platform` is: it reads the emulator's credentials and CA under
# /var/lib/aws-emulator and the clusters' kubeconfig under /var/lib/loopruntime-staging.
Environment=HOME=/root
Environment=PATH=/usr/local/bin:/usr/local/go/bin:/usr/bin:/bin
# Anything else that syncs the clusters takes the same lock, so two syncs never overlap; a
# deploy that finds it taken is skipped and the timer tries again.
# A held lock means a rebuild is running and there is nothing to deploy now: flock exits 75
# (EX_TEMPFAIL) for it, which counts as success, so a real failure stays the only 1.
SuccessExitStatus=75
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code 75 /run/loopruntime-staging-platform.lock /usr/local/lib/loopruntime-staging/deploy.sh
# A full platform sync takes about ten minutes on this host, and the validation that
# follows it (infra/staging/validate.sh) builds and runs the dogfood suite, whose go test
# timeout is 30 minutes.
TimeoutStartSec=60min
