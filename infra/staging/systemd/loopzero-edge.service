# Caddy as staging's public edge, in place of CloudFront and ACM (infra/staging/edge/Caddyfile).
# `task staging:edge` writes /etc/loopzero-edge/edge.env and restarts this unit; the ALB's
# name and the emulator's CA change with every rebuild of the environment.
[Unit]
Description=Public edge of staging (Caddy in place of CloudFront and ACM)
After=network-online.target aws-emulator.service
Wants=network-online.target

[Service]
Type=notify
DynamicUser=yes
# The certificates and the ACME account, kept across rebuilds so that a rebuild does not
# ask Let's Encrypt for new certificates (it rate limits a name to 5 per week).
StateDirectory=loopzero-edge
Environment=HOME=/var/lib/loopzero-edge
Environment=XDG_DATA_HOME=/var/lib/loopzero-edge
Environment=XDG_CONFIG_HOME=/var/lib/loopzero-edge
EnvironmentFile=/etc/loopzero-edge/edge.env
# The tenant apps' wildcard certificate, which lego keeps readable by root only
# (infra/staging/edge/apps-certificate.sh). A credential is read when the unit starts, so a
# renewal restarts the unit.
LoadCredential=apps.crt:/var/lib/loopzero-edge-certificate/certificates/_.apps.staging.getloopscale.com.crt
LoadCredential=apps.key:/var/lib/loopzero-edge-certificate/certificates/_.apps.staging.getloopscale.com.key
# The bearer of the API's route lookup, which Caddy asks before it issues a certificate for
# a custom domain. `task staging:edge` reads it from the cluster.
LoadCredential=route-token:/etc/loopzero-edge/route-token
ExecStart=/usr/local/bin/caddy run --config /etc/loopzero-edge/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/loopzero-edge/Caddyfile --adapter caddyfile --force
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=1048576
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
