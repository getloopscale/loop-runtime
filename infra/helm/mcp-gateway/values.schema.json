{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mcp-gateway values",
  "type": "object",
  "additionalProperties": false,
  "required": ["gateway", "jwks", "servers"],
  "properties": {
    "issuer": { "type": "string" },
    "publicOrigin": { "type": "string" },
    "jwks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "namespace", "port", "path"],
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "nodePort"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "nodePort": { "type": "integer", "minimum": 30000, "maximum": 32767 }
      }
    },
    "servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "host", "port", "upstreamPath"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
          "path": { "type": "string", "pattern": "^/mcp/[a-z][a-z0-9-]*$" },
          "host": { "type": "string", "minLength": 1 },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "upstreamPath": { "type": "string", "pattern": "^/" }
        }
      }
    }
  },
  "if": { "properties": { "servers": { "minItems": 1 } } },
  "then": {
    "required": ["issuer", "publicOrigin"],
    "properties": {
      "issuer": { "minLength": 1, "pattern": "^https?://" },
      "publicOrigin": { "pattern": "^https?://[^/]+$" }
    }
  }
}
