      "type": "stat",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(loopzero_deploy_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
