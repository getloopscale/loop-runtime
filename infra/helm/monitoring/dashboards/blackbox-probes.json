      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "title": "API Health",
      "type": "stat",
      "targets": [
        {
          "expr": "probe_success{job=~\".*loopzero-api-probe.*\",instance=~\".*health.*\"}",
          "legendFormat": "API",
          "refId": "A"
