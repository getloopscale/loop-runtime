  "panels": [
    {
      "title": "Webhook Push Events",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "description": "Requires GitHub App webhook to be active. Shows push events received and processed.",
      "targets": [
        {
          "expr": "sum(rate(loop_runtime_webhook_push_total[5m])) by (result) or vector(0)",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No webhook activity"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "Deploy Duration (end-to-end)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(loop_runtime_build_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(loop_runtime_build_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "Builds by Status (5m rate)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(loop_runtime_builds_total{status=\"succeeded\"}[5m])) or vector(0)",
          "legendFormat": "Succeeded"
        },
        {
          "expr": "sum(rate(loop_runtime_builds_total{status=\"failed\"}[5m])) or vector(0)",
          "legendFormat": "Failed"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "Revision Mismatches & Re-syncs",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(loop_runtime_release_revision_mismatch_total[5m]))",
          "legendFormat": "Mismatches"
        },
        {
          "expr": "sum(rate(loop_runtime_release_revision_resync_total[5m]))",
          "legendFormat": "Re-syncs"
        },
        {
          "expr": "sum(rate(loop_runtime_release_revision_resync_failure_total[5m]))",
          "legendFormat": "Re-sync Failures"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "LoopRuntimeApplication CR Ensures",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(rate(loop_runtime_application_cr_ensure_total[5m])) by (result)",
          "legendFormat": "{{result}}"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
