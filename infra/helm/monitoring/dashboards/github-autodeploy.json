{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Webhook Push Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(loopzero_webhook_push_total[5m])) by (result)", "legendFormat": "{{result}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Webhook Processing Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(loopzero_webhook_processing_duration_seconds_bucket[5m])) by (le, phase))", "legendFormat": "p95 {{phase}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Builds Superseded (cancelled by newer push)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(increase(loopzero_builds_superseded_total[1h]))", "legendFormat": "Last 1h" }
      ]
    },
    {
      "title": "Tenant Build Backpressure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum(rate(loopzero_build_tenant_backpressure_total[5m])) by (tenant)", "legendFormat": "{{tenant}}" }
      ]
    },
    {
      "title": "Revision Mismatches",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(loopzero_release_revision_mismatch_total[5m])", "legendFormat": "Mismatches" },
        { "expr": "rate(loopzero_release_revision_resync_total[5m])", "legendFormat": "Re-syncs" },
        { "expr": "rate(loopzero_release_revision_resync_failure_total[5m])", "legendFormat": "Re-sync Failures" }
      ]
    },
    {
      "title": "LoopZeroApplication CR Ensures",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        { "expr": "sum(rate(loopzero_application_cr_ensure_total[5m])) by (result)", "legendFormat": "{{result}}" }
      ]
    },
    {
      "title": "Deploy Duration (end-to-end)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(loopzero_deploy_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.50, sum(rate(loopzero_deploy_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["loopzero", "github", "autodeploy"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "LoopZero — GitHub Auto-Deploy",
  "uid": "loopzero-github-autodeploy"
}
