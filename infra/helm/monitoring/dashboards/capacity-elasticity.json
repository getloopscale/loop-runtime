{
  "title": "Capacity Elasticity",
  "uid": "capacity-elasticity",
  "tags": [
    "loop-runtime",
    "capacity",
    "autoscaling",
    "T-07"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(kube_horizontalpodautoscaler_spec_max_replicas, namespace)",
        "current": {
          "text": "loop-runtime-system",
          "value": "loop-runtime-system"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "HPA Current vs Target Replicas",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=~\"$namespace\"}",
          "legendFormat": "{{horizontalpodautoscaler}} current"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=~\"$namespace\"}",
          "legendFormat": "{{horizontalpodautoscaler}} max"
        },
        {
          "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=~\"$namespace\"}",
          "legendFormat": "{{horizontalpodautoscaler}} min"
        }
      ]
    },
    {
      "id": 2,
      "title": "HPA CPU Utilization vs Target",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 150
        }
      },
      "targets": [
        {
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=~\"$namespace\"} / kube_horizontalpodautoscaler_spec_max_replicas{namespace=~\"$namespace\"} * 100",
          "legendFormat": "{{horizontalpodautoscaler}} HPA utilization %"
        }
      ]
    },
    {
      "id": 3,
      "title": "Pod Replicas per Deployment",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=~\"$namespace\"}",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "HPA Scale Events (rate)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Positive = scale-up, negative = scale-down events/min",
      "targets": [
        {
          "expr": "rate(kube_horizontalpodautoscaler_status_current_replicas{namespace=~\"$namespace\"}[5m]) * 60",
          "legendFormat": "{{horizontalpodautoscaler}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Rejections — Argo 403 + API 429 (backpressure)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "rate(argo_workflows_k8s_request_total{status_code=\"403\"}[5m])",
          "legendFormat": "argo 403 (quota)"
        },
        {
          "expr": "sum(rate(loop_runtime_api_requests_total{status=\"429\"}[5m])) or vector(0)",
          "legendFormat": "loop-runtime-api 429 (admission)"
        }
      ]
    },
    {
      "id": 6,
      "title": "Workqueue Depth (Operators)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Alert TenantReconcileBacklog fires on > 50",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 25
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "workqueue_depth{name=~\"tenant|environment|application|exposure\"}",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "GitOps Operation p95 Latency (includes Gitea)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loop_runtime_gitops_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "gitops p95 (includes gitea)"
        }
      ]
    },
    {
      "id": 8,
      "title": "PVC Pending (bugs #18, #40)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Alert PVCPendingSustained fires on any > 2min",
      "targets": [
        {
          "expr": "sum(kube_persistentvolumeclaim_status_phase{phase=\"Pending\"}) by (namespace)",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Build Success Rate (moving 5m)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "description": "Alert BuildFailureRateHigh fires when below 90%",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(loop_runtime_builds_total{status=\"succeeded\"}[5m])) / sum(rate(loop_runtime_builds_total[5m]))"
        }
      ]
    },
    {
      "id": 10,
      "title": "Active Alerts (T-07 capacity)",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"GiteaAuthLatencyHigh|ArgoWorkflowQuotaExceeded|HPAAtMaxReplicas|PVCPendingSustained|TenantReconcileBacklog|BuildFailureRateHigh|LoopRuntimePodCrashLooping|LoopRuntimeHighAPILatency\"}",
          "format": "table"
        }
      ]
    }
  ]
}
