      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(loop_runtime_api_request_duration_seconds_bucket[5m])) or vector(0)",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(loop_runtime_api_request_duration_seconds_bucket[5m])) or vector(0)",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(loop_runtime_api_request_duration_seconds_bucket[5m])) or vector(0)",
          "legendFormat": "p99"
