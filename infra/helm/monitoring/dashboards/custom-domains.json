      },
      "id": 100,
      "title": "Custom Domains Overview",
      "type": "row",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "Domain Status Funnel",
      "type": "bargauge",
      "description": "Requires custom domains feature to be active. Shows domain lifecycle states.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "targets": [
        {
          "expr": "sum(loopruntime_custom_domains_total{status=\"pending_ns\"}) or vector(0)",
          "legendFormat": "pending_ns"
        },
        {
          "expr": "sum(loopruntime_custom_domains_total{status=\"ns_active\"}) or vector(0)",
          "legendFormat": "ns_active"
        },
        {
          "expr": "sum(loopruntime_custom_domains_total{status=\"provisioning\"}) or vector(0)",
          "legendFormat": "provisioning"
        },
        {
          "expr": "sum(loopruntime_custom_domains_total{status=\"active\"}) or vector(0)",
          "legendFormat": "active"
        },
        {
          "expr": "sum(loopruntime_custom_domains_total{status=\"failed\"}) or vector(0)",
          "legendFormat": "failed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No custom domains configured"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 101,
      "title": "Cloudflare KV (Static Delivery)",
      "type": "row",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "CF KV Drift",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 10
      },
      "id": 2,
      "targets": [
        {
          "expr": "max(loopruntime_cfkv_drift_detected) or vector(0)",
          "legendFormat": "Drift"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "green",
                  "index": 0,
                  "text": "CLEAN"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "color": "red",
                  "index": 1,
                  "text": "DRIFT!"
                }
              },
              "type": "value"
            }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "Deploy Duration (indicates domain routing health)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 10
      },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(loopruntime_build_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Deploy p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(loopruntime_build_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "Deploy p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 102,
      "title": "Domain Operations (requires custom domains feature active)",
      "type": "row",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "NS Propagation Duration",
      "type": "timeseries",
      "description": "Only populated when custom domains feature is active and domains are being provisioned.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(loopruntime_domain_ns_propagation_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(loopruntime_domain_ns_propagation_duration_seconds_bucket[1h])) by (le))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No domain operations"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "CF Zone API Errors",
      "type": "timeseries",
      "description": "Only populated when custom domains feature is active.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(loopruntime_domain_cf_zone_errors_total[5m])) by (operation)",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No CF zone errors"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    }
  ],
  "refresh": "1m",
