{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Domain Status Funnel",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(loopzero_custom_domains_total{status='pending_ns'}) or vector(0)", "legendFormat": "pending_ns" },
        { "expr": "sum(loopzero_custom_domains_total{status='ns_active'}) or vector(0)", "legendFormat": "ns_active" },
        { "expr": "sum(loopzero_custom_domains_total{status='provisioning'}) or vector(0)", "legendFormat": "provisioning" },
        { "expr": "sum(loopzero_custom_domains_total{status='active'}) or vector(0)", "legendFormat": "active" },
        { "expr": "sum(loopzero_custom_domains_total{status='failed'}) or vector(0)", "legendFormat": "failed" }
      ]
    },
    {
      "title": "NS Propagation Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(loopzero_domain_ns_propagation_duration_seconds_bucket[1h])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.50, sum(rate(loopzero_domain_ns_propagation_duration_seconds_bucket[1h])) by (le))", "legendFormat": "p50" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Domain Provisioning Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(loopzero_domain_provisioning_duration_seconds_bucket[1h])) by (le, result))", "legendFormat": "p95 {{result}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "CF Zone API Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(loopzero_domain_cf_zone_errors_total[5m])) by (operation)", "legendFormat": "{{operation}}" }
      ]
    },
    {
      "title": "CF KV Operations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(rate(loopzero_cfkv_operations_total[5m])) by (op, result)", "legendFormat": "{{op}} {{result}}" }
      ]
    },
    {
      "title": "CF KV Drift",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "targets": [
        { "expr": "loopzero_cfkv_drift_detected", "legendFormat": "Drift" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}] } } }
    },
    {
      "title": "CF KV Operation Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 24 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(loopzero_cfkv_operation_duration_seconds_bucket[5m])) by (le, op))", "legendFormat": "p95 {{op}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["loopzero", "domains", "cloudflare"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "LoopZero — Custom Domains & CF",
  "uid": "loopzero-custom-domains"
}
