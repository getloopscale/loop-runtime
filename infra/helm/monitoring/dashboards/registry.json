      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      }
    },
    {
      "title": "Pull Request Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
