{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Row: Health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "title": "Registry Canary Status",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 1 },
      "targets": [
        { "expr": "loopzero_registry_canary_success", "legendFormat": "Canary" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "title": "Push Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 4, "y": 1 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(harbor_core_http_request_duration_seconds_bucket{operation=\"push\"}[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(harbor_core_http_request_duration_seconds_bucket{operation=\"push\"}[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(harbor_core_http_request_duration_seconds_bucket{operation=\"push\"}[5m]))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Pull Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 1 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(harbor_core_http_request_duration_seconds_bucket{operation=\"pull\"}[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(harbor_core_http_request_duration_seconds_bucket{operation=\"pull\"}[5m]))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, rate(harbor_core_http_request_duration_seconds_bucket{operation=\"pull\"}[5m]))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Row: Throughput",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "title": "Push Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "targets": [
        { "expr": "sum(rate(harbor_core_http_request_total{operation=\"push\"}[5m]))", "legendFormat": "push req/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Pull Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "targets": [
        { "expr": "sum(rate(harbor_core_http_request_total{operation=\"pull\"}[5m]))", "legendFormat": "pull req/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "targets": [
        { "expr": "sum(rate(harbor_core_http_request_total{code=~\"5..\"}[5m]))", "legendFormat": "5xx errors/s" },
        { "expr": "sum(rate(harbor_core_http_request_total{code=~\"4..\"}[5m]))", "legendFormat": "4xx errors/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "title": "Row: Resources",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "title": "Harbor PG Connections",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "targets": [
        { "expr": "pg_stat_activity_count{datname=\"harbor_db\"}", "legendFormat": "Active" }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 6 },
              { "color": "red", "value": 8 }
            ]
          }
        }
      }
    },
    {
      "title": "S3 Storage Utilization",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "targets": [
        { "expr": "sum(harbor_project_quota_usage_byte)", "legendFormat": "Total Used" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "title": "GC Execution History",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "targets": [
        { "expr": "harbor_gc_duration_seconds", "legendFormat": "Duration" },
        { "expr": "harbor_gc_blobs_deleted", "legendFormat": "Blobs Deleted" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Duration" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      }
    },
    {
      "title": "Row: Tenant",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false
    },
    {
      "title": "Robot Accounts (Active)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 28 },
      "targets": [
        { "expr": "harbor_robot_account_total{status=\"active\"} or count(harbor_robot_account_info{disabled=\"false\"})", "legendFormat": "Active Robots" }
      ]
    },
    {
      "title": "Projects (Total)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 28 },
      "targets": [
        { "expr": "harbor_project_total or count(harbor_project_quota_usage_byte)", "legendFormat": "Total Projects" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["loopzero", "registry", "harbor"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "LoopZero — Registry (Harbor)",
  "uid": "loopzero-registry"
}
