{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenCost LoopRuntime wrapper values",
  "description": "Schema for infra/helm/opencost/values.yaml. Per T3.1 pattern (schema gate enforced via task validate:manifests).",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "opencost": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "opencost": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "prometheus": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "external": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": ["enabled", "url"],
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "url": {
                      "type": "string",
                      "pattern": "^https?://",
                      "description": "Prometheus URL — typically http://prometheus-server.monitoring.svc.cluster.local"
                    }
                  }
                }
              }
            },
            "customPricing": {
              "type": "object",
              "additionalProperties": true,
              "required": ["enabled", "provider"],
              "properties": {
                "enabled": { "type": "boolean" },
                "provider": {
                  "type": "string",
                  "enum": ["custom", "aws", "gcp", "azure"],
                  "description": "LoopRuntime uses 'custom' with DigitalOcean pricing overrides"
                }
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": true,
          "required": ["requests", "limits"]
        },
        "podSecurityContext": {
          "type": "object",
          "additionalProperties": true,
          "required": ["runAsNonRoot"],
          "properties": {
            "runAsNonRoot": {
              "type": "boolean",
              "const": true,
              "description": "MUST be true per LoopRuntime platform security standard"
            }
          }
        }
      }
    }
  }
}
