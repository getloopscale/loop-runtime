{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data-plane-service values",
  "type": "object",
  "required": ["image", "port", "healthPath", "existingSecret", "postgres"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1, "not": { "enum": ["latest", "develop", "main"] } },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "healthPath": { "type": "string", "pattern": "^/" },
    "nodePort": { "type": ["integer", "null"], "minimum": 30000, "maximum": 32767 },
    "runAsUser": { "type": "integer", "minimum": 1 },
    "existingSecret": { "type": "string", "minLength": 1 },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "secretEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "key"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "key": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "command"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "resources": { "type": "object" },
    "postgres": {
      "type": "object",
      "required": ["image", "database", "user", "uriEnv", "dataPath", "storage"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "user": { "type": "string", "minLength": 1 },
        "uriEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "uriEnv", "passwordKey"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
              "uriEnv": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
              "passwordKey": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
              "processes": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
            }
          }
        },
        "dataPath": { "type": "string", "pattern": "^/" },
        "pgdata": { "type": "string" },
        "storage": { "type": "string", "minLength": 1 },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" }
      }
    }
  }
}
