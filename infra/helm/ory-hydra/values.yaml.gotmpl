# Ory Hydra — OAuth2 Server for LoopRuntime Cloud
# Chart: ory/hydra v0.59.0 (app: Hydra v2.3.0)
#
# LOCAL DEV ONLY — production overrides via Pulumi secrets.
# DSN and secrets are overridden by Pulumi in DigitalOcean environments.

hydra:
  automigration:
    enabled: true
    type: initContainer

  # LOCAL DEV ONLY — enables HTTP issuer URLs (production requires HTTPS).
  # Production overrides via Pulumi set real HTTPS issuer and remove --dev.
  dev: true

  config:
    # T1.3 (plan 2026-05-21-deep-review-remediation): DSN templated via helmfile
    # env. LOOPRUNTIME_DB_PASSWORD required (set by task setup OR generate-secrets.sh).
    # Pulumi prod overrides this entire DSN via Secret reference.
    # EC-02 of plan 2026-05-22 v1.1 — single-quoted YAML allows unescaped
    # double quotes inside gotmpl template literal. Previous `"..."` form
    # with `\"` escape failed helmfile template render with
    # `unexpected "\\" in operand`. Cleanroom bug discovered 2026-05-21.
    {{- if not .Values.profile.awsSecretsManager }}
    dsn: 'postgres://loopruntime:{{ requiredEnv "LOOPRUNTIME_DB_PASSWORD" }}@postgresql.loopruntime-system.svc.cluster.local:5432/hydra?sslmode=disable'
    {{- end }}

    # --- URLs ---
    urls:
      self:
        # Plan 2026-05-19-drill-skills-rigor-restoration T2.1 PROD-PARITY fix:
        # Previous default was "http://localhost:4444/" with comment "production
        # overridden by Pulumi" — BUT Pulumi NEVER overrode (verified via grep
        # across infra/pulumi*/). PROD Hydra was emitting JWT with iss=localhost
        # which couldn't match anything real, breaking JWT validation system-wide
        # had any prod canary actually exercised the flow end-to-end (it was
        # masked by Bug #24 in the drill, never tested in prod). Cross-namespace
        # FQDN: Hydra in the loopruntime-auth ns, loopruntime-api in the loopruntime-system ns, both
        # resolve via cluster.local. Works for local k3d (CoreDNS) + drill
        # (DOKS) + prod (DOKS). Single source of truth — env-specific overlays
        # only for special cases (e.g., external HTTPS gateway).
        # Plan J-05 (2026-06-05) — LIVE bug caught by EC-10 contract test:
        # without an env-specific override, Hydra emitted verification_uri
        # pointing at the cluster-internal FQDN, breaking device-flow because
        # the user's browser cannot reach `*.svc.cluster.local`. publicAuthUrl
        # (already defined in dev-public.yaml + future drill/prod envs) is
        # the canonical override; absent → fallback to in-cluster FQDN that
        # works for service-to-service token validation.
        issuer: "{{ if and (hasKey .Values "publicAuthUrl") (ne (.Values.publicAuthUrl | toString) "") }}{{ .Values.publicAuthUrl | trimSuffix "/" }}{{ else }}http://ory-hydra-public.loopruntime-auth.svc.cluster.local:4444{{ end }}/"
        # urls.self.public controls the base used to build device-flow
        # verification_uri + discovery /.well-known endpoints. Must point at
        # the SAME public FQDN as issuer — otherwise Hydra emits
        # verification_uri with the cluster-internal host even when issuer
        # is correct (LIVE failure caught 2026-06-05 against
        # https://cloud-dev.getloopscale.com/v1/auth/device/authorize).
        public: "{{ if and (hasKey .Values "publicAuthUrl") (ne (.Values.publicAuthUrl | toString) "") }}{{ .Values.publicAuthUrl | trimSuffix "/" }}{{ else }}http://ory-hydra-public.loopruntime-auth.svc.cluster.local:4444{{ end }}/"
      # Plan 2026-05-19-drill-skills-rigor-restoration T2.1 — KNOWN GAP:
      # login/consent/logout URLs point at localhost:4455 (the k3d port-forward
      # of the Kratos UI) — works LOCALLY only. In drill/prod there is currently NO
      # Ingress for the Kratos UI (verified via kubectl get ingressroute -A on
      # drill 2026-05-19), so the OAuth auth-code flow (browser redirect) DOES NOT
      # WORK in drill/prod. For dogfood-drill, which uses the client_credentials
      # grant (machine-to-machine, no browser), this gap is IRRELEVANT.
      # For a customer-facing OAuth flow: create an IngressRoute for the Kratos UI +
      # override these URLs in values-hydra-{drill,prod}.yaml.gotmpl with a public
      # HTTPS FQDN (e.g., https://auth.drill.getloopscale.com/login). Fix
      # documented as a follow-up gap (does not block dogfood-drill).
      # Plan J-05 iter 4 amendment (2026-06-05) — login/consent URLs MUST
      # point at the cloud consent handler (cloud-dev.getloopscale.com/auth/*),
      # NOT the dashboard Kratos UI (app-dev.getloopscale.com/login). Hydra
      # redirects OAuth clients to these URLs WITH a challenge in the query;
      # only the consent handler knows how to process login_challenge/
      # consent_challenge by calling Hydra admin AcceptLogin / AcceptConsent.
      # The dashboard /login page (Kratos UI) is the STANDALONE login flow
      # for the dashboard itself (no Hydra involvement). Without this fix
      # device-flow stalls on the polling step because Hydra never receives
      # the AcceptLogin call (caught LIVE 2026-06-05 sponsor cross-device
      # test — CLI on cloud shell, browser on personal laptop, timed out).
      login: "{{ .Values.dashboardOrigin | default "http://localhost:13002" }}/auth/login"
      consent: "{{ .Values.dashboardOrigin | default "http://localhost:13002" }}/auth/consent"
      logout: "{{ .Values.uiBaseUrl | default "http://localhost:4455" }}/logout"
      # Plan J-05 T2.1 (2026-06-05, amended after a second LIVE debug cycle):
      # Hydra v2.6 nests device-flow URLs under `urls.device.*` (NOT
      # `urls.post_device_done_url`, which the schema rejects as
      # `additionalProperties`). First LIVE crash:
      #   `additionalProperties "post_device_done_url" not allowed`
      # Second LIVE failure (HTML response from the verification redirect):
      #   `urls.device.verification is not set` → Hydra refuses to render
      #   the device-verify page because no UI was configured.
      # Correct mapping:
      #   - urls.device.verification → user_code prompt page (browser landing
      #     after `verification_uri` redirect). Default = Hydra built-in
      #     /oauth2/fallbacks/device page on the public host, which works as
      #     long as Caddy routes /oauth2/* to Hydra public (see infra/local/Caddyfile).
      #   - urls.device.success → post-consent landing. Maps to the dashboard
      #     `/device-success` page implemented for J-05.
      # urls.device.verification points at the dashboard `/device-verify` page
      # the operator MUST host (Hydra v2.6's built-in /oauth2/fallbacks/device
      # is literally the "config missing" error page — discovered LIVE 2026-06-05).
      # The page reads ?device_challenge=&user_code= and submits to
      # POST /v1/auth/device/accept (which calls Hydra admin AcceptDeviceChallenge).
      device:
        verification: "{{ trimSuffix "/" (.Values.uiBaseUrl | default "http://localhost:4455") }}/device-verify"
        success: "{{ trimSuffix "/" (.Values.uiBaseUrl | default "http://localhost:4455") }}/device-success"

    # --- OAuth2 ---
    oauth2:
      expose_internal_errors: false
      # Every platform token comes from Hydra (docs/decisions.md, § Identity, #477), and a
      # resource server reads the tenant and account from the token itself. Consent-session
      # claims otherwise land only under `ext`. Still mirrored into `ext` while the readers
      # that look there are migrated.
      allowed_top_level_claims:
        - tenant_id
        - account_id
        - email
        - name
      mirror_top_level_claims: true

    # --- Serve ---
    serve:
      public:
        cors:
          enabled: true
          # Plan v1.2 T2.3 / D4 — CORS origins. uiBaseUrl is the auth UI
          # (Kratos), dashboardOrigin is the LoopRuntime dashboard (local port 3000
          # in dev; same host as uiBaseUrl in drill/prod). Env files override
          # both per environment.
          allowed_origins:
            - "{{ .Values.uiBaseUrl | default "http://localhost:4455" }}"
            - "{{ .Values.dashboardOrigin | default "http://localhost:3000" }}"
          allowed_methods:
            - GET
            - POST
            - PUT
            - DELETE
            - OPTIONS
          allowed_headers:
            - Authorization
            - Content-Type
          allow_credentials: true
      admin:
        cors:
          enabled: false

    # --- Logging ---
    log:
      level: info
      format: json
      leak_sensitive_values: false

    # --- Secrets ---
    secrets:
      # LOCAL DEV ONLY — production overrides via Pulumi.
      system:
        - "loopruntime-dev-hydra-system-secret!!"
      cookie:
        - "loopruntime-dev-hydra-cookie-secret!!"

    # --- TTLs ---
    # 2026-05-09: bumped access_token + id_token from 1h → 24h for LOCAL k3d
    # bootstrap dev. Production (Pulumi) overrides with the conservative
    # 1h TTL — the longer window is OK locally because:
    #   1. Local Hydra is firewalled to k3d cluster + dev developer.
    #   2. Cleanroom journey suites legitimately run >1h end-to-end and
    #      previously hit 7 false-fail "Authentication failed" because
    #      the JWT seeded at task setup expired mid-run.
    # If you flip this back to 1h, also re-design the journey suite to
    # mint+rotate JWT every N specs (more invasive than the bump).
    ttl:
      access_token: "24h"
      refresh_token: "720h"
      id_token: "24h"
      auth_code: "10m"

    # --- Strategies ---
    strategies:
      access_token: "jwt"
      jwt:
        scope_claim: "list"

# --- Service ---
service:
  public:
    enabled: true
    type: ClusterIP
    port: 4444
  admin:
    enabled: true
    type: ClusterIP
    port: 4445

# --- Resources ---
resources:
  requests:
    cpu: "50m"
    memory: "128Mi"
  limits:
    cpu: "300m"
    memory: "256Mi"

# --- Security Context (INF-G08 + plan ADR D7 hardened) ---
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 65534
  runAsGroup: 65534
  fsGroup: 65534
  seccompProfile:
    type: RuntimeDefault

securityContext:
  runAsNonRoot: true
  runAsUser: 65534
  runAsGroup: 65534
  readOnlyRootFilesystem: true
  allowPrivilegeEscalation: false
  capabilities:
    drop:
      - ALL

deployment:
  podSecurityContext:
    runAsNonRoot: true
    runAsUser: 65534
    runAsGroup: 65534
    seccompProfile:
      type: RuntimeDefault
  containerSecurityContext:
    readOnlyRootFilesystem: true
    allowPrivilegeEscalation: false
    runAsNonRoot: true
    capabilities:
      drop:
        - ALL
