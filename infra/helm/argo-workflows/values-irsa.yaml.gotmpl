# The AWS profile: build workflows reach the S3 buckets through the IRSA role infra-live
# creates for them (`identity/build-workflows`, trusting argo:loop-runtime-build-sa).
workflow:
  serviceAccount:
    annotations:
      eks.amazonaws.com/role-arn: {{ printf "arn:aws:iam::%s:role/%s-build-workflows" .Values.aws.accountId .Values.aws.namePrefix | quote }}
