# Vault Cluster — Helmfile (L2 Bootstrap, ISOLATED from mgmt)
#
# VK.4 of sponsor-direct decision 2026-06-02 (vault cluster isolation T3).
# This Helmfile targets the k3d loopzero-vault cluster (or DOKS loopzero-vault-prod
# in future). Lifecycle 100% independent of mgmt cluster — same principle
# as DOxAWS lifecycle independence (per-cloud tooling for different blast
# radius).
#
# BUG8.E LIVE pivot 2026-06-02: ABANDONED Bank-Vaults operator pattern
# (caused bug #8: reconciler reports "vaults openbao not found" with valid
# CR + RBAC + CRD discovery — confirmed in BOTH v1.24.0 AND v1.23.4
# downgrade; not version regression). Pivoted to OFFICIAL openbao-helm chart
# maintained by OpenBao org (LinuxFoundation/OpenSSF). Trade-offs:
#   GAINS: zero operator layer; zero CRD bugs; source canonical; alignment
#          with upstream OpenBao roadmap; simpler lifecycle (Helm direct).
#   LOSSES: BaoConfiguration CR declarative engine/auth config. Will be
#           replaced by init Job that runs `bao secrets enable` +
#           `bao auth enable` post-startup (standard OpenBao pattern).
#
# Releases (3):
#   - cert-manager      — TLS certificates for OpenBao HTTPS
#   - cluster-issuer    — self-signed-issuer ClusterIssuer
#   - openbao           — Official OpenBao chart v0.28.3 (appVersion v2.5.4)
#
# Invocation:
#   helmfile -f infra/helmfile/vault.helmfile.yaml.gotmpl -e vault-local \
#     --kube-context k3d-loopzero-vault sync
#
# Or via Taskfile:
#   task k3d:vault:bootstrap

environments:
  vault-local:
    # k3d single-node validation env per VK scope.
    values:
      - environments/vault-local.yaml
  prod:
    # Future: DOKS loopzero-vault-prod (3 nodes, AWS KMS unseal, HA Raft).
    values:
      - environments/prod.yaml

---
helmDefaults:
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: false
  createNamespace: true

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: openbao
    url: https://openbao.github.io/openbao-helm

releases:
  # ---------------------------------------------------------------------------
  # cert-manager — TLS certs for OpenBao HTTPS API (prod only; vault-local
  # uses TLS-disabled devMode per chart default)
  # ---------------------------------------------------------------------------
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.15.3
    values:
      - installCRDs: true
      - resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            cpu: 100m
            memory: 128Mi

  # ---------------------------------------------------------------------------
  # cluster-issuer — self-signed-issuer ClusterIssuer
  # OpenBao chart's server.extraSecretEnvironmentVars can reference TLS
  # certs created by cert-manager (prod env only — vault-local skips TLS).
  # ---------------------------------------------------------------------------
  - name: cluster-issuer
    namespace: cert-manager
    chart: ../helm/cluster-issuer
    needs:
      - cert-manager/cert-manager
    values:
      - issuerKind: selfsigned
      - loopzeroCaIssuerName: self-signed-issuer

  # ---------------------------------------------------------------------------
  # OpenBao — official chart, deploy direct (no operator).
  # vault-local: server.dev.enabled=true (in-memory, root token well-known).
  # prod: standalone mode with file/raft storage + AWS KMS auto-unseal.
  # ---------------------------------------------------------------------------
  - name: openbao
    namespace: vault-system
    chart: openbao/openbao
    version: 0.28.3
    installed: {{ .Values | get "openbaoEnabled" false }}
    needs:
      - cert-manager/cluster-issuer
    values:
      # Common across all envs
      - global:
          enabled: true
          tlsDisable: true  # vault-local k3d; prod overrides below
        injector:
          enabled: false  # not using vault-agent sidecar pattern (yet)
        csi:
          enabled: false  # not using CSI driver (yet)
        server:
          enabled: true
          # Logging
          logLevel: "info"
          # Resources for single-node OpenBao server
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
          # Liveness/readiness against bao API
          readinessProbe:
            enabled: true
          livenessProbe:
            enabled: true

      # vault-local: dev mode (in-memory, no unseal, root token fixed)
      {{- if eq .Environment.Name "vault-local" }}
      - server:
          dev:
            enabled: true
            # VK.6 LIVE: matches values-standalone.yaml convention
            # ("loopzero-dev-vault-root"). Pre-seed jobs reference this token.
            devRootToken: "loopzero-dev-vault-root"
          # NetworkPolicy ON even in standalone — validates policy templates
          networkPolicy:
            enabled: true
      {{- end }}

      # prod: file/raft storage + AWS KMS unseal
      {{- if eq .Environment.Name "prod" }}
      - server:
          dev:
            enabled: false
          # 3-replica HA via Raft (Q4)
          ha:
            enabled: true
            replicas: 3
            raft:
              enabled: true
              setNodeId: true
              config: |
                ui = true
                listener "tcp" {
                  tls_disable = 0
                  address = "[::]:8200"
                  cluster_address = "[::]:8201"
                  tls_cert_file = "/vault/userconfig/openbao-tls/tls.crt"
                  tls_key_file = "/vault/userconfig/openbao-tls/tls.key"
                }
                storage "raft" {
                  path = "/vault/data"
                }
                seal "awskms" {
                  region = "{{ env "OPENBAO_AWS_REGION" | default "us-east-1" }}"
                  kms_key_id = "{{ requiredEnv "OPENBAO_AWS_KMS_KEY_ID" }}"
                }
                service_registration "kubernetes" {}
          # AWS creds for KMS unseal via env vars (operator sources
          # ~/.openbao-prod-resources.env before helmfile sync)
          extraEnvironmentVars:
            AWS_REGION: "{{ env "OPENBAO_AWS_REGION" | default "us-east-1" }}"
          extraSecretEnvironmentVars:
            - envName: AWS_ACCESS_KEY_ID
              secretName: openbao-aws-creds
              secretKey: access_key_id
            - envName: AWS_SECRET_ACCESS_KEY
              secretName: openbao-aws-creds
              secretKey: secret_access_key
          # PodAntiAffinity hard (Q4)
          affinity: |
            podAntiAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                - labelSelector:
                    matchLabels:
                      app.kubernetes.io/name: openbao
                  topologyKey: kubernetes.io/hostname
          priorityClassName: system-cluster-critical
          # PDB minAvailable=2 (Q4 Raft quorum during drain)
          podDisruptionBudget:
            enabled: true
            minAvailable: 2
          # NetworkPolicy strict (Q4-F1 T8.5b)
          networkPolicy:
            enabled: true
        global:
          tlsDisable: false  # prod uses cert-manager TLS
      {{- end }}
