# Build Cluster — Helmfile (L2 Bootstrap)
# CHG-2026-04-28-LAYERED-BOOTSTRAP — Phase 2 / T2.2
#
# Replaces `infra/pulumi/src/components/build-bootstrap.ts` and friends.
#
# Invocation:
#   KUBECONFIG=~/.kube/loopzero-build.yaml helmfile -f infra/helmfile/build.helmfile.yaml -e dev sync

# The environments are declared once, in environments.yaml.
bases:
  - environments.yaml

---
helmDefaults:
  # O cluster deste plano, declarado onde o plano vive.
  #
  # Sem esta linha, um `helmfile sync` SEM --kube-context nao herda nada do
  # arquivo: ele usa o contexto ATIVO do kubectl. Medido contra helmfile 1.1.6.
  # Foi esse o defeito que o B-024 pagou noutro lugar — um seed operou o cluster
  # errado e a mensagem de erro culpou o recurso ausente, nao o cluster.
  #
  # A flag CONTINUA vencendo quando passada (medido: sobrescreve em silencio,
  # sem erro). Quem transforma uma divergencia em reprovacao e o gate
  # `helmfile-context-parity`, nao o helmfile. Ver ADR D1 da fatia slice-3.
  kubeContext: {{ env "LOOPZERO_BUILD_CONTEXT" | default "k3d-loopzero-build" }}
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: false
  createNamespace: true

repositories:
  - name: argo
    url: https://argoproj.github.io/argo-helm
  - name: grafana
    url: https://grafana.github.io/helm-charts

# ---------------------------------------------------------------------------
# Pre-sync setup (called by the CLI orchestrator BEFORE this helmfile runs):
#   1. bash infra/helmfile/scripts/install-local-path-provisioner.sh <env>
#      (B2 — fixes DO API rate limit on PVC during L3 burst)
#   2. bash infra/helmfile/scripts/generate-build-secrets.sh <env>
#      (B1 — generates real cosign keypair, replacing placeholder Secret)
# Hooks moved out of helmfile so list/lint/diff work without cluster access.

# ---------------------------------------------------------------------------
# Releases
# ---------------------------------------------------------------------------
releases:
  # Wave 0: Argo Workflows (build engine)
  - name: argo-workflows
    namespace: argo
    chart: argo/argo-workflows
    version: 1.0.5
    values:
      - ../helm/argo-workflows/values.yaml

  # B71 (end-to-end-deploy-validation-plan iter 9) — ClusterWorkflowTemplates
  # (loopzero-clone, loopzero-cache-save, loopzero-cache-restore) are referenced by every
  # build pipeline submitted via the API. Without this release, loopzero-api
  # creates Workflow CRs that fail with "template reference loopzero-clone.clone-repo
  # not found". In production, Pulumi build-bootstrap.ts used to deploy these;
  # after T1.1 deletion, this Helmfile release is the sole source.
  - name: loopzero-build-cwts
    namespace: argo
    chart: ../../charts/loopzero-build-cwts
    needs:
      - argo/argo-workflows
    values:
      - {}
    # Skip ServiceAccount/RBAC duplication — argo-workflows release already
    # creates loopzero-build-sa with the right permissions.
    # 2026-04-30 NEW-8 fix: chart templates read `workflow.serviceAccount.create`
    # (with the `workflow.` prefix), but the gate was setting plain
    # `serviceAccount.create`. The override was ignored and the install would
    # fail with "ServiceAccount loopzero-build-sa exists and cannot be imported"
    # whenever argo-workflows had created it first. Discovered LIVE during
    # full-dogfood unblock attempt 2026-04-30.
    set:
      - name: workflow.serviceAccount.create
        value: "false"

  # T0.2 Cenário B POC — CI infrastructure releases (post-MEET-2026-05-27).
  # Per ADR-2026-05-27-T0.2-RATIFIED: Argo Workflows + Argo Events provide
  # PR-time enforcement of `task quality:gates` via Gitea webhook → Sensor
  # → quality-gate WorkflowTemplate. Boundary mitigation per D3: CI workflows
  # in dedicated `argo-ci` namespace (NOT `argo` shared with tenant builds).

  - name: argo-ci-namespace
    namespace: argo-ci
    chart: ../helm/argo-ci-namespace
    # No needs — bootstraps the namespace itself.
    values:
      - ../helm/argo-ci-namespace/values.yaml

  - name: argo-events
    namespace: argo-events
    chart: ../helm/argo-events
    needs:
      - argo/argo-workflows
      - argo-ci/argo-ci-namespace
    values:
      - ../helm/argo-events/values.yaml

  # FAANG-pattern split: EventBus CR in separate chart that depends on
  # argo-events (controller + CRDs). Without this, helm install fails:
  #   "no matches for kind EventBus in version argoproj.io/v1alpha1"
  # because Helm renders+applies all release manifests BEFORE CRDs from
  # the dependency chart are registered in K8s API discovery.
  # Discovered LIVE during cleanroom iter 2026-05-27.
  - name: argo-events-bus
    namespace: argo-events
    chart: ../helm/argo-events-bus
    needs:
      - argo-events/argo-events
    values:
      - ../helm/argo-events-bus/values.yaml

  # loopzero-ci-workflows APOSENTADO em 2026-08-18 (B-019).
  #
  # O chart inteiro era nao-funcional, nao parte dele: `eventsource-gitea` -> `sensor-pr-trigger`
  # -> `workflowTemplateRef` -> o WorkflowTemplate de quality gate, mais os quatro CronWorkflows,
  # TODOS executando `registry.digitalocean.com/loopzero-system/loopzero-ops`. Medido em 2026-08-18:
  #
  #   o registro             `doctl registry get` -> 404 registry does not exist
  #   o Dockerfile           nao existe nenhum para loopzero-ops na arvore
  #   a task de build        nao existe — a unica mencao a ela era um comentario a declarando
  #   a matriz               release-artifacts.yml publica 5 imagens; loopzero-ops fora
  #   infra/images/ (3)      tambem fora da matriz — nao ha imagem alcancavel para hospedar
  #
  # E os workloads nao executavam o binario loopzero-ops: rodavam `task ...` e um script bash, sem
  # clone do repositorio e sem volume. O que faltava era um RUNNER DE CI com a arvore e o
  # toolchain dentro — artefato publicado novo, para rodar verificacoes que
  # `hooks/delivery-gate.sh` ja roda em TODO push via `task quality:all`, sem cluster nenhum.
  #
  # Construir esse runner seria erguer infraestrutura para duplicar uma trava que funciona.
  # `pre-release-governance.md`: legado e erro, deleta-se. A intencao dos quatro agendamentos
  # (watchdog 6h, soak semanal, cobertura semanal, prazo do cosign diario) esta registrada em
  # B-147; o git preserva o chart para quem reconstruir com um runner de verdade.
  - name: loki
    namespace: monitoring
    chart: grafana/loki
    version: 6.24.0
    values:
      - ../helm/loki/values.yaml
{{- with .Values | get "crossCluster.lokiNodePort" nil }}
      # The cross-cluster query bridge: loopzero-api on the core cluster reads Loki at
      # host.k3d.internal:<lokiNodePort>, a port infra/k3d/build-cluster.yaml publishes
      # on the build serverlb. The chart hard-codes its own `loki` Service as ClusterIP,
      # so the bridge is a second Service rendered here — it used to be the
      # `loki-cross-cluster` seed flipping the chart's Service to NodePort on the live
      # cluster, which no sync knew about (principle_violations#67). Rendered only where
      # the environment declares crossCluster.lokiNodePort: a published node port is a
      # k3d topology fact, not something a managed cluster should open.
      - extraObjects:
          - apiVersion: v1
            kind: Service
            metadata:
              name: loki-cross-cluster
              namespace: monitoring
              labels:
                app.kubernetes.io/name: loki
                app.kubernetes.io/component: cross-cluster-bridge
            spec:
              type: NodePort
              selector:
                app.kubernetes.io/name: loki
                app.kubernetes.io/instance: loki
                app.kubernetes.io/component: single-binary
              ports:
                - name: http-metrics
                  port: 3100
                  targetPort: http-metrics
                  nodePort: {{ . }}
                  protocol: TCP
{{- end }}

  - name: promtail
    namespace: monitoring
    chart: grafana/promtail
    version: 6.16.6
    # Read by ../helm/promtail/values.yaml.gotmpl: this Promtail runs in the same cluster
    # as the Loki above, so where the environment publishes that Loki through
    # crossCluster.lokiNodePort it pushes to the in-cluster Service, while the cells
    # push to the published port. The `loki-cross-cluster` seed used to rewrite this cluster's Promtail
    # Secret to the same URL after every sync.
    labels:
      lokiPush: colocated
    needs:
      - monitoring/loki
    values:
      - ../helm/promtail/values.yaml.gotmpl
