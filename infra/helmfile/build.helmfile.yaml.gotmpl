# Build Cluster — Helmfile (L2 Bootstrap)
# CHG-2026-04-28-LAYERED-BOOTSTRAP — Phase 2 / T2.2
#
# Replaces `infra/pulumi/src/components/build-bootstrap.ts` and friends.
#
# Invocation:
#   KUBECONFIG=~/.kube/loopruntime-build.yaml helmfile -f infra/helmfile/build.helmfile.yaml -e dev sync

# The environments are declared once, in environments.yaml.
bases:
  - environments.yaml

---
helmDefaults:
  # This plane's cluster, declared where the plane lives.
  #
  # Without this line, a `helmfile sync` WITHOUT --kube-context inherits nothing
  # from the file: it uses the ACTIVE kubectl context. Measured against helmfile
  # 1.1.6. That was the defect B-024 paid for elsewhere — a seed operated on the
  # wrong cluster and the error message blamed the missing resource, not the cluster.
  #
  # The flag STILL wins when passed (measured: it overrides silently, with no
  # error). What turns a divergence into a failure is the
  # `helmfile-context-parity` gate, not helmfile. See ADR D1 of slice slice-3.
  kubeContext: {{ env "LOOPRUNTIME_BUILD_CONTEXT" | default "k3d-loopruntime-build" }}
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: false
  createNamespace: true

repositories:
  - name: argo
    url: https://argoproj.github.io/argo-helm
  - name: grafana
    url: https://grafana.github.io/helm-charts
  # External Secrets and the AWS Load Balancer Controller (the AWS profile).
  - name: external-secrets
    url: https://charts.external-secrets.io
  - name: eks
    url: https://aws.github.io/eks-charts
  # The federation Prometheus (profile.awsLoadBalancerController).
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts

# ---------------------------------------------------------------------------
# Pre-sync setup (called by the CLI orchestrator BEFORE this helmfile runs):
#   1. bash infra/helmfile/scripts/install-local-path-provisioner.sh <env>
#      (B2 — fixes DO API rate limit on PVC during L3 burst)
#   2. bash infra/helmfile/scripts/generate-build-secrets.sh <env>
#      (B1 — generates real cosign keypair, replacing placeholder Secret)
# Hooks moved out of helmfile so list/lint/diff work without cluster access.

# ---------------------------------------------------------------------------
# Releases
# ---------------------------------------------------------------------------
releases:
  # Wave 0: Argo Workflows (build engine)
  - name: argo-workflows
    namespace: argo
    chart: argo/argo-workflows
    version: 1.0.5
    values:
      - ../helm/argo-workflows/values.yaml
{{- if .Values.profile.awsSecretsManager }}
      # IRSA: infra-live's `identity/build-workflows` trusts argo:loopruntime-build-sa, the
      # ServiceAccount every build workflow runs as (artifacts and static assets read-write,
      # builds read-only).
      - ../helm/argo-workflows/values-irsa.yaml.gotmpl
{{- end }}

  # B71 (end-to-end-deploy-validation-plan iter 9) — ClusterWorkflowTemplates
  # (loopruntime-clone, loopruntime-cache-save, loopruntime-cache-restore) are referenced by every
  # build pipeline submitted via the API. Without this release, loopruntime-api
  # creates Workflow CRs that fail with "template reference loopruntime-clone.clone-repo
  # not found". In production, Pulumi build-bootstrap.ts used to deploy these;
  # after T1.1 deletion, this Helmfile release is the sole source.
  - name: loopruntime-build-cwts
    namespace: argo
    chart: ../../charts/loopruntime-build-cwts
    needs:
      - argo/argo-workflows
    values:
      # The bucket loopruntime-api stages source bundles in (core.helmfile passes the
      # same environment value to loopruntime-api's config.sourceBucket).
      - sourceBucket: {{ .Values | get "sourceBucket" "loopruntime-builds" | quote }}
{{- if .Values.profile.awsSecretsManager }}
        # AWS S3 as the IRSA role of loopruntime-build-sa (identity/build-workflows), which
        # reads the builds bucket and writes the artifacts bucket, over verified TLS.
        objectStorage:
          credentials: irsa
        cacheBucket: {{ .Values.artifactsBucket | quote }}
        minio:
          insecure: false
{{- end }}
{{- with .Values | get "emulator.endpoint" "" }}
{{- $emulator := splitList ":" (urlParse .).host }}
        # Staging only: S3, STS and ECR answer on the emulator's host and port, not 443.
        networkPolicy:
          extraEgress:
            - to:
                - ipBlock:
                    cidr: {{ printf "%s/32" (index $emulator 0) | quote }}
              ports:
                - protocol: TCP
                  port: {{ index $emulator 1 }}
{{- end }}
{{- if .Values | get "platformImages.registry" "" }}
        # Pinned by the commit CI built it from, from the environment's platform
        # registry (#435) — the same rule as every other platform image.
        images:
          cloneRunner: "{{ .Values.platformImages.registry }}loopruntime-clone-runner:{{ index .Values.platformImages.tags "loopruntime-clone-runner" }}"
{{- else if .Values.profile.localRegistry }}
        # The clone runner `task images:build` pushes to the local registry
        # (taskfiles/infra.yml tags it v0.1.0, the chart's default tag).
        images:
          cloneRunner: "k3d-loopruntime-registry:5000/loopruntime-clone-runner:v0.1.0"
{{- end }}
    # Skip ServiceAccount/RBAC duplication — argo-workflows release already
    # creates loopruntime-build-sa with the right permissions.
    # 2026-04-30 NEW-8 fix: chart templates read `workflow.serviceAccount.create`
    # (with the `workflow.` prefix), but the gate was setting plain
    # `serviceAccount.create`. The override was ignored and the install would
    # fail with "ServiceAccount loopruntime-build-sa exists and cannot be imported"
    # whenever argo-workflows had created it first. Discovered LIVE during
    # full-dogfood unblock attempt 2026-04-30.
    set:
      - name: workflow.serviceAccount.create
        value: "false"

  # T0.2 Scenario B POC — CI infrastructure releases (post-MEET-2026-05-27).
  # Per ADR-2026-05-27-T0.2-RATIFIED: Argo Workflows + Argo Events provide
  # PR-time enforcement of `task quality:gates` via Gitea webhook → Sensor
  # → quality-gate WorkflowTemplate. Boundary mitigation per D3: CI workflows
  # in dedicated `argo-ci` namespace (NOT `argo` shared with tenant builds).

  - name: argo-ci-namespace
    namespace: argo-ci
    chart: ../helm/argo-ci-namespace
    # No needs — bootstraps the namespace itself.
    values:
      - ../helm/argo-ci-namespace/values.yaml

  - name: argo-events
    namespace: argo-events
    chart: ../helm/argo-events
    needs:
      - argo/argo-workflows
      - argo-ci/argo-ci-namespace
    values:
      - ../helm/argo-events/values.yaml

  # FAANG-pattern split: EventBus CR in separate chart that depends on
  # argo-events (controller + CRDs). Without this, helm install fails:
  #   "no matches for kind EventBus in version argoproj.io/v1alpha1"
  # because Helm renders+applies all release manifests BEFORE CRDs from
  # the dependency chart are registered in K8s API discovery.
  # Discovered LIVE during cleanroom iter 2026-05-27.
  - name: argo-events-bus
    namespace: argo-events
    chart: ../helm/argo-events-bus
    needs:
      - argo-events/argo-events
    values:
      - ../helm/argo-events-bus/values.yaml
{{- with .Values | get "defaultStorageClass" "" }}
      - eventBus:
          persistence:
            storageClassName: {{ . | quote }}
{{- end }}

  # loopruntime-ci-workflows RETIRED on 2026-08-18 (B-019).
  #
  # The whole chart was non-functional, not part of it: `eventsource-gitea` -> `sensor-pr-trigger`
  # -> `workflowTemplateRef` -> the quality-gate WorkflowTemplate, plus the four CronWorkflows,
  # ALL running `registry.digitalocean.com/loopruntime-system/loopruntime-ops`. Measured on 2026-08-18:
  #
  #   the registry           `doctl registry get` -> 404 registry does not exist
  #   the Dockerfile         there is none for loopruntime-ops in the tree
  #   the build task         does not exist — the only mention of it was a comment declaring it
  #   the matrix             release-artifacts.yml publishes 5 images; loopruntime-ops is not among them
  #   infra/images/ (3)      also outside the matrix — there is no reachable image to host it
  #
  # And the workloads did not run the loopruntime-ops binary: they ran `task ...` and a bash script, with
  # no clone of the repository and no volume. What was missing was a CI RUNNER with the tree and
  # the toolchain inside — a new published artifact, to run checks that
  # `hooks/delivery-gate.sh` already runs on EVERY push via `task quality:all`, with no cluster at all.
  #
  # Building that runner would mean standing up infrastructure to duplicate a lock that works.
  # `pre-release-governance.md`: legacy is an error, it gets deleted. The intent of the four schedules
  # (watchdog every 6h, weekly soak, weekly coverage, daily cosign deadline) is recorded in
  # B-147; git preserves the chart for whoever rebuilds it with a real runner.
  - name: loki
    namespace: monitoring
    chart: grafana/loki
    version: 6.24.0
{{- if .Values.profile.awsLoadBalancerController }}
    # The controller's webhook validates the loki-internal Ingress (values-alb.yaml).
    needs:
      - kube-system/aws-load-balancer-controller
{{- end }}
    values:
      - ../helm/loki/values.yaml
{{- if .Values.profile.awsSecretsManager }}
      - ../helm/loki/values-s3.yaml.gotmpl
{{- end }}
{{- if .Values.profile.awsLoadBalancerController }}
      # Published to the other clusters' Promtail through an internal ALB.
      - ../helm/loki/values-alb.yaml
{{- end }}
{{- with .Values | get "crossCluster.lokiNodePort" nil }}
      # The cross-cluster query bridge: loopruntime-api on the core cluster reads Loki at
      # host.k3d.internal:<lokiNodePort>, a port infra/k3d/build-cluster.yaml publishes
      # on the build serverlb. The chart hard-codes its own `loki` Service as ClusterIP,
      # so the bridge is a second Service rendered here — it used to be the
      # `loki-cross-cluster` seed flipping the chart's Service to NodePort on the live
      # cluster, which no sync knew about (principle_violations#67). Rendered only where
      # the environment declares crossCluster.lokiNodePort: a published node port is a
      # k3d topology fact, not something a managed cluster should open.
      - extraObjects:
          - apiVersion: v1
            kind: Service
            metadata:
              name: loki-cross-cluster
              namespace: monitoring
              labels:
                app.kubernetes.io/name: loki
                app.kubernetes.io/component: cross-cluster-bridge
            spec:
              type: NodePort
              selector:
                app.kubernetes.io/name: loki
                app.kubernetes.io/instance: loki
                app.kubernetes.io/component: single-binary
              ports:
                - name: http-metrics
                  port: 3100
                  targetPort: http-metrics
                  nodePort: {{ . }}
                  protocol: TCP
{{- end }}

  - name: promtail
    namespace: monitoring
    chart: grafana/promtail
    version: 6.16.6
    # Read by ../helm/promtail/values.yaml.gotmpl: this Promtail runs in the same cluster
    # as the Loki above, so where the environment publishes that Loki through
    # crossCluster.lokiNodePort it pushes to the in-cluster Service, while the cells
    # push to the published port. The `loki-cross-cluster` seed used to rewrite this cluster's Promtail
    # Secret to the same URL after every sync.
    labels:
      lokiPush: colocated
{{- if .Values.profile.awsLoadBalancerController }}
      # The cluster every stream is labelled with.
      cluster: build
{{- end }}
    needs:
      - monitoring/loki
    values:
      - ../helm/promtail/values.yaml.gotmpl
{{- if .Values.profile.awsSecretsManager }}

  # External Secrets with infra-live's `identity/build-external-secrets` role, and its store.
  - name: external-secrets
    namespace: external-secrets
    chart: external-secrets/external-secrets
    version: 0.14.3
    values:
      - ../helm/external-secrets/values.yaml
      - serviceAccount:
          name: external-secrets
          annotations:
            eks.amazonaws.com/role-arn: {{ printf "arn:aws:iam::%s:role/%s-build-external-secrets" .Values.aws.accountId .Values.aws.namePrefix | quote }}
{{- with .Values | get "emulator.endpoint" "" }}
        # Staging only (environments/staging.yaml `emulator:`): aws-sdk-go v1 ignores
        # AWS_ENDPOINT_URL and reads one endpoint variable per service.
        extraEnv:
          - name: AWS_SECRETSMANAGER_ENDPOINT
            value: {{ . | quote }}
          - name: AWS_STS_ENDPOINT
            value: {{ . | quote }}
{{- end }}

  - name: aws-secrets-manager
    namespace: external-secrets
    chart: ../helm/aws-secrets-manager
    needs:
      - external-secrets/external-secrets
    values:
      - region: {{ .Values.aws.region | quote }}
        buildSigningKey:
          secretsManagerKey: {{ .Values.aws | get "signingKeySecret" "" | quote }}
{{- with .Values | get "tenantRegistry" dict }}

  # The credential the build pushes tenant images with: an ECR token for the tenant
  # registry under infra-live's identity/build-registry-push role, refreshed by a CronJob.
  - name: ecr-registry-auth
    namespace: argo
    chart: ../helm/ecr-registry-auth
    values:
      - registryHost: {{ .host | quote }}
        region: {{ $.Values.aws.region | quote }}
        roleArn: {{ printf "arn:aws:iam::%s:role/%s-build-registry-push" $.Values.aws.accountId $.Values.aws.namePrefix | quote }}
        images:
          awsCli: "{{ $.Values.platformImages.registry }}loopruntime-syft-scanner:{{ index $.Values.platformImages.tags "loopruntime-syft-scanner" }}"
{{- end }}
{{- end }}
{{- if .Values.profile.awsLoadBalancerController }}

  # This cluster's metrics for the core Prometheus, which federates them through the
  # internal ALB of ../helm/monitoring/values-prometheus-federation.yaml. The build
  # cluster runs no kube-state-metrics of its own, so the chart's is installed.
  - name: prometheus-federation
    namespace: monitoring
    chart: prometheus-community/prometheus
    version: 25.27.0
    needs:
      - kube-system/aws-load-balancer-controller
    values:
      - ../helm/monitoring/values-prometheus-federation.yaml
      - kube-state-metrics:
          enabled: true

  # The AWS Load Balancer Controller, with infra-live's `identity/build-lb-controller` role.
  - name: aws-load-balancer-controller
    namespace: kube-system
    chart: eks/aws-load-balancer-controller
    version: 3.6.3
    values:
      - ../helm/aws-load-balancer-controller/values.yaml.gotmpl
      - clusterName: {{ printf "%s-build" .Values.aws.namePrefix | quote }}
        serviceAccount:
          annotations:
            eks.amazonaws.com/role-arn: {{ printf "arn:aws:iam::%s:role/%s-build-lb-controller" .Values.aws.accountId .Values.aws.namePrefix | quote }}
{{- end }}
