# staging: the core Prometheus federates the Prometheus of each remote cluster (build and
# the cells, ../../../helm/monitoring/values-prometheus-federation.yaml) through that
# cluster's internal ALB, and renders no k3d job (../../../helm/monitoring/values-prometheus.yaml).
#
# LOOPZERO_METRICS_ALB_DNS_NAMES is `<cluster>=<DNSName>,...`, the DNSName of each remote
# cluster's prometheus-federation Ingress, which `task staging:platform` reads once the
# cells are synced (infra/staging/monitoring-addresses.sh). The first core sync of a
# rebuild runs before those ALBs exist, without it, and federates nothing yet; once it is
# set it must name every remote cluster.
#
# On the emulator (`emulator.endpoint`) an ALB is reached at the emulator's endpoint with
# its DNSName in the path; on AWS the DNSName resolves in the VPC.
{{- $names := env "LOOPZERO_METRICS_ALB_DNS_NAMES" }}
{{- $byCluster := dict }}
{{- range $pair := without (splitList "," $names) "" }}
{{- $parts := splitList "=" $pair }}
{{- if or (ne (len $parts) 2) (not (regexMatch "^[a-z0-9-]+$" (index $parts 0))) (not (regexMatch "^[A-Za-z0-9.-]+(:[0-9]+)?$" (index $parts 1))) }}
{{- fail (printf "LOOPZERO_METRICS_ALB_DNS_NAMES: %q is not <cluster>=<DNSName>" $pair) }}
{{- end }}
{{- $_ := set $byCluster (index $parts 0) (index $parts 1) }}
{{- end }}
{{- $clusters := list "build" }}
{{- range .Values.cells }}
{{- $clusters = append $clusters .id }}
{{- end }}
{{- $endpoint := .Values | get "emulator.endpoint" "" }}
federation:
  clusters:
{{- if $names }}
{{- range $cluster := $clusters }}
{{- $alb := index $byCluster $cluster | required (printf "LOOPZERO_METRICS_ALB_DNS_NAMES names no ALB for the %s cluster" $cluster) }}
    - name: {{ $cluster }}
{{- if $endpoint }}
      scheme: {{ (urlParse $endpoint).scheme }}
      address: {{ (urlParse $endpoint).host }}
      metricsPath: {{ printf "/_aws/elasticloadbalancing/%s/federate" $alb }}
{{- else }}
      scheme: http
      address: {{ printf "%s:80" $alb }}
      metricsPath: /federate
{{- end }}
{{- end }}
{{- else }} []
{{- end }}
