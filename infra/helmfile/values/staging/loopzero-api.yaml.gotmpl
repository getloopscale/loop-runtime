# staging overlay for charts/loopzero-api, layered on charts/loopzero-api/values-bootstrap.yaml.
#
# Credentials arrive from Secrets Manager: loopzero-db-credentials, loopzero-api-internal,
# loopzero-service-auth and loopzero-edge-route-token are ExternalSecrets of the
# aws-secrets-manager release. The ServiceAccount carries the IRSA role infra-live creates
# for it (`identity/core-loopzero-api`, trusting loopzero-system:loopzero-api).
global:
  registry: {{ required "platformImages.registry is not set" .Values.platformImages.registry | trimSuffix "/" }}

image:
  repository: loopzero-api
  tag: {{ required "platformImages.tags.loopzero-api is not set" (index .Values.platformImages.tags "loopzero-api") | quote }}
  pullPolicy: IfNotPresent

imagePullSecrets: []

serviceAccount:
  annotations:
    eks.amazonaws.com/role-arn: {{ printf "arn:aws:iam::%s:role/%s-core-loopzero-api" .Values.aws.accountId .Values.aws.namePrefix | quote }}

ingressRoute:
  host: {{ printf "api.%s" .Values.domain | quote }}
  # Public TLS terminates at the edge in front of the ALB (CloudFront and ACM in
  # production, Caddy on staging), and the ALB does not validate the certificate Traefik
  # presents, so the route asks cert-manager for none and Traefik serves its default one.
  # The value is named after Cloudflare, the first edge that worked this way.
  certIssuer: CFManaged

config:
  loopzeroEnv: "production"
  # environments/staging.yaml tenantRegistry: builds push tenant images there.
  registryUrl: {{ printf "%s/%s" .Values.tenantRegistry.host .Values.tenantRegistry.repositoryPrefix | quote }}
  # The build cluster's Loki, through its internal ALB (monitoring/loki-internal), which
  # the emulator serves at its endpoint with the ALB's DNSName in the path. `task
  # staging:platform` exports the DNSName (infra/staging/monitoring-addresses.sh loki);
  # before the build sync of a rebuild there is none and the chart's default stands.
{{- with env "LOOPZERO_LOKI_ALB_DNS_NAME" }}
  lokiUrl: {{ printf "%s/_aws/elasticloadbalancing/%s" $.Values.emulator.endpoint . | quote }}
{{- end }}
  baseDomain: {{ .Values.domain | quote }}
  # The CloudFront KeyValueStore the API publishes the host to cell routes of tenant apps
  # to (infra-live edge/app-routes), exported by `task staging:platform:outputs` (#68).
  edgeKvsArn: {{ requiredEnv "LOOPZERO_EDGE_KVS_ARN" | quote }}
  corsAllowedOrigin: {{ .Values.dashboardOrigin | quote }}
  # Empty: with no static key and the IRSA role above, the API signs with the AWS
  # credential chain and takes the S3 endpoint from AWS_ENDPOINT_URL (the emulator, which
  # the EKS layer injects) or the region. The bucket is environments/staging.yaml
  # sourceBucket, which the role is granted.
  minioEndpoint: ""
  loopzeroCosignImage: "{{ .Values.platformImages.registry }}loopzero-cosign-signer:{{ index .Values.platformImages.tags "loopzero-cosign-signer" }}"
  loopzeroSyftImage: "{{ .Values.platformImages.registry }}loopzero-syft-scanner:{{ index .Values.platformImages.tags "loopzero-syft-scanner" }}"
  # The issuer Hydra emits (values/staging/ory-hydra.yaml.gotmpl); its keys are fetched
  # in-cluster.
  jwtIssuer: {{ printf "%s/" (.Values.publicAuthUrl | trimSuffix "/") | quote }}
  jwksUrl: "http://ory-hydra-public.loopzero-auth.svc.cluster.local:4444/.well-known/jwks.json"
  # The contexts of loopzero-cluster-kubeconfigs, written by the bootstrap: core is the
  # in-cluster one, build and cell-0 are scoped ServiceAccount kubeconfigs.
  mgmtKubeContext: "in-cluster"
  buildKubeContext: "build"
  runtimeKubeContext: "cell-0"
