# staging overlay for charts/loop-runtime-tenant-operator: the image from the environment's
# platform registry, pinned by the commit CI built it from.
global:
  registry: {{ required "platformImages.registry is not set" .Values.platformImages.registry | trimSuffix "/" }}
  imagePullSecrets: []

image:
  tag: {{ required "platformImages.tags.loop-runtime-tenant-operator is not set" (index .Values.platformImages.tags "loop-runtime-tenant-operator") | quote }}
  pullPolicy: IfNotPresent

networkPolicy:
  enabled: true
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
      ports:
        - protocol: TCP
          port: 8443
  extraEgress:
    # The cluster API servers (6443) and AWS (443).
    - ports:
        - protocol: TCP
          port: 6443
        - protocol: TCP
          port: 443
    - ports:
        - protocol: TCP
          port: 3000
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: loop-runtime-system
    - ports:
        - protocol: TCP
          port: 8080
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: argocd

config:
  argocdNamespace: argocd
  ingressNamespace: traefik

# Written by the bootstrap (`loop-runtime-ops seed gitea-token`), as on every environment.
secrets:
  create: false
  existingSecret: loop-runtime-tenant-operator

kubeconfig:
  build:
    existingConfigMap: loop-runtime-build-kubeconfig
  cell0:
    existingConfigMap: loop-runtime-cell-0-kubeconfig
