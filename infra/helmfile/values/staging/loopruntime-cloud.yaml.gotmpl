# staging overlay for charts/loopruntime-cloud, layered on charts/loopruntime-cloud/values-bootstrap.yaml.
#
# Installed when environments/staging.yaml turns profile.loopruntimeCloud on, together with
# loopruntime-dashboard and the app host route of the public-routes release. Its images are
# private on GHCR: the nodes pull them with the `ghcr-pull` Secret (the aws-secrets-manager
# release writes it from Secrets Manager, aws.imagePullSecret). A production environment
# pulls from ECR with the node role and lists no pull Secret.
{{- if .Values.profile.loopruntimeCloud }}
global:
  registry: {{ required "platformImages.registry is not set" .Values.platformImages.registry | trimSuffix "/" }}

image:
  repository: loopruntime-cloud
  tag: {{ required "platformImages.tags.loopruntime-cloud is not set: pin the image CI published" (index .Values.platformImages.tags "loopruntime-cloud") | quote }}
  pullPolicy: IfNotPresent

imagePullSecrets:
  - name: ghcr-pull

# SESSION_TOKEN_SECRET and Stripe's test-mode keys, written by the aws-secrets-manager
# release from Secrets Manager.
existingSecret: loopruntime-cloud-secrets

config:
  # The console's production mode ("prod"): it refuses to start without its database,
  # session, service-auth and Stripe secrets, instead of making them up.
  loopruntimeEnv: "prod"
  appPublicUrl: {{ .Values.uiBaseUrl | quote }}
  authCookieDomain: {{ .Values.cookieDomain | quote }}
  kratosInternalUrl: "http://ory-kratos-public.loopruntime-auth.svc.cluster.local:80"
  # The issuer Hydra emits (values/staging/ory-hydra.yaml.gotmpl).
  jwtIssuer: {{ printf "%s/" (.Values.publicAuthUrl | trimSuffix "/") | quote }}
  # The staging GitHub App the install button sends the browser to
  # (github.com/apps/<slug>/installations/new); aws.githubAppSecret holds its keys.
  githubAppSlug: "loopscale-staging"
  # The OAuth client id of that App, public. staging:platform reads it from the host's
  # github-app.json; GitHub returns the browser to
  # <appPublicUrl>/v1/integrations/github/callback.
  githubAppClientId: {{ env "LOOPRUNTIME_GITHUB_APP_CLIENT_ID" | quote }}

# The cloud host: the whole control plane API. The app host is the public-routes release.
ingressRoute:
  enabled: true
  host: {{ .Values.dashboardOrigin | trimPrefix "https://" | quote }}
  middlewares:
    - name: rate-limit
      namespace: traefik
    - name: body-limit
      namespace: traefik
  # GET .../stream (Server-Sent Events) without body-limit, whose buffering holds the
  # response until it ends.
  streamMiddlewares:
    - name: rate-limit
      namespace: traefik
  # TLS terminates at the edge (Caddy on staging); see values/staging/loopruntime-api.yaml.gotmpl.
  certIssuer: CFManaged
{{- else }}
{}
{{- end }}
