# Plan 2026-06-04-dev-public-docr-fix-forward T2.2.
# Minimal override for env dev-public.
# Chart defaults canonical (DOCR + dev tag + IfNotPresent + HA).

global:
  registry: ghcr.io/getloopscale
  imagePullSecrets:
    - name: ghcr-pull

image:
  tag: develop
  pullPolicy: Always

config:
  baseDomain: "{{ .Values.domain }}"

# dev-public NetworkPolicy override: gitea is in loopzero-system ns (not the
# chart-default `gitea` ns). Same fix as loopzero-tenant-operator.
networkPolicy:
  enabled: true
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
      ports:
        - protocol: TCP
          port: 8443
  extraEgress:
    - ports:
        - protocol: TCP
          port: 6443
        - protocol: TCP
          port: 443
    - ports:
        - protocol: TCP
          port: 3000
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: loopzero-system
    - ports:
        - protocol: TCP
          port: 8080
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: argocd
    - ports:
        - protocol: TCP
          port: 9000
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: loopzero-system

kubeconfig:
  runtime:
    existingConfigMap: loopzero-runtime-kubeconfig
