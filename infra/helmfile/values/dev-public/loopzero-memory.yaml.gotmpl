# dev-public overlay for infra/helm/data-plane-service: loopzero-memory (#446).
#
# The image comes from Amazon ECR pinned by the commit it was built from, like every
# platform image (`platformImages` in environments/dev-public.yaml); a missing tag fails
# the render. The environment is what the compose deployment this replaces ran with,
# measured on the droplet on 2026-09-29.
image:
  repository: {{ required "platformImages.registry is not set" .Values.platformImages.registry }}loopzero-memory
  tag: {{ required "platformImages.tags.loopzero-memory is not set" (index .Values.platformImages.tags "loopzero-memory") | quote }}

port: 8080
healthPath: /v1/health
# Host port 18081 (infra/k3d/core-cluster.yaml): the edge and the seed chain reach it there.
nodePort: 30181
# The image's USER is the distroless nonroot uid.
runAsUser: 65532

existingSecret: loopzero-memory
env:
  HOST: "0.0.0.0"
  PORT: "8080"
  THEMEMORY_REQUIRE_CREDENTIAL: "true"
  LOOPZEROMEM_EMBEDDER: openai
  TRANSFORMERS_CACHE: /tmp/.transformers-cache
secretEnv:
  - { name: OPENAI_API_KEY, key: openai-api-key }
  - { name: THEMORY_ADMIN_BOOTSTRAP_TOKEN, key: admin-bootstrap-token }

# The MCP server (#470): an OAuth 2.1 resource server behind infra/helm/mcp-gateway. Its
# resource URI and issuer are the audience and issuer the gateway enforces — spelled from the
# same environment values, and compared by infra/tests/charts/mcp_gateway_test.go. The app
# migrates; this process only serves.
workers:
  - name: mcp
    command: ["/nodejs/bin/node", "/app/dist/agent-tools/cli.js", "mcp", "--host", "0.0.0.0", "--port", "3100"]
    port: 3100
    healthPath: /.well-known/oauth-protected-resource
    env:
      LOOPZERO_MCP_RESOURCE: {{ printf "%s/mcp/memory" (.Values.publicCloudUrl | trimSuffix "/") | quote }}
      LOOPZERO_OAUTH_ISSUER: {{ printf "%s/" (.Values.publicAuthUrl | trimSuffix "/") | quote }}
      LOOPZERO_OAUTH_JWKS_URI: "http://ory-hydra-public.loopzero-auth.svc.cluster.local:4444/.well-known/jwks.json"
      LOOPZERO_MCP_TLS_TERMINATED_UPSTREAM: "true"
      THEMEMORY_SKIP_MIGRATIONS: "true"

postgres:
  image: mirror.gcr.io/ankane/pgvector:v0.5.1@sha256:d3a9d8ac27bb7e05e333ef25b634d2625adaa85336ab729954b9e94859bf6fa7
  database: themem
  user: themem
  # The owner migrates; requests go through themory_app, which the service insists on:
  # it refuses to serve as a superuser, whom row level security does not bind.
  uriEnv: LOOPZEROMEM_MIGRATE_PG_URI
  roles:
    - { name: themory_app, uriEnv: LOOPZEROMEM_PG_URI, passwordKey: app-role-password }
  dataPath: /var/lib/postgresql/data
  pgdata: /var/lib/postgresql/data/pgdata
  storage: 5Gi
  runAsUser: 999
