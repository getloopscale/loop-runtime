# SPDX-License-Identifier: Apache-2.0
# Iter 25 productive-idle of plan 2026-06-10-j22-openbao-transit-eso-sync v1.2.
# T1.2 of plan dev-public-cross-cluster-secrets v1.1 (issue #111).
#
# Dev-public env overlay for loopruntime-external-secrets chart. Wires the
# openbao-transit ClusterSecretStore (T2.4) with workload identity
# (Kubernetes-auth) against the OpenBao running in a SEPARATE
# k3d-loopruntime-secrets cluster (Approach A — UNBREAKABLE sponsor mandate
# 2026-06-19). The legacy AppRole shape (static secret_id mounted
# as K8s Secret in mgmt) is replaced by auth.kubernetes pointing at
# the ESO controller's ServiceAccount + a bounded TokenRequest
# audience that matches the OpenBao role's `bound_audiences` (EC-5).
#
# Cross-cluster trust contract (EC-1): the OpenBao kubernetes-auth
# method in the loopruntime-secrets cluster MUST be configured to review
# tokens against the MGMT cluster — JWKS-static (mgmt issuer + public
# keys, preferred — no reverse call) OR `kubernetes_host`=mgmt API +
# `kubernetes_ca_cert` + `disable_local_ca_jwt=true`. Without this,
# the DEFAULT kubernetes-auth reviews against the LOCAL cluster
# (loopruntime-secrets), which never issued the mgmt pod's token → 403.
#
# Cross-cluster DNS contract (EC-2): `server` keeps the canonical
# intra-cluster DNS name (`openbao.secrets-system.svc.cluster.local`)
# so the cert SAN survives; mgmt CoreDNS host-alias (T2.2) rewrites
# this DNS to the loopruntime-secrets NodePort IP at resolve time.

openbaoTransit:
  # SAFE DEFAULT: stays disabled until operator completes:
  #   - task k3d:secrets:create (provision separate loopruntime-secrets cluster)
  #   - task k3d:secrets:bootstrap (helmfile install OpenBao chart)
  #   - sponsor TOGETHER: bao operator init + Shamir unseal × 3
  #     (docs/runbooks.md)
  #   - helmfile sync --selector name=openbao-init ran (T5.1-T5.9)
  #   - OpenBao kubernetes-auth method enabled + role created with
  #     bound_service_account_names=external-secrets +
  #     bound_service_account_namespaces=external-secrets +
  #     bound_audiences=<aud-below> + token_review against mgmt cluster
  #     (EC-1 — JWKS-static OR kubernetes_host=mgmt+disable_local_ca_jwt)
  #   - mgmt CoreDNS host-alias maps openbao.secrets-system.svc.cluster.local
  #     to the loopruntime-secrets node IP + NodePort (T2.2, EC-2)
  # When all boxes are ticked, flip this and `helmfile -e dev-public apply`.
  enabled: false

  # EC-2: canonical intra-cluster DNS preserves the cert SAN. CoreDNS
  # host-alias (T2.2) rewrites this DNS to the loopruntime-secrets cluster's
  # node IP + NodePort, so the cross-cluster connection lands on
  # OpenBao serving the same TLS cert it would in a single-cluster
  # topology. If we substituted the IP literally here the cert SAN
  # validation would fail.
  server: "https://openbao.secrets-system.svc.cluster.local:8200"

  # T1.2 of dev-public-cross-cluster-secrets (issue #111): Approach A
  # workload identity. ESO controller's SA token (TokenRequest API)
  # is presented to OpenBao /v1/auth/kubernetes/login. Replaces the
  # legacy AppRole path (static secret_id mounted as K8s Secret in
  # mgmt) which required the cross-cluster Secret bridge that T1.1
  # deleted.
  auth:
    kind: "kubernetes"
    kubernetes:
      # OpenBao role bound to the ESO controller's SA + audiences below.
      # Operator creates with:
      #   bao write auth/kubernetes/role/loopruntime-eso \
      #     bound_service_account_names=external-secrets \
      #     bound_service_account_namespaces=external-secrets \
      #     bound_audiences=openbao.vault.runtime.getloopscale.com \
      #     policies=loopruntime-eso \
      #     ttl=1h
      role: "loopruntime-eso"
      mountPath: "kubernetes"
      serviceAccountRef:
        name: "external-secrets"
        namespace: "external-secrets"
        # EC-5: TokenRequest aud MUST match the OpenBao role's
        # `bound_audiences` declared above. Empty audiences → 403.
        audiences:
          - "openbao.vault.runtime.getloopscale.com"

  # OpenBao TLS CA bundle. Empty → ESO trusts the K8s system cert
  # pool. Under Approach A the cert is signed by cert-manager's
  # cluster-issuer in the loopruntime-secrets cluster (chained from k3s
  # embedded CA). Operator decides at flip-time whether to inline
  # the CA bundle here (reproducible) or mount it as a ConfigMap
  # on the ESO controller (cleaner).
  caBundle: ""

# ============================================================================
# T1.5 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2.
#
# Canonical declarative ExternalSecret contract closes catches #9 + #10 from
# T6.2 session (memories j09-aprendizado-github-creds-via-eso-canonical +
# j23-aprendizado-webhook-secret-separate-canonical).
#
# Per ADR D8 canonical contract:
#   - ClusterSecretStore: loopruntime-secrets-secrets (chart base default)
#   - ExternalSecret loopruntime-api-github: GitHub App private key + APP_ID
#     (chart base externalSecrets[] entry — atomic rotation semantics)
#   - ExternalSecret loopruntime-github-webhook: HMAC webhook secret SEPARATE
#     from loopruntime-api-github per J-23 lesson (catch #10).
#
# Why webhook is SEPARATE: webhook delivery handler runs at the cross-tenant
# edge and would mount the GitHub App private key if bundled — defense-in-
# depth says isolate per least-privilege boundary.
# ============================================================================

secretStoreRef:
  kind: ClusterSecretStore
  name: loopruntime-secrets-secrets

externalSecretsExtra:
  - name: loopruntime-github-webhook
    targetSecret: loopruntime-github-webhook
    targetNamespace: loopruntime-system
    vaultBinary: api
    vaultCategory: secrets
    data:
      - secretKey: value
        vaultKey: github/webhook_secret_v2
