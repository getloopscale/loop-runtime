# Plan 2026-06-04-dev-public-docr-fix-forward T2.2.
# Minimal override for env dev-public.
# Chart defaults (charts/loop-runtime-tenant-operator/values.yaml) canonical:
#   global.registry: registry.digitalocean.com/loop-runtime-system
#   image.{repository,tag,pullPolicy}: loop-runtime-tenant-operator / dev / IfNotPresent
#   replicaCount: 2 (HA)
#   config.operatorInsecureSkipTls: "false"  ← we override to "true" because
#       the env uses selfsigned-issuer (declared in environments/dev-public.yaml).

# Platform images come from Amazon ECR, pinned by the commit each was built from (#435):
# the registry and the tag are `platformImages` in environments/dev-public.yaml, and a
# missing entry fails the render instead of falling back to a moving tag. No pull
# secret: the node's kubelet credential provider authenticates, as on EKS.
global:
  registry: {{ required "platformImages.registry is not set" .Values.platformImages.registry | trimSuffix "/" }}
  imagePullSecrets: []

image:
  tag: {{ required "platformImages.tags.loop-runtime-tenant-operator is not set" (index .Values.platformImages.tags "loop-runtime-tenant-operator") | quote }}
  pullPolicy: IfNotPresent

config:
  # Slice 4 ISP remediation (commit 52ccf8a6 2026-06-18) dropped baseDomain
  # from loop-runtime-tenant-operator schema — the binary never reads BASE_DOMAIN.
  # Schema enforces additionalProperties:false at /config; passing it makes
  # helmfile sync FAIL. Cleanroom catch 2026-06-19. Same stale-helper-post-
  # architecture-refactor class as issue #91.
  argocdNamespace: argocd
  # workloadClusterUrl populated by wire-clusters.sh post-bootstrap; leaving
  # blank lets the operator discover via in-cluster ClusterCredential.
  ingressNamespace: traefik
  # Tenant-internal TLS uses the selfsigned-issuer declared in the env;
  # tenant operator skipping its verification is consistent with that design.
  # Slice 4 commit 52ccf8a6 renamed insecureSkipTls → operatorInsecureSkipTls
  # at the schema level (hardened root additionalProperties:false).
  operatorInsecureSkipTls: "true"

secrets:
  # Chart would emit an empty GITEA_TOKEN if create=true. Instead we use
  # the externally-provisioned `loop-runtime-tenant-operator` Secret created by
  # generate-secrets.sh (which propagates the canonical gitea-token from
  # loop-runtime-api-tokens). See T3.1 of plan 2026-06-04-dev-public-docr-fix-forward.
  create: false
  existingSecret: loop-runtime-tenant-operator

kubeconfig:
  build:
    existingConfigMap: loop-runtime-build-kubeconfig
  cell0:
    existingConfigMap: loop-runtime-cell-0-kubeconfig
