# T1.6 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2.
#
# Canonical declarative ory-kratos cookie + allowed_return_urls contract for
# dev-public env per ADR D1 + D8. Closes J-04 recovery + J-05 device-flow
# cross-subdomain session continuity gaps.
#
# Per ADR D8 contract for dev-public:
#   - cookieDomain: loopzero.example (eTLD+1 — apex shared by auth-dev / app-dev /
#     cloud-dev subdomains; ensures session cookie survives redirect chain)
#   - allowed_return_urls: enumerate canonical post-auth redirect targets
#     (Kratos rejects any return_to= query param NOT in this allowlist —
#     OWASP A01 open-redirect protection)

kratos:
  config:
    session:
      cookie:
        # Plan T1.6: eTLD+1 cookie shared across auth-dev/app-dev/cloud-dev.
        domain: loopzero.example
        same_site: Lax

    selfservice:
      allowed_return_urls:
        - https://app-dev.loopzero.example
        - https://app-dev.loopzero.example/
        - https://cloud-dev.loopzero.example
        - https://cloud-dev.loopzero.example/
        - https://auth-dev.loopzero.example
