# dev-public overlay for charts/loopruntime-cloud, layered on charts/loopruntime-cloud/values-bootstrap.yaml.

# The edge (Caddy) runs on the host and must reach loopruntime-cloud. Until 2026-08-10 it did
# that through `kubectl port-forward`, which is a debugging tool, not a transport: the
# systemd unit watching it recorded NRestarts=126499 — ~1.8 restarts per minute — and
# every restart is a 502 window on `/engine/*`, which carries deploy, whoami, project
# listing and build status.
#
# NodePort is the pattern the sibling `loopruntime-api` already uses and never had that problem
# with, because the k3d serverlb publishes the port through an ordinary docker mapping.
# 30002 was chosen because `docker port k3d-loopruntime-core-serverlb` already publishes it as
# host 3002 and it was free; a NodePort the serverlb does not publish renders the same
# and stays unreachable from the host.
service:
  type: NodePort
  nodePort: 30002

# Until 2026-09-28 this environment pulled `:develop` from GHCR (issue #104), with an
# overridable prefix added after an expired pull token held 13 pods in ImagePullBackOff
# (B-016). A moving tag cannot say which commit is running, and production pulls from
# ECR (#435); loopruntime-cloud's own CI publishes there too.
# Platform images come from Amazon ECR, pinned by the commit each was built from (#435):
# the registry and the tag are `platformImages` in environments/dev-public.yaml, and a
# missing entry fails the render instead of falling back to a moving tag. No pull
# secret: the node's kubelet credential provider authenticates, as on EKS.
global:
  registry: {{ required "platformImages.registry is not set" .Values.platformImages.registry | trimSuffix "/" }}

image:
  repository: loopruntime-cloud
  tag: {{ required "platformImages.tags.loopruntime-cloud is not set" (index .Values.platformImages.tags "loopruntime-cloud") | quote }}
  pullPolicy: IfNotPresent

imagePullSecrets: []

config:
  # Plan J-09 T1.1 (2026-06-05) — GitHub App install handshake. All three must be right
  # or the handshake breaks:
  #   - githubAppSlug: public slug, so the install button redirects to
  #     https://github.com/apps/{slug}/installations/new
  #   - appPublicUrl: dashboard origin the callback returns the browser to
  #   - authCookieDomain: explicit Domain= on the state cookie so it survives the GitHub
  #     redirect across subdomains; getloopscale.com is the apex shared by app-dev/cloud-dev/auth-dev.
  githubAppSlug: "loopruntime-platform"
  # The OAuth client id of this environment's GitHub App, public. It exists per
  # environment only, so the helmfile run supplies it; unset, the connect flow is off.
  githubAppClientId: {{ env "LOOPRUNTIME_GITHUB_APP_CLIENT_ID" | quote }}
  appPublicUrl: "https://app-dev.getloopscale.com"
  authCookieDomain: "getloopscale.com"

  # T1.2 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2. The public and
  # internal Kratos URLs are split (ADR D8): the public HTTPS FQDN for browser-facing
  # redirects, the cluster-internal one for server-side calls. The public one is set by
  # the release from the environment's publicAuthUrl (core.helmfile.yaml.gotmpl).
  #
  # CANONICAL FIX 2026-06-15: the internal URL is `ory-kratos-public` on port 80, the
  # service the Ory chart creates; server-side cookie verification uses the PUBLIC API
  # (/sessions/whoami), so the internal URL points at ory-kratos-public.
  kratosInternalUrl: "http://ory-kratos-public.loopruntime-auth.svc.cluster.local:80"

  # CANONICAL FIX 2026-07-14 (2nd regression of loopruntime-cloud#131): the issuer MUST be
  # byte-equal to what Hydra emits in `iss`. Hydra's URLS_SELF_ISSUER carries a trailing
  # slash, and go-jwt.WithIssuer compares exactly — dropping the slash broke the CLI
  # device flow. Changes in lockstep with the loopruntime-api overlay and the ory-hydra overlay.
  jwtIssuer: "https://auth-dev.getloopscale.com/"

  # Without RAG_BASE_URL the loopruntime-rag broker stays nil and `/v1/dashboard/rag/*` returns
  # 404. A data-plane service that runs on this cluster (`dataPlane.services`, #446) is
  # reached by Service name; one not moved yet, where its compose container publishes it on
  # the host. The host address drifted twice — a loose process instead of the pipeline
  # artifact, then :8787, a port the host never published — and a Service name cannot
  # point at the wrong instance.
  #
  # Memory joins them for the edge (#470): THEMORY_BASE_URL is what registers loopruntime-cloud's
  # /internal/authz/forward, the authoriser the edge asks before /v1/memory/* reaches the
  # service. It has no compose fallback — the compose memory was never reached from here.
{{- $dataPlane := .Values | get "dataPlane.services" list }}
{{- if has "loopruntime-memory" $dataPlane }}
  memoryBaseUrl: "http://loopruntime-memory.loopruntime-data-plane.svc.cluster.local:8080"
{{- end }}
  ragBaseUrl: {{ ternary "http://loopruntime-rag.loopruntime-data-plane.svc.cluster.local:8787" "http://host.k3d.internal:18082" (has "loopruntime-rag" $dataPlane) | quote }}
  lensBaseUrl: {{ ternary "http://loopruntime-lens.loopruntime-data-plane.svc.cluster.local:4318" "http://host.k3d.internal:18084" (has "loopruntime-lens" $dataPlane) | quote }}

  # 2026-07-31 — status-panel target for loopruntime-traefik-mcp. It points at the process ROOT,
  # not the Traefik `/mcp` edge: that router does not strip the prefix, deliberately, so
  # `http://host.k3d.internal:8092/mcp` lands as /mcp/v1/version and 404s. The panel only
  # reads `GET /v1/version`, auth-exempt by the gateway's contract, so no key.
  traefikMcpBaseUrl: "http://host.k3d.internal:18090"

  # B-033 (2026-08-31) — the cost aggregator reads this at boot; empty, it logs
  # "cost aggregator disabled" and does not start, `cost_counters` stays empty and the
  # api's CostEnforcer degrades to pass-through. Same URL loopruntime-api's readiness poller
  # consumes (dataPlanePoller.prometheusUrl in its dev-public overlay) — change both in
  # lockstep (infra/tests/charts/loopruntime_cloud_dev_public_wiring_test.go).
  prometheusUrl: "http://prometheus-server.monitoring.svc.cluster.local:80"

# The data-plane admin keys (`loopruntime-memory-platform-admin`, `loopruntime-rag-admin-key`,
# `loopruntime-lens-admin-key`) are minted from each service's bootstrap token and written by
# `loopruntime-ops seed data-plane-admin-keys` (#470). The ExternalSecrets this overlay turned on
# from 2026-07-16 never synced: they read `secret/loopruntime/cloud` properties no step writes,
# through a `loopruntime-secrets-secrets` ClusterSecretStore the core cluster does not run
# (measured 2026-09-30: SecretSyncedError on both). Left on, ESO would be a second writer
# for the Secrets the seed owns.
rag:
  externalSecretEnabled: false

lens:
  externalSecretEnabled: false

# dev-public DECLARES that it really charges.
#
# It is the environment serving app-dev.getloopscale.com — the dashboard with plan, price and an
# upgrade button on screen. Declared here, missing billing Secrets stop being an acceptable
# configuration and keep the pod from starting.
#
# Measured 2026-08-11: with a fixed `optional: true`, the dashboard ran 20h without
# `loopruntime-stripe-webhook`, `Running`, with not one event. Every payment event Stripe sent in
# that window was refused for lack of the secret that verifies it — while the boot log said
# "billing enabled".
billing:
  required: true
