# dev-public overlay for charts/loopzero-api, layered on charts/loopzero-api/values-bootstrap.yaml.
# Plan 2026-06-04-dev-public-docr-fix-forward T2.1 (clusterRole=cloud-local).

# CANONICAL 2026-06-22 (closes #142 LIVE deployment gap discovered while shipping #123
# canonical fix qa-dogfood-cleanup-2026-06-21): the loopzero-api image is published to GHCR by
# the AM6 reusable workflow (`loopzero/.github/workflows/build-publish.yml`) on every push to
# develop — the same channel as loopzero-cloud (issue #104 Architecture A). The prior
# `registry.digitalocean.com/loopzero-system/loopzero-api:dev` tag required a local
# `task images:push:platform:dev-public` step that was easy to forget. GHCR `:develop`
# (rolling) is the canonical channel: CI builds and pushes on every push, and
# `pullPolicy: Always` picks up the new digest on `kubectl rollout restart`. The
# `ghcr-pull` imagePullSecret is provisioned from ~/.loopzero/ghcr-pull-token.txt by
# `task images:ghcr:pullsecret`.
#
# The registry prefix is overridable through LOOPZERO_PLATFORM_IMAGE_PREFIX; the default stays
# GHCR, so anyone with a valid token sees no difference. It exists because this environment
# depended WITHOUT ALTERNATIVE on a published image: measured on the app-dev droplet on
# 2026-08-10, with the pull token expired (HTTP 401), 13 pods sat in ImagePullBackOff and the
# platform did not come up — although every one of these images has a Dockerfile in this
# repository and can be built locally (BACKLOG.md B-016).
global:
  registry: {{ env "LOOPZERO_PLATFORM_IMAGE_PREFIX" | default "ghcr.io/getloopscale/" | trimSuffix "/" }}

image:
  repository: loopzero-api
  tag: develop
  pullPolicy: Always

imagePullSecrets:
  - name: ghcr-pull

# The k3d-loopzero-core serverlb maps host port 13001 to node port 30001. Exposing loopzero-api as
# NodePort 30001 lets `curl localhost:13001/api/...` reach the cluster Service directly —
# the canonical path for the CLI and dogfood from the host.
service:
  type: NodePort
  nodePort: 30001

config:
  # CANONICAL FIX 2026-07-02 (Red Team #133): the build workflow's sign-image and
  # attest-image steps must reference the locally imported k3d cosign/syft images, not the
  # DOCR defaults of api/internal/argo/constants.go (which require prod DOCR pull secrets).
  # Without these, the build stalls at sign-image-app with ImagePullBackOff 401.
  loopzeroCosignImage: "k3d-loopzero-registry:5000/loopzero-cosign-signer:v0.1.0"
  loopzeroSyftImage: "k3d-loopzero-registry:5000/loopzero-syft-scanner:v0.1.0"
  # CANONICAL FIX 2026-06-15: the OpenBao Transit chain is on in dev-public. Both halves of
  # the AppRole arrive from Secret `loopzero-openbao-approle`: vault-bootstrap-dev.sh writes the
  # secret_id and `loopzero-ops seed vault-role-id-sync` the role_id, which OpenBao issues anew
  # at every bootstrap and so cannot be a literal here. Without Transit, the dogfood secrets
  # journey would validate its zero-leak property against unencrypted Postgres bytes — a
  # bypass-PASS.
  openbaoTransitEnabled: "true"
  # T1.2 of dev-public-cross-cluster-secrets (issue #111): OpenBao runs in a SEPARATE
  # k3d-loopzero-secrets cluster. EC-2: the URL stays the canonical intra-cluster DNS name so
  # the certificate SAN holds; the core CoreDNS host alias (T2.2) rewrites it to the
  # loopzero-secrets NodePort IP at resolve time. A single-cluster topology resolves the same
  # literal normally — no per-environment split.
  openbaoVaultAddr: "https://openbao.secrets-system.svc.cluster.local:8200"
  # The build cluster's Loki, where the build pipeline logs land: the port the environment
  # publishes on the build serverlb (crossCluster.lokiNodePort), reached through the docker
  # network gateway that host.k3d.internal names in the core CoreDNS. It was the
  # `loki-cross-cluster` seed's Deployment env patch until the value moved here.
  lokiUrl: "http://host.k3d.internal:{{ .Values.crossCluster.lokiNodePort }}"
  # The public Hydra serves the JWKS for JWT verification.
  jwksUrl: "https://auth-dev.loopzero.example/.well-known/jwks.json"
  # CANONICAL FIX 2026-07-14 (2nd regression of loopzero-cloud#131): the issuer MUST be
  # byte-equal to Hydra's URLS_SELF_ISSUER (WITH the trailing slash). go-jwt.WithIssuer
  # compares exactly — dropping the slash broke the CLI device flow on 2026-07-14. Changes
  # in lockstep with the loopzero-cloud overlay and the ory-hydra overlay.
  jwtIssuer: "https://auth-dev.loopzero.example/"
  # BuildKit (in k3d-loopzero-build) pushes tenant images to k3d-loopzero-registry over plain HTTP;
  # the build submitter writes `http = true, insecure = true` for it from this hint.
  registryInsecure: "true"
  # The workload cluster has `loopzero-ca-issuer` (self-signed CA bootstrap) for tenant
  # `*.loopzero.local` hostnames — no public Let's Encrypt for internal domains.
  loopzeroClusterIssuer: "loopzero-ca-issuer"
  # J-23 wildcard preview URL convention: public preview URLs live under the Caddy/CF
  # wildcard root, not the internal base domain. Caddy's `*.preview-dev.loopzero.example` block
  # reverse-proxies <internal-sni>.loopzero.local to Traefik (infra/local/Caddyfile).
  loopzeroPreviewPublicDomain: "preview-dev.loopzero.example"
  # Gitea lives in `loopzero-system`, not the chart default `gitea` namespace.
  giteaUrl: "http://gitea-http.loopzero-system.svc.cluster.local:3000"
  # Admin endpoints are gated by this defense-in-depth flag; without it the admin journeys
  # (B38) get HTTP 404 for every /admin/* call.
  loopzeroAdminApi: "true"
  # Plan J-09 T1.1 (2026-06-06): the GitHub App id is public, so it is a value; the private
  # key is the sensitive half and comes from Secret `loopzero-api-github`. Rotating the App in
  # github.com means updating this value AND the Vault secret in tandem.
  githubAppId: "3319955"
  # J-25 Live URL discoverability (ADR D3 of plan 2026-06-12-dashboard-journey-j25):
  #   baseDomain       = cluster-internal SNI the IngressRoute Host rule matches; Caddy
  #                      rewrites the public Host to <sub>.loopzero.local before Traefik.
  #   loopzeroPublicDomain = wildcard root of the user-facing URL (status.url, dashboard
  #                      "Visit"): https://<tenant>-<project>-<entryApp>-<env>.<root>.
  # Mirrors the preview split above; single source of truth is pkg/naming.AppURL.
  baseDomain: "loopzero.local"
  loopzeroPublicDomain: "prod-dev.loopzero.example"
