# Plan 2026-06-04-dev-public-docr-fix-forward T2.2.
# Minimal override for env dev-public.
# Chart defaults canonical (DOCR + dev tag + IfNotPresent + HA).

global:
# Sobrescrevivel por LOOPZERO_PLATFORM_IMAGE_PREFIX (mesma razao registrada em
# loopzero-api.yaml.gotmpl: o ambiente dependia sem alternativa de imagem publicada, e com o
# token de pull expirado nao havia como reconstruir do zero). O padrao segue o GHCR.
  registry: {{ env "LOOPZERO_PLATFORM_IMAGE_PREFIX" | default "ghcr.io/getloopscale/" | trimSuffix "/" }}
  imagePullSecrets:
    - name: ghcr-pull

image:
  tag: develop
  pullPolicy: Always

config:
  # Chart requires explicit baseDomain (no env-helmfile auto-injection).
  baseDomain: "{{ .Values.domain }}"

# T2.2 of plan dashboard-badge-data-plane-poller (Red Team #128).
# dev-public wires the poller at the cluster-internal Prometheus service.
# The chart auto-adds the Prometheus egress rule when enabled=true —
# no need to duplicate here (see loopzero-common.networkpolicy helper).
dataPlanePoller:
  enabled: true
  pgUrl: "postgresql://loopzero:loopzero-dev-password@postgresql.loopzero-system.svc.cluster.local:5432/loopzero?sslmode=disable"
  prometheusUrl: "http://prometheus-server.monitoring.svc.cluster.local:80"
  interval: "30s"

# dev-public NetworkPolicy override: gitea is in loopzero-system ns (not the
# chart-default `gitea` ns). Same fix as loopzero-tenant-operator. Without
# this, operator egress to gitea API is blocked → reconcile loops fail.
networkPolicy:
  enabled: true
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
      ports:
        - protocol: TCP
          port: 8443
  extraEgress:
    - ports:
        - protocol: TCP
          port: 6443
        - protocol: TCP
          port: 443
    - ports:
        - protocol: TCP
          port: 3000
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: loopzero-system
    - ports:
        - protocol: TCP
          port: 8080
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: argocd
    - ports:
        - protocol: TCP
          port: 9000
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: loopzero-system
