# Plan 2026-06-04-dev-public-docr-fix-forward T2.2.
# Minimal override for env dev-public.
# Chart defaults canonical (DOCR + dev tag + IfNotPresent + HA).

global:
# Sobrescrevivel por LOOPZERO_PLATFORM_IMAGE_PREFIX (mesma razao registrada em
# loopzero-api.yaml.gotmpl: o ambiente dependia sem alternativa de imagem publicada, e com o
# token de pull expirado nao havia como reconstruir do zero). O padrao segue o GHCR.
  registry: {{ env "LOOPZERO_PLATFORM_IMAGE_PREFIX" | default "ghcr.io/getloopscale/" | trimSuffix "/" }}
  imagePullSecrets:
    - name: ghcr-pull

image:
  tag: develop
  pullPolicy: Always

# Slice 4 ISP remediation (commit 52ccf8a6 2026-06-18) dropped baseDomain
# from loopzero-platform-operator + loopzero-tenant-operator schemas: the binaries
# never read BASE_DOMAIN (only app + preview do). Schema enforces
# additionalProperties:false at /config so passing baseDomain here makes
# `helmfile sync` FAIL with "additional properties 'baseDomain' not
# allowed". Cleanroom catch 2026-06-19 — same stale-helper-post-
# architecture-refactor class as issue #91. EC-3 transitive Go-deps guard
# in the Slice 4 commit catches the Go binary <-> chart drift but not the
# helmfile env overlay (this file); follow-up PR adds a hermetic helmfile-
# render gate.

# dev-public NetworkPolicy override: gitea is in loopzero-system ns (not the
# chart-default `gitea` ns). Same fix as loopzero-tenant-operator. Without
# this, operator egress to gitea API is blocked → reconcile loops fail.
networkPolicy:
  enabled: true
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
      ports:
        - protocol: TCP
          port: 8443
  extraEgress:
    - ports:
        - protocol: TCP
          port: 6443
        - protocol: TCP
          port: 443
    - ports:
        - protocol: TCP
          port: 3000
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: loopzero-system
    - ports:
        - protocol: TCP
          port: 8080
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: argocd
    - ports:
        - protocol: TCP
          port: 9000
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: loopzero-system
