# dev-public overlay for infra/helm/data-plane-service: loop-runtime-lens (#446).
#
# Same contract as loop-runtime-memory.yaml.gotmpl. The judge is an OpenAI-compatible endpoint
# and uses the same key as the other services.
image:
  repository: {{ required "platformImages.registry is not set" .Values.platformImages.registry }}loop-runtime-lens
  tag: {{ required "platformImages.tags.loop-runtime-lens is not set" (index .Values.platformImages.tags "loop-runtime-lens") | quote }}

port: 4318
healthPath: /v1/healthz
# Host port 18084 (infra/k3d/core-cluster.yaml).
nodePort: 30184
runAsUser: 1000

existingSecret: loop-runtime-lens
env:
  LOOP_RUNTIMELENS_PORT: "4318"
  NODE_ENV: production
  LOOP_RUNTIMELENS_REQUIRE_CREDENTIAL: "true"
  LOOP_RUNTIMELENS_JUDGE_BASE_URL: https://api.openai.com/v1
  DISABLE_ERROR_REPORTING: "1"
secretEnv:
  - { name: LOOP_RUNTIMELENS_JUDGE_API_KEY, key: openai-api-key }
  - { name: LOOP_RUNTIMELENS_PLATFORM_ADMIN_BOOTSTRAP, key: admin-bootstrap-token }

postgres:
  image: mirror.gcr.io/library/postgres:16-alpine@sha256:e013e867e712fec275706a6c51c966f0bb0c93cfa8f51000f85a15f9865a28cb
  database: loopruntimelens
  user: loopruntimelens
  uriEnv: LOOP_RUNTIMELENS_PG_URI
  dataPath: /var/lib/postgresql/data
  pgdata: /var/lib/postgresql/data/pgdata
  storage: 5Gi
  # The alpine image's postgres user.
  runAsUser: 70
