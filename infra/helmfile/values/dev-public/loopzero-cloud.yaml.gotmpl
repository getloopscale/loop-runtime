# CANONICAL 2026-06-19 (issue #104 Architecture A; ADR PROPOSED
# `2026-06-19-loopzero-cloud-image-registry-canonical`). loopzero-cloud images
# are published EXCLUSIVELY to GHCR by the AM6 reusable workflow
# (loopzero/.github/workflows/build-publish.yml). The 2026-06-15 `multi-
# aud-fix` workaround tag against k3d-loopzero-registry:5000 was a one-off
# rebuild that the canonical AM6 CI made obsolete. Every Cleanroom
# destroyed the local k3d registry, so dev-public loopzero-cloud pods
# ImagePullBackOff'd for a tag that no longer existed. Aligning the
# overlay to GHCR `:develop` (rolling) matches where the image actually
# lives. `ghcr-pull` imagePullSecret is provisioned from
# ~/.loopzero/ghcr-pull-token.txt by `task images:ghcr:pullsecret` (NEW —
# sibling SoT of ~/.loopzero/gomod-token.txt per memory
# reference_gomod_token_canonical_path).
image:
  repository: ghcr.io/getloopscale/loopzero-cloud
  tag: develop
  pullPolicy: Always

# GHCR pull secret — provisioned by `task images:ghcr:pullsecret` from
# ~/.loopzero/ghcr-pull-token.txt. The chart schema requires minItems=1.
imagePullSecrets:
  - name: ghcr-pull

# Plan J-09 T1.1 (2026-06-05) — GitHub App install handshake env vars.
# Merged into the chart's env: map (range $k, $v := .Values.env in
# templates/deployment.yaml). All three must be right or the handshake
# breaks:
#   - GITHUB_APP_SLUG: public slug of the GitHub App so the install
#     button redirects to https://github.com/apps/{slug}/installations/new
#   - APP_PUBLIC_URL: dashboard origin the callback returns the browser
#     to (with installation_id + setup_action preserved in the query).
#   - AUTH_COOKIE_DOMAIN: explicit Domain= on the state cookie so it
#     survives the GitHub redirect across subdomains. loopzero.example is the
#     apex shared by app-dev/cloud-dev/auth-dev.
env:
  GITHUB_APP_SLUG: "loopzero-platform"
  APP_PUBLIC_URL: "https://app-dev.loopzero.example"
  AUTH_COOKIE_DOMAIN: "loopzero.example"

  # T1.2 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2.
  # Closes catch #20 from T6.2 session (memory j05-aprendizado-kratos-public-
  # vs-internal-url-split): loopzero-cloud received Kratos public URL in handlers
  # where INTERNAL was needed (and vice-versa) — J-05 device-flow redirect
  # loops + J-04 cookie domain mismatch. Canonical split per ADR D8:
  #   - KRATOS_PUBLIC_URL: HTTPS public FQDN — used for browser-facing
  #     redirects (consent UI, settings UI links the user clicks)
  #   - KRATOS_INTERNAL_URL: cluster-internal HTTP — used for server-side
  #     admin API calls (CreateIdentity, GetSession, verify cookie)
  KRATOS_PUBLIC_URL: "https://auth-dev.loopzero.example"
  # CANONICAL FIX 2026-06-15 dev-public Cleanroom: service name was wrong
  # (referenced "kratos" but ory-kratos chart creates `ory-kratos-public`
  # service on port 80, NOT `kratos` on 4433). LIVE diagnosis showed
  # loopzero-cloud /v1/auth/session/token returned 502 AUTH_SERVICE_UNAVAILABLE
  # because DNS lookup failed. Canonical Ory chart service convention:
  #   - ory-kratos-public (port 80): self-service flows + whoami + verify
  #   - ory-kratos-admin (port 80): CreateIdentity + ListIdentities
  # loopzero-cloud server-side cookie verification uses the PUBLIC API
  # (/sessions/whoami), so INTERNAL_URL → ory-kratos-public.
  KRATOS_INTERNAL_URL: "http://ory-kratos-public.loopzero-auth.svc.cluster.local:80"

  # CANONICAL FIX 2026-06-15 dev-public LIVE auth chain: JWT_ISSUER MUST
  # match the `iss` claim that Hydra sets at mint time. Hydra in dev-public
  # is configured with `urls.self.issuer = https://auth-dev.loopzero.example/`
  # (per dev-public/ory-hydra.yaml.gotmpl). The loopzero-cloud JWT validator
  # default (`HydraPublicURL + "/"`) yields the internal cluster URL,
  # which mismatches the public-URL iss claim in browser-minted JWTs.
  # Override JWT_ISSUER explicitly so JWT validation accepts public-URL
  # iss (matches what Hydra actually emits). HYDRA_PUBLIC_URL kept as
  # internal for JWKS fetch (faster, no outbound TLS).
  JWT_ISSUER: "https://auth-dev.loopzero.example"
