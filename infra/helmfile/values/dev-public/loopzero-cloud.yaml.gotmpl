# CANONICAL 2026-06-19 (issue #104 Architecture A; ADR PROPOSED
# `2026-06-19-loopzero-cloud-image-registry-canonical`). loopzero-cloud images
# are published EXCLUSIVELY to GHCR by the AM6 reusable workflow
# (loopzero/.github/workflows/build-publish.yml). The 2026-06-15 `multi-
# aud-fix` workaround tag against k3d-loopzero-registry:5000 was a one-off
# rebuild that the canonical AM6 CI made obsolete. Every Cleanroom
# destroyed the local k3d registry, so dev-public loopzero-cloud pods
# ImagePullBackOff'd for a tag that no longer existed. Aligning the
# overlay to GHCR `:develop` (rolling) matches where the image actually
# lives. `ghcr-pull` imagePullSecret is provisioned from
# ~/.loopzero/ghcr-pull-token.txt by `task images:ghcr:pullsecret` (NEW —
# sibling SoT of ~/.loopzero/gomod-token.txt per memory
# reference_gomod_token_canonical_path).
image:
  repository: ghcr.io/getloopscale/loopzero-cloud
  tag: develop
  pullPolicy: Always

# GHCR pull secret — provisioned by `task images:ghcr:pullsecret` from
# ~/.loopzero/ghcr-pull-token.txt. The chart schema requires minItems=1.
imagePullSecrets:
  - name: ghcr-pull

# Plan J-09 T1.1 (2026-06-05) — GitHub App install handshake env vars.
# Merged into the chart's env: map (range $k, $v := .Values.env in
# templates/deployment.yaml). All three must be right or the handshake
# breaks:
#   - GITHUB_APP_SLUG: public slug of the GitHub App so the install
#     button redirects to https://github.com/apps/{slug}/installations/new
#   - APP_PUBLIC_URL: dashboard origin the callback returns the browser
#     to (with installation_id + setup_action preserved in the query).
#   - AUTH_COOKIE_DOMAIN: explicit Domain= on the state cookie so it
#     survives the GitHub redirect across subdomains. loopzero.example is the
#     apex shared by app-dev/cloud-dev/auth-dev.
env:
  GITHUB_APP_SLUG: "loopzero-platform"
  APP_PUBLIC_URL: "https://app-dev.loopzero.example"
  AUTH_COOKIE_DOMAIN: "loopzero.example"

  # T1.2 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2.
  # Closes catch #20 from T6.2 session (memory j05-aprendizado-kratos-public-
  # vs-internal-url-split): loopzero-cloud received Kratos public URL in handlers
  # where INTERNAL was needed (and vice-versa) — J-05 device-flow redirect
  # loops + J-04 cookie domain mismatch. Canonical split per ADR D8:
  #   - KRATOS_PUBLIC_URL: HTTPS public FQDN — used for browser-facing
  #     redirects (consent UI, settings UI links the user clicks)
  #   - KRATOS_INTERNAL_URL: cluster-internal HTTP — used for server-side
  #     admin API calls (CreateIdentity, GetSession, verify cookie)
  KRATOS_PUBLIC_URL: "https://auth-dev.loopzero.example"
  # CANONICAL FIX 2026-06-15 dev-public Cleanroom: service name was wrong
  # (referenced "kratos" but ory-kratos chart creates `ory-kratos-public`
  # service on port 80, NOT `kratos` on 4433). LIVE diagnosis showed
  # loopzero-cloud /v1/auth/session/token returned 502 AUTH_SERVICE_UNAVAILABLE
  # because DNS lookup failed. Canonical Ory chart service convention:
  #   - ory-kratos-public (port 80): self-service flows + whoami + verify
  #   - ory-kratos-admin (port 80): CreateIdentity + ListIdentities
  # loopzero-cloud server-side cookie verification uses the PUBLIC API
  # (/sessions/whoami), so INTERNAL_URL → ory-kratos-public.
  KRATOS_INTERNAL_URL: "http://ory-kratos-public.loopzero-auth.svc.cluster.local:80"

  # CANONICAL FIX 2026-07-14 (2nd regression of loopzero-cloud#131): JWT_ISSUER
  # MUST be byte-equal to what Hydra actually emits (`iss` claim). Hydra's
  # `URLS_SELF_ISSUER=https://auth-dev.loopzero.example/` (WITH trailing slash)
  # is mirrored verbatim into JWT.iss, and `go-jwt.WithIssuer(...)` does
  # exact-string comparison — no normalization. The trailing slash is
  # non-negotiable: dropping it broke Red Team CLI device-flow 2026-07-14.
  # If Hydra's URLS_SELF_ISSUER changes shape, this MUST change in lockstep
  # (loopzero-cloud + loopzero-api overlays both). HYDRA_PUBLIC_URL kept as
  # internal for JWKS fetch (faster, no outbound TLS).
  JWT_ISSUER: "https://auth-dev.loopzero.example/"

  # T1 CANONICAL 2026-07-16 (DELEGATION-M7-rag-ui.md): supersedes the volatile
  # `kubectl set env deployment/loopzero-cloud RAG_BASE_URL=...` applied 2026-07-15.
  # Without RAG_BASE_URL the loopzero-rag broker in cmd/main.go stays nil and the
  # `mountRagDashboard(...)` call at cmd/main.go:998 is skipped, so
  # `/v1/dashboard/rag/*` returns 404 (breaks app-dev.loopzero.example/rag/analytics).
  # `host.k3d.internal` is the k3d hostAlias that resolves to the host running
  # loopzero-rag on :18082 (per dev-public data-plane topology: loopzero-rag runs as a
  # host process outside the k3d cluster; per DELEGATION brief § Repos § loopzero-rag).
  # Companion Secret loopzero-rag-admin-key provides RAG_PLATFORM_ADMIN_KEY (see
  # infra/helm/loopzero-cloud/templates/deployment.yaml env block).
  RAG_BASE_URL: "http://host.k3d.internal:18082"

  # 2026-07-20 — same durable-wiring contract as RAG above, for loopzero-lens.
  # Without LENS_BASE_URL the loopzero-lens Model-B broker in cmd/main.go stays nil
  # and the read-only (M41) + management (M44) `/v1/dashboard/lens/*` BFF routes
  # are skipped, so the dashboard lens surface (app-dev.loopzero.example/lens) breaks.
  # `host.k3d.internal` resolves to the host running loopzero-lens on :18084 (per
  # dev-public data-plane topology: loopzero-lens runs as a host process outside the
  # k3d cluster — dev-credentials data_plane.lens.host_port). Companion Secret
  # loopzero-lens-admin-key provides LENS_PLATFORM_ADMIN_KEY (deployment.yaml env block).
  LENS_BASE_URL: "http://host.k3d.internal:18084"

# T2 CANONICAL 2026-07-16 (DELEGATION-M7-rag-ui.md § T2). Enable the
# ExternalSecret that materializes k8s Secret `loopzero-rag-admin-key` from
# OpenBao path `secret/loopzero/cloud` property `rag_platform_admin_key` via
# the existing `loopzero-vault-secrets` ClusterSecretStore. Chart template gates
# on `.Values.rag.externalSecretEnabled` (default false in
# infra/helm/loopzero-cloud/values.yaml). Rotation runbook: mint new key on
# loopzero-rag → `bao kv patch secret/loopzero/cloud rag_platform_admin_key=<new>`
# → ESO refresh within 1h → `kubectl rollout restart deployment/loopzero-cloud`
# → revoke old key via DELETE /v1/admin/keys/{id}.
rag:
  externalSecretEnabled: true

# 2026-07-20 — loopzero-lens equivalent of the rag block above. Enables the
# ExternalSecret that materializes k8s Secret `loopzero-lens-admin-key` from OpenBao
# path `secret/loopzero/cloud` property `lens_platform_admin_key` via the same
# `loopzero-vault-secrets` ClusterSecretStore. Chart template gates on
# `.Values.lens.externalSecretEnabled` (default false in
# infra/helm/loopzero-cloud/values.yaml). Rotation runbook: mint new key on
# loopzero-lens → `bao kv patch secret/loopzero/cloud lens_platform_admin_key=<new>`
# → ESO refresh within 1h → `kubectl rollout restart deployment/loopzero-cloud`
# → revoke old key via loopzero-lens DELETE /v1/admin/keys/{id}.
lens:
  externalSecretEnabled: true
