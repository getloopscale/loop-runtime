# dev-public overlay for charts/loopzero-cloud, layered on charts/loopzero-cloud/values-bootstrap.yaml.

# The edge (Caddy) runs on the host and must reach loopzero-cloud. Until 2026-08-10 it did
# that through `kubectl port-forward`, which is a debugging tool, not a transport: the
# systemd unit watching it recorded NRestarts=126499 — ~1.8 restarts per minute — and
# every restart is a 502 window on `/engine/*`, which carries deploy, whoami, project
# listing and build status.
#
# NodePort is the pattern the sibling `loopzero-api` already uses and never had that problem
# with, because the k3d serverlb publishes the port through an ordinary docker mapping.
# 30002 was chosen because `docker port k3d-loopzero-core-serverlb` already publishes it as
# host 3002 and it was free; a NodePort the serverlb does not publish renders the same
# and stays unreachable from the host.
service:
  type: NodePort
  nodePort: 30002

# CANONICAL 2026-06-19 (issue #104 Architecture A; ADR PROPOSED
# `2026-06-19-loopzero-cloud-image-registry-canonical`). loopzero-cloud images are published
# EXCLUSIVELY to GHCR by the AM6 reusable workflow (loopzero/.github/workflows/build-publish.yml).
# `ghcr-pull` imagePullSecret is provisioned from ~/.loopzero/ghcr-pull-token.txt by
# `task images:ghcr:pullsecret`.
#
# The registry prefix is overridable through LOOPZERO_PLATFORM_IMAGE_PREFIX; the default stays
# GHCR, so anyone with a valid token sees no difference. It exists because this environment
# depended WITHOUT ALTERNATIVE on a published image: measured on the app-dev droplet on
# 2026-08-10, with the pull token expired (HTTP 401), 13 pods sat in ImagePullBackOff and the
# platform did not come up — although every one of these images has a Dockerfile in this
# repository and can be built locally (BACKLOG.md B-016).
global:
  registry: {{ env "LOOPZERO_PLATFORM_IMAGE_PREFIX" | default "ghcr.io/getloopscale/" | trimSuffix "/" }}

image:
  repository: loopzero-cloud
  tag: develop
  pullPolicy: Always

imagePullSecrets:
  - name: ghcr-pull

config:
  # Plan J-09 T1.1 (2026-06-05) — GitHub App install handshake. All three must be right
  # or the handshake breaks:
  #   - githubAppSlug: public slug, so the install button redirects to
  #     https://github.com/apps/{slug}/installations/new
  #   - appPublicUrl: dashboard origin the callback returns the browser to
  #   - authCookieDomain: explicit Domain= on the state cookie so it survives the GitHub
  #     redirect across subdomains; loopzero.example is the apex shared by app-dev/cloud-dev/auth-dev.
  githubAppSlug: "loopzero-platform"
  appPublicUrl: "https://app-dev.loopzero.example"
  authCookieDomain: "loopzero.example"

  # T1.2 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2. The public and
  # internal Kratos URLs are split (ADR D8): the public HTTPS FQDN for browser-facing
  # redirects, the cluster-internal one for server-side calls. The public one is set by
  # the release from the environment's publicAuthUrl (core.helmfile.yaml.gotmpl).
  #
  # CANONICAL FIX 2026-06-15: the internal URL is `ory-kratos-public` on port 80, the
  # service the Ory chart creates; server-side cookie verification uses the PUBLIC API
  # (/sessions/whoami), so the internal URL points at ory-kratos-public.
  kratosInternalUrl: "http://ory-kratos-public.loopzero-auth.svc.cluster.local:80"

  # CANONICAL FIX 2026-07-14 (2nd regression of loopzero-cloud#131): the issuer MUST be
  # byte-equal to what Hydra emits in `iss`. Hydra's URLS_SELF_ISSUER carries a trailing
  # slash, and go-jwt.WithIssuer compares exactly — dropping the slash broke the CLI
  # device flow. Changes in lockstep with the loopzero-api overlay and the ory-hydra overlay.
  jwtIssuer: "https://auth-dev.loopzero.example/"

  # T1 CANONICAL 2026-07-16: without RAG_BASE_URL the loopzero-rag broker stays nil and
  # `/v1/dashboard/rag/*` returns 404 (app-dev.loopzero.example/rag/analytics).
  # `host.k3d.internal` is the k3d hostAlias that resolves to the host.
  #
  # 2026-07-29 — THE PORT MOVED FROM :18082 TO :8787, and the reason matters more than
  # the move. When this value was fixed (2026-07-16) loopzero-rag ran ONLY as a host process
  # started by hand. Two now coexist:
  #
  #   :18082  a loose `node` process on the host — version "dev", built_at "unknown"
  #   :8787   container ghcr.io/getloopscale/loopzero-rag:develop — the PIPELINE ARTIFACT
  #
  # The gateway was reading the loose process. The page was right; the TARGET was the
  # wrong instance — and nothing went red, because a loose process answers 200 the same.
  ragBaseUrl: "http://host.k3d.internal:8787"

  # 2026-07-20 — same durable-wiring contract as RAG, for loopzero-lens, which runs as a host
  # process on :18084 in the dev-public data-plane topology.
  lensBaseUrl: "http://host.k3d.internal:18084"

  # 2026-07-31 — status-panel target for loopzero-traefik-mcp. It points at the process ROOT,
  # not the Traefik `/mcp` edge: that router does not strip the prefix, deliberately, so
  # `http://host.k3d.internal:8092/mcp` lands as /mcp/v1/version and 404s. The panel only
  # reads `GET /v1/version`, auth-exempt by the gateway's contract, so no key.
  traefikMcpBaseUrl: "http://host.k3d.internal:18090"

  # B-033 (2026-08-31) — the cost aggregator reads this at boot; empty, it logs
  # "cost aggregator disabled" and does not start, `cost_counters` stays empty and the
  # api's CostEnforcer degrades to pass-through. Same URL loopzero-api's readiness poller
  # consumes (dataPlanePoller.prometheusUrl in its dev-public overlay) — change both in
  # lockstep (infra/tests/charts/loopzero_cloud_dev_public_wiring_test.go).
  prometheusUrl: "http://prometheus-server.monitoring.svc.cluster.local:80"

# T2 CANONICAL 2026-07-16: materialise Secret `loopzero-rag-admin-key` from OpenBao
# `secret/loopzero/cloud` property `rag_platform_admin_key` through the `loopzero-secrets-secrets`
# ClusterSecretStore.
rag:
  externalSecretEnabled: true

# 2026-07-20 — the loopzero-lens equivalent: Secret `loopzero-lens-admin-key` from property
# `lens_platform_admin_key`.
lens:
  externalSecretEnabled: true

# dev-public DECLARES that it really charges.
#
# It is the environment serving app-dev.loopzero.example — the dashboard with plan, price and an
# upgrade button on screen. Declared here, missing billing Secrets stop being an acceptable
# configuration and keep the pod from starting.
#
# Measured 2026-08-11: with a fixed `optional: true`, the dashboard ran 20h without
# `loopzero-stripe-webhook`, `Running`, with not one event. Every payment event Stripe sent in
# that window was refused for lack of the secret that verifies it — while the boot log said
# "billing enabled".
billing:
  required: true
