# T1.1 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2.
#
# Canonical declarative ory-hydra URL contract for dev-public env per ADR D1
# + D8. Closes catches #14/#15/#16 from T6.2 session (memory
# reference_t62_cleanroom_session_2026_06_11 + j05-aprendizado-hydra-urls-
# canonical-via-helmfile-overlay): chart-default template logic that
# computes URLs from `.Values.publicAuthUrl` works for `urls.self.public`
# but leaves the OTHER `urls.*` (device verification, device success,
# login, consent, logout) implicit. Cleanroom destroys runtime patches
# applied to fix those — only this declarative overlay survives.
#
# Per-env contract:
#   - dev-public hosts: auth-dev / app-dev / cloud-dev . getloopscale.com
#   - issuer/public point at auth-dev (Hydra's own FQDN)
#   - device.verification + device.success point at app-dev (dashboard UI)
#     because Hydra's built-in /oauth2/fallbacks/device is literally the
#     "config missing" error page in Hydra v2.6 (caught LIVE 2026-06-05)
#   - login/consent point at cloud-dev (cloud consent handler — Hydra
#     redirects with login_challenge/consent_challenge; only the cloud
#     handler knows how to call Hydra admin AcceptLogin/AcceptConsent)
#
# Validated by: infra/tests/helm/ory-hydra-canonical-urls_test.sh (T3.1).
#
# === v3.0 addition (2026-06-24) — loopzero-cloud#14 CSRF cookie Secure attribute fix ===
#
# Per blueprint hydra-v26-upgrade-canonical (SHIPPABLE_WITH_CAVEATS 89.0) Q2:
# the CSRF cookie Secure attribute is controlled by Hydra's IsDevelopmentMode
# (driver/config/provider.go:CookieSecure). When dev=false, CookieSecure returns
# `true` UNCONDITIONALLY regardless of serve.cookies.secure — activating the
# production-mode-always-Secure cookie semantic that closes loopzero-cloud#14
# (browsers reject SameSite=None without Secure per RFC 6265bis-12 §5.4.7).
#
# dev-public is production-shaped (HTTPS issuer via Caddy + Let's Encrypt prod
# certs, real public DNS auth-dev.getloopscale.com), so dev mode MUST be off here.
# Standalone-multi (local k3d) keeps chart-default dev:true for HTTP issuer.
#
# Per ADR knowledge-base/decisions/2026-06-24-hydra-v2-3-0-sql-injection-allowlist.md
# Path B b1 (cookie fix ships isolated on v2.3.0; v26.2.0 upgrade queued as
# follow-up slice; HIGH CVE GHSA-r9w3-57w2-gch2 risk-accepted with sunset
# 2026-09-22 per rules/deps-audit-allowlist.txt).
#
# Validated by: infra/tests/helm/ory-hydra-cookie-secure-attribute_test.sh (T1.2)
#               + e2e/dev-public-device-flow_test.sh Scenario E (LIVE Set-Cookie probe).

hydra:
  # Production-mode cookie posture (loopzero-cloud#14 fix). DO NOT FLIP TO true
  # without reverting the ADR + CHANGELOG security entry.
  dev: false

  config:
    # v3.1 addition (2026-07-02) — CSRF cookie canonical config for dev-public
    # cross-subdomain OAuth2 flows. Without these, the device flow surfaces
    # "request_forbidden — CSRF value from token does not match CSRF value
    # from data store" mid-flow because default cookie domain is the exact
    # host, blocking cross-subdomain state propagation between /oauth2/*
    # (auth-dev) and the login/consent handlers (app-dev).
    #
    # LIVE-caught 2026-07-02 when Red Team tester ran loopzero login --device-flow
    # and got CSRF forbidden on the verification page. Fixed inline; overlay
    # updated so future Cleanrooms preserve the config.
    serve:
      cookies:
        # getloopscale.com covers auth-dev + app-dev + cloud-dev subdomains.
        domain: "getloopscale.com"
        # Lax allows OAuth2 top-level GET/POST redirects while blocking
        # cross-site iframes; canonical for the device flow chain.
        same_site_mode: "Lax"
        # dev-public is HTTPS-only via Caddy — SameSite=Lax over HTTPS
        # requires Secure per RFC 6265bis-12 §5.4.7.
        secure: true
      public:
        cors:
          allowed_origins:
            - "https://app-dev.getloopscale.com"
            - "https://auth-dev.getloopscale.com"
            - "https://cloud-dev.getloopscale.com"

    urls:
      self:
        issuer: "https://auth-dev.getloopscale.com/"
        public: "https://auth-dev.getloopscale.com/"

      # device-flow URLs — per memory j05-aprendizado-hydra-urls-canonical-via-helmfile-overlay
      # + reference_hydra_v2_device_flow_complete_chain_2026_06_05.
      # `urls.device.verification` is where Hydra redirects the user-agent
      # AFTER the device_code is issued; MUST be a dashboard page that
      # accepts user_code input + calls Hydra admin AcceptUserCodeRequest.
      # `urls.device.success` is shown post-accept.
      device:
        verification: "https://app-dev.getloopscale.com/device-verify"
        success: "https://app-dev.getloopscale.com/device-success"

      # OAuth2 consent + login redirect URLs.
      # Per qa-dogfood-cleanup-2026-06-21 refactor: canonical surface is
      # app-dev.getloopscale.com (cloud-dev.getloopscale.com is 301-redirected to
      # app-dev at the Caddy edge, so bypassing the redirect avoids the
      # CSRF cookie loss during 301 follow). loopzero-cloud BFF handlers live
      # under /auth/* on the app-dev host post-#162 Caddyfile narrowing.
      # Overrides prior J-05 iter 4 amendment (cloud-dev.getloopscale.com/auth/*)
      # which pre-dated the 2026-06-22 Caddy canonical-surface refactor.
      login: "https://app-dev.getloopscale.com/auth/login"
      consent: "https://app-dev.getloopscale.com/auth/consent"
      logout: "https://app-dev.getloopscale.com/logout"
      error: "https://app-dev.getloopscale.com/auth/error"
