# Plan 2026-06-04-dev-public-docr-fix-forward T2.2.
# Minimal override for env dev-public.
# Chart defaults canonical (DOCR + dev tag + IfNotPresent + HA).

# Platform images come from Amazon ECR, pinned by the commit each was built from (#435):
# the registry and the tag are `platformImages` in environments/dev-public.yaml, and a
# missing entry fails the render instead of falling back to a moving tag. No pull
# secret: the node's kubelet credential provider authenticates, as on EKS.
global:
  registry: {{ required "platformImages.registry is not set" .Values.platformImages.registry | trimSuffix "/" }}
  imagePullSecrets: []

image:
  tag: {{ required "platformImages.tags.loop-runtime-platform-operator is not set" (index .Values.platformImages.tags "loop-runtime-platform-operator") | quote }}
  pullPolicy: IfNotPresent

# Slice 4 ISP remediation (commit 52ccf8a6 2026-06-18) dropped baseDomain
# from loop-runtime-platform-operator + loop-runtime-tenant-operator schemas: the binaries
# never read BASE_DOMAIN (only app + preview do). Schema enforces
# additionalProperties:false at /config so passing baseDomain here makes
# `helmfile sync` FAIL with "additional properties 'baseDomain' not
# allowed". Cleanroom catch 2026-06-19 — same stale-helper-post-
# architecture-refactor class as issue #91. EC-3 transitive Go-deps guard
# in the Slice 4 commit catches the Go binary <-> chart drift but not the
# helmfile env overlay (this file); follow-up PR adds a hermetic helmfile-
# render gate.

# dev-public NetworkPolicy override: ArgoCD and MinIO egress, which the chart
# default does not carry. Gitea egress is not listed: core.helmfile sets
# networkPolicy.giteaNamespace to where it installs Gitea.
networkPolicy:
  enabled: true
  ingress:
    - from:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: monitoring
      ports:
        - protocol: TCP
          port: 8443
  extraEgress:
    - ports:
        - protocol: TCP
          port: 6443
        - protocol: TCP
          port: 443
    - ports:
        - protocol: TCP
          port: 8080
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: argocd
    - ports:
        - protocol: TCP
          port: 9000
      to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: loop-runtime-system
