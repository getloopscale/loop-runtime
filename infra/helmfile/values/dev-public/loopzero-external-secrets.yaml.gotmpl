# SPDX-License-Identifier: Apache-2.0
# Iter 25 productive-idle of plan 2026-06-10-j22-openbao-transit-eso-sync v1.2.
#
# Dev-public env overlay for loopzero-external-secrets chart. Wires the
# openbao-transit ClusterSecretStore (T2.4) with canonical defaults
# for cleanroom Open Question Option (c) — OpenBao in mgmt cluster.
#
# Why this exists: without this overlay, operator step 2.3 of the
# cutover runbook required hand-editing chart values + figuring out
# the canonical service URL + role_id placeholder + secretRef shape
# under live-cluster pressure. With this overlay, step 2.3 collapses
# to: `enabled: false → true` here, then `helmfile -e dev-public apply`.
#
# Per docs/operations/openbao-transit-cutover-runbook.md § Step 2.3,
# the flip MUST happen AFTER step 2.1 created the K8s Secret
# `loopzero-openbao-approle` in `external-secrets` ns AND step 1.3
# captured the role_id from `bao read auth/approle/role/loopzero-api/role-id`.
# Flipping BEFORE step 1+2 = ESO authentication failures + Secret
# population stuck.

openbaoTransit:
  # SAFE DEFAULT: stays disabled until operator completes step 1+2 of
  # the runbook. Flip to true only after:
  #   - task k3d:vault:bootstrap-in-mgmt ran (iter 24 shortcut)
  #   - bao operator init + unseal completed (Shamir ceremony)
  #   - helmfile sync --selector name=openbao-init ran (T5.1-T5.9)
  #   - bao auth enable approle ran (runbook step 1.2)
  #   - role_id captured from bao read auth/approle/role/loopzero-api/role-id
  #   - kubectl create secret loopzero-openbao-approle with OPENBAO_VAULT_SECRET_ID
  #     in `external-secrets` namespace
  # When all 6 boxes are ticked, flip this and `helmfile -e dev-public apply`.
  enabled: false

  # In-cluster Kubernetes service DNS for OpenBao under Option (c).
  # Canonical when OpenBao runs in the SAME k3d cluster as loopzero-api +
  # the External Secrets Operator. The service is created by the
  # `openbao` Helm release in vault-system namespace. The 8200 port is
  # the canonical OpenBao listener (per chart values).
  #
  # If sponsor picks Option (a) or (b) instead (cross-cluster), override
  # this URL to the k3d-loopzero-vault-server-0 container DNS + NodePort,
  # OR add an ExternalName Service in external-secrets ns pointing at
  # the cross-cluster endpoint.
  server: "https://openbao.vault-system.svc.cluster.local:8200"

  # AppRole mount path on OpenBao. Default upstream is "approle";
  # leave unchanged unless operator mounted at a custom path during
  # step 1.2 of the runbook.
  authPath: "approle"

  # AppRole role_id — DURABLE identity capturing what loopzero-api is allowed
  # to do (scoped to `loopzero-api-approle` policy per runbook step 1.2 which
  # permits transit/{encrypt,decrypt,keys}/loopzero-tenants/* with create
  # capability for EC-06 self-heal).
  #
  # POPULATE from runbook step 1.3:
  #   ROLE_ID=$(bao read -field=role_id auth/approle/role/loopzero-api/role-id)
  # Then replace this placeholder. role_id is non-sensitive (it's a UUID
  # identifying the role, not authorizing it) — inline OK per
  # feedback_no_hardcode_gate_2026_06_09 (role_id is functionally a
  # public identifier; secret_id is the credential half).
  roleId: ""  # OPERATOR: paste UUID here post-step-1.3

  # Where the AppRole secret_id lives (per
  # feedback_secret_canonical_no_hardcode: sensitive credential MUST
  # come from K8s Secret + valueFrom, NEVER inline literal).
  secretRef:
    # Secret name. Must match what runbook step 2.1 creates.
    name: "loopzero-openbao-approle"
    # ESO reads ClusterSecretStore secretRef from the `external-secrets`
    # namespace by convention (the ESO controller's own namespace where
    # ClusterSecretStore creds live). The runbook step 2.1 currently
    # creates the Secret in `loopzero-system` ns (where loopzero-api also picks
    # it up via envFrom for the TransitClient direct path). Under
    # Option (c), the Secret needs to ALSO exist in `external-secrets`
    # ns for ESO ClusterSecretStore reads.
    #
    # Pattern: same `kubectl create secret generic` step run twice, once
    # per namespace. Or use a single source-of-truth Secret with a
    # cluster-scoped propagator (advanced; deferred to v1 hardening).
    namespace: "external-secrets"
    # Key inside the Secret holding the secret_id bytes.
    key: "OPENBAO_VAULT_SECRET_ID"

  # OpenBao TLS CA bundle. Empty → ESO trusts the K8s system cert
  # pool. Under Option (c), the cert is signed by cert-manager's
  # cluster-issuer (chained from k3s embedded CA). Either:
  #   (i)  inline the issuer's CA bundle here as base64 (more reproducible,
  #        survives k3s restarts but is ~2KB blob in values)
  #   (ii) leave empty + add a ConfigMap-mounted ca.crt to the ESO
  #        controller (cleaner, requires chart support)
  # For iter 25 productive-idle: leave empty + comment the trade-off.
  # Operator decides at flip-time which path matches their CA story.
  caBundle: ""

# ============================================================================
# T1.5 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2.
#
# Canonical declarative ExternalSecret contract closes catches #9 + #10 from
# T6.2 session (memories j09-aprendizado-github-creds-via-eso-canonical +
# j23-aprendizado-webhook-secret-separate-canonical).
#
# Per ADR D8 canonical contract:
#   - ClusterSecretStore: loopzero-vault-secrets (chart base default)
#   - ExternalSecret loopzero-api-github: GitHub App private key + APP_ID
#     (chart base externalSecrets[] entry — atomic rotation semantics)
#   - ExternalSecret loopzero-github-webhook: HMAC webhook secret SEPARATE
#     from loopzero-api-github per J-23 lesson (catch #10).
#
# Why webhook is SEPARATE: webhook delivery handler runs at the cross-tenant
# edge and would mount the GitHub App private key if bundled — defense-in-
# depth says isolate per least-privilege boundary.
# ============================================================================

secretStoreRef:
  kind: ClusterSecretStore
  name: loopzero-vault-secrets

externalSecretsExtra:
  - name: loopzero-github-webhook
    targetSecret: loopzero-github-webhook
    targetNamespace: loopzero-system
    vaultBinary: api
    vaultCategory: secrets
    data:
      - secretKey: value
        vaultKey: github/webhook_secret_v2
