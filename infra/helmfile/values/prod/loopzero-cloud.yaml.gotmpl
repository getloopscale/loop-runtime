# prod overlay for charts/loopzero-cloud, layered on charts/loopzero-cloud/values-bootstrap.yaml.
#
# T1.2 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2 — the canonical
# loopzero-cloud contract for prod per ADR D1 + D8, which splits the Kratos URLs:
#   - prod hosts: auth/app/cloud.getloopscale.com (NO -dev suffix)
#   - the public Kratos URL (HTTPS FQDN, browser redirects) is set by the release from
#     the environment's publicAuthUrl (core.helmfile.yaml.gotmpl)
#   - kratosInternalUrl: cluster-internal HTTP for server-side calls
#
# Regression guard (T3.2): the internal URL must NEVER be https (defeats the split),
# and this overlay must NEVER leak *-dev hostnames into prod.

global:
  registry: registry.digitalocean.com/loopzero-system

image:
  repository: loopzero-cloud
  tag: stable  # loopzero:mutable-tag-allowed (#232 — operator to supply immutable digest; gate covers prod overlays, this is the only non-empty one)
  pullPolicy: IfNotPresent

imagePullSecrets:
  - name: do-registry

config:
  githubAppSlug: "loopzero-platform"
  # The OAuth client id of this environment's GitHub App, public. It exists per
  # environment only, so the helmfile run supplies it; unset, the connect flow is off.
  githubAppClientId: {{ env "LOOPZERO_GITHUB_APP_CLIENT_ID" | quote }}
  appPublicUrl: "https://app.getloopscale.com"
  authCookieDomain: "getloopscale.com"
  kratosInternalUrl: "http://kratos.loopzero-auth.svc.cluster.local:4433"
