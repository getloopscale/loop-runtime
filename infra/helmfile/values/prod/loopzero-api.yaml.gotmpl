# prod overlay for charts/loopzero-api, layered on charts/loopzero-api/values-bootstrap.yaml.

# The internal ALB the cells' External Secrets call the secret-fetch broker through
# (cell.helmfile release loopzero-broker, at LOOPZERO_CORE_API_INTERNAL_URL). Its HTTPS
# listener serves the ACM certificate the environment names in
# LOOPZERO_CORE_API_INTERNAL_CERTIFICATE_ARN; without one the chart refuses to render
# rather than send the broker's bearer token over HTTP.
secretFetchLoadBalancer:
  enabled: {{ .Values.profile.secretFetchBroker }}
  certificateArn: {{ env "LOOPZERO_CORE_API_INTERNAL_CERTIFICATE_ARN" | quote }}
