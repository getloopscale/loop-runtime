# T1.5 of plan 2026-06-11-cleanroom-canonical-5-defense-layers v1.2.
#
# Canonical declarative ExternalSecret contract for prod env per ADR D1 + D8.
# Closes catches #9 + #10 from T6.2 session (memories j09-aprendizado-github-
# creds-via-eso-canonical + j23-aprendizado-webhook-secret-separate-canonical).
#
# Per ADR D8 contract:
#   - ClusterSecretStore: loopruntime-secrets-secrets (chart base default)
#   - ExternalSecret loopruntime-api-github: GitHub App private key + APP_ID
#     (chart base externalSecrets[] entry — atomic rotation semantics)
#   - ExternalSecret loopruntime-github-webhook: HMAC webhook secret SEPARATE
#     per J-23 lesson (catch #10) — webhook handler runs at cross-tenant
#     edge boundary; isolate from app credentials per least-privilege.

secretStoreRef:
  kind: ClusterSecretStore
  name: loopruntime-secrets-secrets

externalSecretsExtra:
  - name: loopruntime-github-webhook
    targetSecret: loopruntime-github-webhook
    targetNamespace: loopruntime-system
    vaultBinary: api
    vaultCategory: secrets
    data:
      - secretKey: value
        vaultKey: github/webhook_secret_v2
