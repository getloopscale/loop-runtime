# Drill environment override for loopzero-platform-operator chart.
# Plan: 2026-05-16-drill-l2-unlock-phase2 — Bug #23 LIVE fix.
#
# Operator chart default: image.repository=loopzero-platform-operator + tag=dev
# (relative repo, used by local k3d via k3d-loopzero-registry). Drill needs
# global.registry + global.imagePullSecrets for DOCR pull.

global:
  registry: registry.digitalocean.com/loopzero-system
  imagePullSecrets:
    - name: loopzero-registry-pull

image:
  repository: loopzero-platform-operator
  tag: '{{ env "LOOPZERO_PLATFORM_OPERATOR_TAG" | default "drill-phase2-ce4e90f0" }}'
  pullPolicy: IfNotPresent

# Bug #25 LIVE fix (2026-05-17 iter 18): operator chart auto-creates
# Secret from .Values.secrets.giteaToken if needed.
secrets:
  create: true
  giteaToken: '{{ env "GITEA_TOKEN_VAL" | default "drill-stub-token" }}'

# Bug #26 LIVE fix (2026-05-17 iter 19): operator requires BUILD_KUBECONFIG +
# RUNTIME_KUBECONFIG env vars. Reference ConfigMaps pre-created by
# drill-helmfile-bootstrap.sh Phase 2.7.
kubeconfig:
  build:
    existingConfigMap: loopzero-build-kubeconfig
  runtime:
    existingConfigMap: loopzero-runtime-kubeconfig

# Bug #28 LIVE fix (2026-05-17 iter 20): operators require BASE_DOMAIN env var
# (from .Values.config.baseDomain). Drill domain matches Pulumi config loopzero-drill:domain.
#
# Slice 4 ISP remediation (commit 52ccf8a6 2026-06-18) dropped baseDomain
# from loopzero-platform-operator schema — the binary never reads BASE_DOMAIN
# (only app + preview do). Schema enforces additionalProperties:false at
# /config so passing baseDomain here makes `helmfile sync` FAIL. Cleanroom
# catch 2026-06-19 (drill overlay drift) — same stale-helper-post-
# architecture-refactor class as issue #91.
