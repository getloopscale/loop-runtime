# Drill environment override for ory-hydra chart.
# Plan: 2026-05-16-drill-l2-unlock-phase2 T3.2 + T3.0 (EC-3 resolution).
#
# Same pattern as values-kratos-drill.yaml.gotmpl — override DSN with
# per-service env var HYDRA_DSN. See kratos override for full rationale.

hydra:
  config:
    # Required env: HYDRA_DSN (set by drill-helmfile-bootstrap.sh).
    # Format: postgres://hydra:PASSWORD@drill-pg-host:25060/hydra?sslmode=require
    dsn: {{ requiredEnv "HYDRA_DSN" | quote }}
    # Plan 2026-05-19-drill-skills-rigor-restoration T2.1 LIVE fix:
    # Default canonical values.yaml has urls.self.issuer="http://localhost:4444/"
    # marked as "LOCAL DEV — production overridden by Pulumi" but Pulumi NEVER
    # overrides (verified via grep across all infra/pulumi*/). Drift caused
    # 11/12 dogfood-drill journeys 401 — JWT.iss claim was "http://localhost:4444/"
    # which couldn't match loop-runtime-api JWT_ISSUER (also unset, see values-loop-runtime-api-drill).
    # Fix: set issuer to internal cluster FQDN that matches what loop-runtime-api validates against.
    # Cross-namespace: Hydra is in loop-runtime-auth, loop-runtime-api in loop-runtime-system — FQDN works.
    urls:
      self:
        issuer: "http://ory-hydra-public.loop-runtime-auth.svc.cluster.local:4444/"
