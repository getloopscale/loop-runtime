# Drill environment override for loop-runtime-preview-operator chart.
# Plan: 2026-05-16-drill-l2-unlock-phase2 — Bug #23 LIVE fix.
#
# Operator chart default: image.repository=loop-runtime-preview-operator + tag=dev
# (relative repo, used by local k3d via k3d-loop-runtime-registry). Drill needs
# global.registry + global.imagePullSecrets for DOCR pull.

global:
  registry: registry.digitalocean.com/loop-runtime-system
  imagePullSecrets:
    - name: loop-runtime-registry-pull

image:
  repository: loop-runtime-preview-operator
  tag: '{{ env "LOOP_RUNTIME_PREVIEW_OPERATOR_TAG" | default "drill-phase2-ce4e90f0" }}'
  pullPolicy: IfNotPresent

# Bug #25 LIVE fix (2026-05-17 iter 18): operator chart auto-creates
# Secret from .Values.secrets.giteaToken if needed.
secrets:
  create: true
  giteaToken: '{{ env "GITEA_TOKEN_VAL" | default "drill-stub-token" }}'

# Bug #26 LIVE fix (2026-05-17 iter 19): operator requires BUILD_KUBECONFIG +
# CELL_0_KUBECONFIG env vars. Reference ConfigMaps pre-created by
# drill-helmfile-bootstrap.sh Phase 2.7.
kubeconfig:
  build:
    existingConfigMap: loop-runtime-build-kubeconfig
  cell0:
    existingConfigMap: loop-runtime-cell-0-kubeconfig

