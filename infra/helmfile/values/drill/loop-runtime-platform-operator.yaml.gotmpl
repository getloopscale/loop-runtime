# Drill environment override for loop-runtime-platform-operator chart.
# Plan: 2026-05-16-drill-l2-unlock-phase2 — Bug #23 LIVE fix.
#
# Operator chart default: image.repository=loop-runtime-platform-operator + tag=dev
# (relative repo, used by local k3d via k3d-loop-runtime-registry). Drill needs
# global.registry + global.imagePullSecrets for DOCR pull.

global:
  registry: registry.digitalocean.com/loop-runtime-system
  imagePullSecrets:
    - name: loop-runtime-registry-pull

image:
  repository: loop-runtime-platform-operator
  tag: '{{ env "LOOP_RUNTIME_PLATFORM_OPERATOR_TAG" | default "drill-phase2-ce4e90f0" }}'
  pullPolicy: IfNotPresent

# No `secrets:` or `kubeconfig:` here: the chart's schema declares neither (the
# platform operator reads no Gitea token and no peer kubeconfig), so setting them
# failed `helmfile -e drill sync` at schema validation.

# Bug #28 LIVE fix (2026-05-17 iter 20): operators require BASE_DOMAIN env var
# (from .Values.config.baseDomain). Drill domain matches Pulumi config loop-runtime-drill:domain.
#
# Slice 4 ISP remediation (commit 52ccf8a6 2026-06-18) dropped baseDomain
# from loop-runtime-platform-operator schema — the binary never reads BASE_DOMAIN
# (only app + preview do). Schema enforces additionalProperties:false at
# /config so passing baseDomain here makes `helmfile sync` FAIL. Cleanroom
# catch 2026-06-19 (drill overlay drift) — same stale-helper-post-
# architecture-refactor class as issue #91.
