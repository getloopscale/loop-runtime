# Vault Cluster — Helmfile (L2 Bootstrap, ISOLATED from mgmt)
#
# VK.4 of sponsor-direct decision 2026-06-02 (vault cluster isolation T3).
# This Helmfile targets the k3d loop-runtime-secrets cluster (or DOKS loop-runtime-secrets-prod
# in future). Lifecycle 100% independent of mgmt cluster — same principle
# as DOxAWS lifecycle independence (per-cloud tooling for different blast
# radius).
#
# BUG8.E LIVE pivot 2026-06-02: ABANDONED Bank-Vaults operator pattern
# (caused bug #8: reconciler reports "vaults openbao not found" with valid
# CR + RBAC + CRD discovery — confirmed in BOTH v1.24.0 AND v1.23.4
# downgrade; not version regression). Pivoted to OFFICIAL openbao-helm chart
# maintained by OpenBao org (LinuxFoundation/OpenSSF). Trade-offs:
#   GAINS: zero operator layer; zero CRD bugs; source canonical; alignment
#          with upstream OpenBao roadmap; simpler lifecycle (Helm direct).
#   LOSSES: BaoConfiguration CR declarative engine/auth config. Will be
#           replaced by init Job that runs `bao secrets enable` +
#           `bao auth enable` post-startup (standard OpenBao pattern).
#
# Releases (3):
#   - cert-manager      — TLS certificates for OpenBao HTTPS
#   - cluster-issuer    — self-signed-issuer ClusterIssuer
#   - openbao           — Official OpenBao chart v0.28.3 (appVersion v2.5.4)
#
# Invocation:
#   helmfile -f infra/helmfile/secrets.helmfile.yaml.gotmpl -e vault-local \
#     --kube-context k3d-loop-runtime-secrets sync
#
# Or via Taskfile:
#   task k3d:secrets:bootstrap

environments:
  vault-local:
    # k3d single-node validation env per VK scope.
    values:
      - environments/vault-local.yaml
  prod:
    # Future: DOKS loop-runtime-secrets-prod (3 nodes, AWS KMS unseal, HA Raft).
    values:
      - environments/prod.yaml
  staging:
    # The staging secrets cluster on the AWS emulator (taskfiles/staging.yml).
    values:
      - environments/staging.yaml

---
helmDefaults:
  # This plane's cluster, declared where the plane lives.
  #
  # Without this line, a `helmfile sync` WITHOUT --kube-context inherits nothing
  # from the file: it uses the ACTIVE kubectl context. Measured against helmfile
  # 1.1.6. That was the defect B-024 paid for elsewhere — a seed operated on the
  # wrong cluster and the error message blamed the missing resource, not the cluster.
  #
  # The flag STILL wins when passed (measured: it overrides silently, with no
  # error). What turns a divergence into a failure is the
  # `helmfile-context-parity` gate, not helmfile. See ADR D1 of slice slice-3.
  kubeContext: k3d-loop-runtime-secrets
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: false
  createNamespace: true

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: openbao
    url: https://openbao.github.io/openbao-helm

releases:
  # ---------------------------------------------------------------------------
  # cert-manager — TLS certs for OpenBao HTTPS API (prod only; vault-local
  # uses TLS-disabled devMode per chart default)
  # ---------------------------------------------------------------------------
  - name: cert-manager
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.15.3
    values:
      - installCRDs: true
      - resources:
          requests:
            cpu: 10m
            memory: 32Mi
          limits:
            cpu: 100m
            memory: 128Mi

  # ---------------------------------------------------------------------------
  # cluster-issuer — self-signed-issuer ClusterIssuer
  # OpenBao chart's server.extraSecretEnvironmentVars can reference TLS
  # certs created by cert-manager (prod env only — vault-local skips TLS).
  # ---------------------------------------------------------------------------
  - name: cluster-issuer
    namespace: cert-manager
    chart: ../helm/cluster-issuer
    needs:
      - cert-manager/cert-manager
    values:
      - issuerKind: selfsigned
      - loopRuntimeCaIssuerName: self-signed-issuer

  # ---------------------------------------------------------------------------
  # openbao-cert — cert-manager Certificate (PRODLIKE.3). Produces Secret
  # `openbao-tls` mounted by openbao chart via extraVolumes. Pre-req for
  # HTTPS listener (replaces tls_disable=1 from previous devMode).
  # ---------------------------------------------------------------------------
  - name: openbao-cert
    namespace: secrets-system
    chart: ../helm/openbao-cert
    installed: {{ .Values | get "openbaoEnabled" false }}
    needs:
      - cert-manager/cluster-issuer

  # ---------------------------------------------------------------------------
  # OpenBao — official chart, deploy direct (no operator).
  # PRODLIKE refactor 2026-06-02: vault-local now uses server.standalone +
  # Raft storage + HTTPS via cert-manager (was devMode + inmem + http).
  # Shamir init is manual (operator-time) post-helm-install.
  # ---------------------------------------------------------------------------
  - name: openbao
    namespace: secrets-system
    chart: openbao/openbao
    version: 0.28.3
    installed: {{ .Values | get "openbaoEnabled" false }}
    needs:
      - cert-manager/cluster-issuer
      - secrets-system/openbao-cert
    values:
      # Common across all envs
      - global:
          enabled: true
          tlsDisable: false  # HTTPS in BOTH local + prod (PRODLIKE.3)
        injector:
          enabled: false  # not using vault-agent sidecar pattern (yet)
        csi:
          enabled: false  # not using CSI driver (yet)
        server:
          enabled: true
          # Logging
          logLevel: "info"
          # Resources for single-node OpenBao server
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: 500m
              memory: 512Mi
          # Liveness/readiness against bao API (gracefully handle Sealed state)
          readinessProbe:
            enabled: true
            # 472 = unsealed; 473 = sealed (we want sealed to NOT mark unready,
            # otherwise Sealed pod is unreachable for unseal API call)
            path: "/v1/sys/health?standbyok=true&sealedcode=204&uninitcode=204"
          livenessProbe:
            enabled: true
            path: "/v1/sys/health?standbyok=true&sealedcode=204&uninitcode=204"
          # Mount openbao-tls Secret (from cert-manager) for HTTPS
          extraVolumes:
            - type: secret
              name: openbao-tls
              path: /openbao/userconfig

      # vault-local: standalone + Raft persistent + HTTPS (PRODLIKE.2)
      # Replaces previous devMode (in-memory, http, auto-unseal). Shamir
      # init is manual operator-time after helm install (see runbook).
      #
      # T2.1 of plan dev-public-cross-cluster-secrets (issue #111) — adds
      # an OPT-IN Transit auto-unseal stanza gated by
      # `.Values.transitAutoUnsealEnabled` (default false; opt-in only).
      # When enabled, the main OpenBao auto-unseals at pod startup against
      # the Transit backend at `.Values.transitAutoUnseal.address` — no
      # Shamir shards on disk (blueprint D2). The Transit backend is
      # ephemeral by design (EC-7) — a restart loses the wrapping key;
      # acceptable in Cleanroom because the stack is re-created each run.
      # No seal-migration code (EC-8) — Cleanroom always fresh-init.
      {{- if eq .Environment.Name "vault-local" }}
      - server:
          dev:
            enabled: false  # NO MORE devMode — proper prod-posture
          # Plan k3d-host-published-vault-reach D1+D4 (sponsor 2026-06-20).
          # Service is published to the host via the k3d serverlb (k3d-proxy
          # nginx stream{} L4 TCP passthrough) at host:8200 → node:30200 →
          # openbao pod, preserving TLS bytes intact (no L7 decode error 562).
          # See `infra/k3d/secrets-cluster.yaml` port mapping
          # `8200:30200@loadbalancer` + `--disable=servicelb`. The nodePort
          # is FIXED at 30200 (D4) so the k3d mapping's backend is
          # deterministic across Cleanrooms; an auto-assigned 31xxx would
          # silently break the serverlb chain (the #112 trap).
          service:
            type: NodePort
            nodePort: 30200
          standalone:
            enabled: true
            # HCL config: HTTPS listener (cert from openbao-tls Secret) +
            # Raft single-node storage (persistent via PVC).
            config: |
              ui = true

              listener "tcp" {
                address     = "[::]:8200"
                cluster_address = "[::]:8201"
                tls_cert_file = "/openbao/userconfig/openbao-tls/tls.crt"
                tls_key_file  = "/openbao/userconfig/openbao-tls/tls.key"
                tls_client_ca_file = "/openbao/userconfig/openbao-tls/ca.crt"
              }

              storage "raft" {
                path = "/openbao/data"
                node_id = "openbao-0"
              }

              {{- if .Values | get "transitAutoUnsealEnabled" false }}
              # T2.1 (issue #111): Transit auto-unseal stanza. Eliminates
              # the Shamir-shards-on-disk custody risk (blueprint D2).
              # EC-3: the Transit backend MUST be reachable BEFORE main
              # OpenBao starts — vault-bootstrap-dev.sh wait_transit_ready
              # enforces. EC-7: backend ephemeral (acceptable in Cleanroom).
              # EC-8: no seal-migration — Cleanroom always fresh-init.
              seal "transit" {
                address         = "{{ .Values | get "transitAutoUnseal.address" "http://openbao-transit.secrets-system.svc.cluster.local:8200" }}"
                token           = "{{ env "OPENBAO_TRANSIT_TOKEN" }}"
                disable_renewal = "false"
                key_name        = "{{ .Values | get "transitAutoUnseal.keyName" "autounseal" }}"
                mount_path      = "{{ .Values | get "transitAutoUnseal.mountPath" "transit/" }}"
                tls_skip_verify = "true"
              }
              {{- end }}

              service_registration "kubernetes" {}

              # Single-node — telemetry minimal
              telemetry {
                disable_hostname = true
              }
          # Data storage PVC (default 10Gi — fits k3d local-path-provisioner)
          dataStorage:
            enabled: true
            size: 10Gi
            mountPath: /openbao/data
            storageClass: null  # cluster default (local-path)
          # F-1 absorption (plan k3d-host-published-vault-reach T1.1,
          # T0.1 SPIKE LIVE-confirmed 2026-06-20): chart-default NetworkPolicy
          # `openbao` only allows ingress from `namespaceSelector: {}` —
          # intra-cluster pod sources. The host-publish topology (serverlb
          # publishes host:8200 → node:30200 NodePort → openbao pod) brings
          # traffic from the host network namespace, OUTSIDE any K8s
          # namespace; the chart policy drops it (connection RST mid TLS
          # Client Hello). Disabling the chart policy is the canonical fix
          # for vault-local (single-env scope; PRODUCTION block below at
          # `eq .Environment.Name "prod"` KEEPS the policy enabled because
          # prod ESO reaches OpenBao via in-cluster Service, never via
          # host-publish). Rule 9 forbids forking the chart to add an
          # explicit 0.0.0.0/0:8200 ingress rule.
          networkPolicy:
            enabled: false
      {{- end }}

      # prod and staging: HA Raft, HTTPS and the awskms auto-unseal, on the dedicated
      # secrets cluster (ADR 2026-11-25 tenant secrets on OpenBao). Staging is production
      # at a smaller scale: one voter instead of three, and the emulator's KMS.
      {{- if has .Environment.Name (list "prod" "staging") }}
      {{- $bao := .Values | get "openbao" dict }}
      {{- $replicas := $bao | get "replicas" 3 | int }}
      - server:
          dev:
            enabled: false
          # The core cluster's loop-runtime-api reaches OpenBao through this NodePort: on the
          # core cluster, Service secrets-system/openbao has no selector and its endpoints
          # are the secrets cluster's nodes (infra/staging/openbao.sh), so the certificate's
          # openbao.secrets-system.svc.cluster.local name holds end to end.
          service:
            type: NodePort
            nodePort: {{ $bao | get "nodePort" 30200 }}
          {{- with .Values | get "aws.accountId" "" }}
          # IRSA: infra-live's identity/secrets-openbao grants this ServiceAccount
          # Encrypt, Decrypt and DescribeKey on the unseal key, and nothing else.
          serviceAccount:
            annotations:
              eks.amazonaws.com/role-arn: {{ printf "arn:aws:iam::%s:role/%s-secrets-openbao" . $.Values.aws.namePrefix | quote }}
          {{- end }}
          ha:
            enabled: true
            replicas: {{ $replicas }}
            disruptionBudget:
              # With one voter, any budget would block every drain of its node.
              enabled: {{ gt $replicas 1 }}
            raft:
              enabled: true
              setNodeId: true
              config: |
                ui = true
                listener "tcp" {
                  tls_disable = 0
                  address = "[::]:8200"
                  cluster_address = "[::]:8201"
                  tls_cert_file = "/openbao/userconfig/openbao-tls/tls.crt"
                  tls_key_file = "/openbao/userconfig/openbao-tls/tls.key"
                }
                storage "raft" {
                  path = "/openbao/data"
                  {{- range $i := until $replicas }}
                  retry_join {
                    leader_api_addr = "https://openbao-{{ $i }}.openbao-internal:8200"
                    leader_ca_cert_file = "/openbao/userconfig/openbao-tls/ca.crt"
                  }
                  {{- end }}
                }
                seal "awskms" {
                  region = "{{ .Values | get "aws.region" "us-east-1" }}"
                  kms_key_id = "{{ requiredEnv "OPENBAO_AWS_KMS_KEY_ID" }}"
                  {{- with .Values | get "emulator.endpoint" "" }}
                  # Staging only: the emulator's KMS, named in the seal rather than left to
                  # whichever endpoint variables the seal's AWS SDK reads.
                  endpoint = "{{ . }}"
                  {{- end }}
                }
                service_registration "kubernetes" {}
          extraEnvironmentVars:
            AWS_REGION: {{ .Values | get "aws.region" "us-east-1" | quote }}
          {{- if .Values | get "emulator.endpoint" "" }}
          # Staging only: OpenBao's AWS SDK for Go v1 sends IRSA's web identity exchange
          # to the public STS endpoint, never to the emulator's, so on the emulator the
          # seal authenticates with an access key of a user limited to the unseal key
          # (infra-live identity/secrets-openbao-seal-user; infra/staging/openbao.sh
          # writes the Secret). The SDK reads these before the web identity token.
          extraSecretEnvironmentVars:
            - envName: AWS_ACCESS_KEY_ID
              secretName: openbao-aws-creds
              secretKey: access_key_id
            - envName: AWS_SECRET_ACCESS_KEY
              secretName: openbao-aws-creds
              secretKey: secret_access_key
          {{- end }}
          priorityClassName: system-cluster-critical
          # The chart's rule admits pods of this cluster; loop-runtime-api on the core cluster
          # arrives from a node address of the shared VPC (openbao.clientCidr).
          networkPolicy:
            enabled: true
            ingress:
              - from:
                  - namespaceSelector: {}
                ports:
                  - port: 8200
                    protocol: TCP
                  - port: 8201
                    protocol: TCP
              - from:
                  - ipBlock:
                      cidr: {{ $bao | get "clientCidr" "10.0.0.0/8" | quote }}
                ports:
                  - port: 8200
                    protocol: TCP
        global:
          tlsDisable: false
      {{- end }}
  # ---------------------------------------------------------------------------
  # openbao-init — INIT.3 post-startup config Job: enables secrets engines,
  # auth methods, policies via `bao` CLI. Idempotent. Substitutes the
  # BaoConfiguration CR declarative pattern (eliminated in BUG8.E pivot).
  #
  # vault-local: root token from server.dev.devRootToken passed inline.
  # prod: operator pre-creates Secret `openbao-init-token` post Shamir
  # ceremony; this release references it via auth.existingSecret.
  # ---------------------------------------------------------------------------
  - name: openbao-init
    namespace: secrets-system
    chart: ../helm/openbao-init
    installed: {{ .Values | get "openbaoEnabled" false }}
    needs:
      - secrets-system/openbao
    values:
      - openbao:
          serviceName: openbao
          serviceNamespace: secrets-system
          port: 8200
        image:
          repository: quay.io/openbao/openbao
          tag: "2.5.4"

      {{- if eq .Environment.Name "vault-local" }}
      # PRODLIKE.6 2026-06-02: vault-local now uses operator-provisioned
      # Secret instead of inline token. Workflow:
      #   1. helmfile sync openbao-cert + openbao (they come up with Sealed=true)
      #   2. bao operator init -key-shares=5 -key-threshold=3 → capture
      #      shards + root token
      #   3. bao operator unseal <key1> <key2> <key3> → Sealed=false
      #   4. kubectl -n secrets-system create secret generic openbao-init-token \
      #        --from-literal=BAO_TOKEN=<root_token>
      #   5. helmfile sync openbao-init (runs init Job against unsealed Vault)
      # See: docs/runbooks.md "PRODLIKE workflow"
      - openbao:
          scheme: https
          # Reuse Secret openbao-tls produced by openbao-cert chart;
          # mounts ca.crt at /etc/openbao/ca/ca.crt and sets BAO_CACERT.
          tlsCASecret: openbao-tls
          tlsCASecretKey: ca.crt
        auth:
          existingSecret: openbao-init-token
          existingSecretKey: BAO_TOKEN
      {{- end }}

      {{- if has .Environment.Name (list "prod" "staging") }}
      - openbao:
          scheme: https
          tlsCASecret: openbao-tls
          tlsCASecretKey: ca.crt
        auth:
          # Operator-provisioned post Shamir init ceremony per
          # docs/runbooks.md.
          existingSecret: openbao-init-token
          existingSecretKey: BAO_TOKEN
      {{- end }}

  # ---------------------------------------------------------------------------
  # Phase 8 D12 of plan 2026-06-02-loop-runtime-api-vault-integration v1.8.
  # openbao-snapshot-agent — Raft snapshot CronJob → DO Spaces (S3-compatible).
  # Opt-in via `snapshotAgentEnabled` env value (default false in vault-local,
  # true in prod). Pre-req: Secret openbao-snapshot-s3-creds in the secrets-system
  # NS (the operator provisions it from ~/.openbao-<env>-resources.env).
  # ---------------------------------------------------------------------------
  - name: openbao-snapshot-agent
    namespace: secrets-system
    chart: ../helm/openbao-snapshot-agent
    installed: {{ .Values | get "snapshotAgentEnabled" false }}
    needs:
      - secrets-system/openbao
      - secrets-system/openbao-init
    values:
      - ../helm/openbao-snapshot-agent/values.yaml
      {{- if eq .Environment.Name "vault-local" }}
      # Vault-local: use MinIO local OR skip (default false in env values).
      - s3:
          host: "localhost:9000"
          bucket: "openbao-snapshots-local"
          uri: "s3://openbao-snapshots-local"
          expireDays: "7"
        schedule: "*/30 * * * *"  # every 30min in local for fast iteration
      {{- end }}
