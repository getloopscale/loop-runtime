# Management Cluster — Helmfile (L2 Bootstrap)
# CHG-2026-04-28-LAYERED-BOOTSTRAP — Phase 2 / T2.1
#
# Replaces `infra/pulumi/src/components/mgmt-bootstrap.ts` and friends.
# Pulumi (L1) provisions the cluster; this Helmfile installs all platform
# components into the management cluster with explicit `needs:` ordering.
#
# Invocation:
#   helmfile -f infra/helmfile/core.helmfile.yaml -e dev sync       # LoopZero Cloud (multi-cluster)
#   helmfile -f infra/helmfile/core.helmfile.yaml -e standalone sync # Self-hosting (single cluster)
#
# Required env vars (injected by `loopzero platform install` from Pulumi outputs):
#   LOOPZERO_DB_HOST, LOOPZERO_DB_PORT, LOOPZERO_DB_NAME, LOOPZERO_DB_USER, LOOPZERO_DB_PASSWORD
#   LOOPZERO_REGISTRY_ENDPOINT, LOOPZERO_REGISTRY_NAME
#   LOOPZERO_BUCKET_NAME, LOOPZERO_BUCKET_ENDPOINT, LOOPZERO_SPACES_KEY, LOOPZERO_SPACES_SECRET
#   LOOPZERO_CF_KV_NAMESPACE, LOOPZERO_CF_TUNNEL_TOKEN

# The environments are declared once, in environments.yaml.
bases:
  - environments.yaml

---
helmDefaults:
  # This plane's cluster, declared where the plane lives.
  #
  # Without this line, a `helmfile sync` WITHOUT --kube-context inherits nothing
  # from the file: it uses the ACTIVE kubectl context. Measured against helmfile
  # 1.1.6. That was the defect B-024 paid for elsewhere — a seed operated on the
  # wrong cluster and the error message blamed the missing resource, not the cluster.
  #
  # The flag STILL wins when passed (measured: it overrides silently, with no
  # error). What turns a divergence into a failure is the
  # `helmfile-context-parity` gate, not helmfile. See ADR D1 of slice slice-3.
  kubeContext: k3d-loopzero-core
  wait: true
  waitForJobs: true
  timeout: 600
  atomic: false  # avoid roll-back loops on transient errors; rely on health gates instead
  createNamespace: true

# ---------------------------------------------------------------------------
# Repository registry (single source of truth for chart sources)
# ---------------------------------------------------------------------------
repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: traefik
    url: https://traefik.github.io/charts
  - name: argo
    url: https://argoproj.github.io/argo-helm
  - name: gitea-charts
    url: https://dl.gitea.com/charts/
  - name: minio
    url: https://charts.min.io/
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
  - name: ory
    url: https://k8s.ory.sh/helm/charts
  - name: nfs-ganesha
    url: https://kubernetes-sigs.github.io/nfs-ganesha-server-and-external-provisioner/
  - name: metrics-server
    url: https://kubernetes-sigs.github.io/metrics-server/
  - name: bitnami
    url: https://charts.bitnami.com/bitnami
  - name: chaos-mesh
    url: https://charts.chaos-mesh.org
  # Iter 44 of plan 2026-06-10-j22-openbao-transit-eso-sync v1.2
  # (Option B per docs/runbooks.md § B1).
  # ESO controller in mgmt cluster enables full T4.1 6/6 LIVE scenarios
  # (B+C+F depend on ESO read-path). Same version as runtime helmfile to
  # prevent cross-cluster drift — locked by
  # infra/tests/check-option-b-eso-deploy-doc_test.sh § E1.
  - name: external-secrets
    url: https://charts.external-secrets.io
  # Plan T7.2 (2026-05-22) — OpenCost adopted for cost attribution per tenant.
  # Materializes Anti-Pattern #8 ("adopt > reinvent"): no Go gate
  # reimplementation; external OpenCost chart adopted as-is.
  - name: opencost
    url: https://opencost.github.io/opencost-helm-chart
  # velero-backup-dr-plan v1.0 / T1.2 — Velero upstream chart for K8s
  # resource backups (BSL on DO Spaces in cloud, MinIO in standalone).
  - name: vmware-tanzu
    url: https://vmware-tanzu.github.io/helm-charts

# ---------------------------------------------------------------------------
# Pre-sync secret generation (called by the CLI orchestrator BEFORE this
# helmfile runs — see `cli/src/commands/platform.ts platformInstall` Step 4).
# Helmfile-level hooks were removed because they ran on every command (list,
# lint, diff) and required cluster connectivity even in offline validation.
# Required Secrets:
#   loopzero-system/{loopzero-db-credentials,gitea-admin,minio-credentials,
#                loopzero-registry-pull}
# Apply once: bash infra/helmfile/scripts/generate-secrets.sh <env> mgmt
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Releases — ordered by sync wave via `needs:`
# ---------------------------------------------------------------------------
{{- /* Where this file installs Gitea, in every environment. Every release that
       talks to Gitea (loopzero-api, the tenant and platform operators) is told from
       here, instead of each environment overlay restating the address and each
       drill or heal patching it into the running objects. */}}
{{- $giteaNamespace := "loopzero-system" }}
{{- $giteaURL := printf "http://gitea-http.%s.svc.cluster.local:3000" $giteaNamespace }}
releases:
  # Wave -3: CRDs and observability foundations (no dependencies)
  - name: cert-manager
    labels:
      profile: dashboard-only
    namespace: cert-manager
    chart: jetstack/cert-manager
    version: v1.14.5
    values:
      - ../helm/cert-manager/values.yaml
    set:
      - name: installCRDs
        value: "true"

  # B26 (CHG-2026-04-28-LAYERED-BOOTSTRAP) — metrics-server is pre-installed
  # by k3d (k3s built-in) and DOKS (managed control plane add-on). The Helm
  # install fails with "invalid ownership metadata" because the cluster
  # already owns those resources (different label scheme). Enable explicitly
  # only on bare-metal/EKS/GKE/AKS where metrics-server is NOT pre-installed.
  # Default: skip (assume cluster provider ships it). Override per-env via
  # `installMetricsServer: true` in the environment values file.
  - name: metrics-server
    namespace: kube-system
    chart: metrics-server/metrics-server
    version: 3.12.1
    installed: {{ .Values | get "installMetricsServer" false }}
    values:
      - ../helm/monitoring/values-metrics-server.yaml

  # B45 (CHG-2026-04-28-LAYERED-BOOTSTRAP) — LoopZero CRDs (10 kinds:
  # Tenant/Environment/LoopZeroApplication/ExposedRoute/PlatformBootstrap/
  # GitRepositoryBinding/ClusterCredential/PreviewEnvironment/AppSecret/
  # ReconciliationReport). Without this release, the 4 split operator
  # binaries (loopzero-{tenant,app,preview,platform}-operator) crash at
  # startup with `no matches for kind ... in version loopzero.io/v1`.
  # Detected on standalone bootstrap 2026-04-28.
  # Wave -3: must run BEFORE controllers register watches.
  # Lifecycle-independent: chart never deletes CRDs
  # (helm.sh/resource-policy: keep) so re-runs are idempotent.
  - name: loopzero-crds
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    chart: ../../charts/loopzero-crds
    values:
      - {}
    # No `needs:` — CRDs are foundational, must install first.

  # Wave -2: Ingress (depends on cert-manager for TLS)
  - name: traefik
    labels:
      profile: dashboard-only
    namespace: traefik
    chart: traefik/traefik
    version: 28.3.0
    needs:
      - cert-manager/cert-manager
    values:
      - ../helm/traefik/values.yaml

  - name: nfs-server-provisioner
    namespace: nfs-system
    chart: nfs-ganesha/nfs-server-provisioner
    version: 1.8.0
    values:
      - ../helm/nfs-server-provisioner/values.yaml
      # B20: per-environment underlying storage class. dev/prod use
      # `do-block-storage` (DOKS default). Standalone leaves empty so
      # the cluster default StorageClass is selected (local-path on k3d).
      - persistence:
          storageClass: {{ .Values | get "underlyingStorageClass" "" | quote }}

  # Wave -1: Stateful core
  # In-cluster PostgreSQL — only for standalone profile (self-hosting).
  # LoopZero Cloud (--provider digitalocean) uses DO Managed PG via Pulumi L1.
  # iter 20: closes gap where standalone customers had no DB unless they
  # brought their own. Now standalone is truly self-contained.
  - name: postgresql
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    chart: bitnami/postgresql
    # B21 (CHG-2026-04-28-LAYERED-BOOTSTRAP) — Bitnami removed chart 16.0.7
    # from the public index in 2025 (only the ~6 most recent versions are
    # kept). Bumped to 18.6.2 (latest stable). Production DO uses managed
    # Postgres 16 — version skew is acceptable because LoopZero schema is
    # forward-compatible (forward-only migrations, see CLAUDE.md Rule).
    version: 18.6.2
    installed: {{ .Values.inClusterPostgres | default false }}
    values:
      - ../helm/postgresql/values.yaml
    # Consume the canonical loopzero-db-credentials secret (minted by
    # generate-secrets.sh BEFORE this sync) so PG initializes the `loopzero` user
    # with the SAME password kratos/hydra/loopzero-api read from that secret.
    # Without this, Bitnami auto-generates a divergent random password →
    # kratos SASL auth fails → helmfile --wait deadlocks. The secret carries
    # both `postgres-password` (admin) and `password` (loopzero user) keys, which
    # are Bitnami's default secretKeys. Fix: finding-2026-05-22-pg-password-divergence.
    set:
      - name: auth.existingSecret
        value: loopzero-db-credentials

  - name: gitea-redis
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    chart: bitnami/redis
    version: 19.6.4
    # Bug #15 LIVE FIX: drill uses DO Managed Valkey (prod ADR-0016 D-6
    # parity, CTO Golden Rule #0). In-cluster bitnami redis remains for
    # standalone/local k3d (no DO managed access). Drill bootstrap exports
    # GITEA_REDIS_HOST/PORT/PASSWORD from Pulumi outputs.
    installed: {{ not .Values.profile.managedRedis }}
    values:
      - ../helm/redis/values.yaml

  - name: gitea
    labels:
      profile: dashboard-only
    namespace: {{ $giteaNamespace }}
    chart: gitea-charts/gitea
    version: 10.6.0
    needs:
{{- if .Values.profile.highAvailability }}
      # B28: NFS RWX storage only required for HA gitea (Cloud profiles with
      # multi-replica). Standalone runs single-replica with local PVC (RWO),
      # which works on any K8s including k3d (no NFS kernel module dep).
      - nfs-system/nfs-server-provisioner
{{- end }}
{{- if not .Values.profile.managedRedis }}
      # Drill uses DO Managed Valkey (Bug #15 fix) — no in-cluster gitea-redis.
      - loopzero-system/gitea-redis
{{- end }}
      # iter 16 audit: explicit needs:traefik because Gitea uses IngressRoute.
      # Without this, helmfile may install gitea before traefik (works by luck
      # via NFS dependency, but fragile).
      - traefik/traefik
{{- if .Values.inClusterPostgres }}
      # B22: gitea backend uses Postgres. In standalone, must wait for in-cluster PG.
      - loopzero-system/postgresql
{{- end }}
    values:
      - ../helm/gitea/values.yaml
      # Layered values per env (Plan v1.2 T2.2 — auto-resolve eliminates inline drill conditional).
      # Non-drill envs have empty stub files; drill overrides DB connection → managed PG.
      - values/{{ .Environment.Name }}/gitea.yaml.gotmpl
      # B28 (CHG-2026-04-28-LAYERED-BOOTSTRAP) — Gitea HA (2 replicas + RWX
      # NFS) is a LoopZero Cloud production posture (CHG-002a). Self-hosting
      # standalone runs single-replica + RWO (no NFS kernel module dep,
      # works on any K8s). HA on a single-cluster deploy adds operational
      # complexity without real availability gain (cluster failure = both
      # replicas die anyway).
{{- if .Values.profile.highAvailability }}
      - ../helm/gitea/values-ha.yaml
{{- end }}

  - name: minio
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    chart: minio/minio
    version: 5.4.0
    values:
      - ../helm/minio/values.yaml
      # B25 (CHG-2026-04-28-LAYERED-BOOTSTRAP) — Distributed mode (4 pods × 4
      # drives EC:2) is a LoopZero Cloud production posture (CHG-002a Phase D).
      # Self-hosting (standalone) runs single-cluster on commodity hardware;
      # forcing 16 minio pods + 200Gi raw storage is anti-Rule-10 and causes
      # post-install hook timeouts on k3d (4 pods × 60s init > 60s helm wait).
      # Distributed only applies to LoopZero Cloud profiles.
{{- if .Values.profile.highAvailability }}
      - ../helm/minio/values-distributed.yaml
{{- end }}
    # MinIO withdrew every binary channel of its community edition (#394): the
    # chart's quay.io/minio defaults can no longer be pulled. Both images are built
    # here from pinned source (infra/images/minio, infra/images/clone-runner).
    #
    # An environment that declares `platformImages` pulls them from that registry,
    # pinned by the commit CI built them from (#435) — the same rule as every other
    # platform image. Otherwise a local registry profile gets the ones `task
    # images:build` pushes, and any other environment takes them from its declared
    # registry prefix. Never the chart's dead default.
    #
    # Inline values rather than `set:` so `helmfile write-values` shows them: the
    # chart is remote, and a network-free test can only read what reaches values.
{{- $platformRegistry := .Values | get "platformImages.registry" "" }}
      - image:
{{- if $platformRegistry }}
          repository: "{{ $platformRegistry }}loopzero-minio"
          tag: {{ index .Values.platformImages.tags "loopzero-minio" | quote }}
{{- else if .Values.profile.localRegistry }}
          repository: "k3d-loopzero-registry:5000/loopzero-minio"
          tag: "RELEASE.2024-12-18T13-15-44Z"
{{- else }}
{{- /* The same rule the platform charts follow: an environment that declares a
       registry prefix pulls from it; one that declares none (standalone self-host)
       gets the bare image name, as loopzero-api's `repository: loopzero-api` does there. */}}
          repository: "{{ .Values | get "registries.docrPrefix" "" }}loopzero-minio"
          tag: "RELEASE.2024-12-18T13-15-44Z"
{{- end }}
        mcImage:
{{- if $platformRegistry }}
          repository: "{{ $platformRegistry }}loopzero-clone-runner"
          tag: {{ index .Values.platformImages.tags "loopzero-clone-runner" | quote }}
{{- else if .Values.profile.localRegistry }}
          repository: "k3d-loopzero-registry:5000/loopzero-clone-runner"
          tag: "v0.1.0"
{{- else }}
          repository: "{{ .Values | get "registries.docrPrefix" "" }}loopzero-clone-runner"
          tag: "v0.1.0"
{{- end }}
{{- if .Values.profile.localObjectStore }}
    # Standalone: pin MinIO root password deterministically. The chart leaves
    # rootPassword empty (fail-fast for prod), which makes the official chart
    # auto-generate a RANDOM password — but loopzero-api (infra/tilt/api-deployment.yaml)
    # and static-assets consume the deterministic loopzero-dev-password. Random vs
    # hardcoded => SOURCE_UPLOAD_FAILED (access denied). Same deterministic-creds
    # pattern as PG (T1.3). rootUser=loopzero-admin comes from values.yaml.
    set:
      - name: rootPassword
        value: "loopzero-dev-password"
{{- end }}

  # velero-backup-dr-plan v1.0 / T1.2 — Velero server (Wave -1, infra
  # backup component). Bucket/region/s3Url come from environment values
  # (T0.2). MinIO bucket pre-created in standalone (EC-4 in minio values).
  # Schedules overlay activated via values-schedules.yaml (T2.1).
  - name: velero
    namespace: velero-system
    chart: ../helm/velero
    needs:
      - cert-manager/cert-manager
{{- if .Values.profile.localObjectStore }}
      # BSL targets in-cluster MinIO. Wait for MinIO up first.
      - loopzero-system/minio
{{- end }}
    values:
      - ../helm/velero/values.yaml
      - ../helm/velero/values-schedules.yaml
    set:
      - name: velero.configuration.backupStorageLocation[0].bucket
        value: {{ .Values.velero.bucket | quote }}
      - name: velero.configuration.backupStorageLocation[0].config.region
        value: {{ .Values.velero.region | quote }}
      - name: velero.configuration.backupStorageLocation[0].config.s3Url
        value: {{ .Values.velero.s3Url | quote }}

  # Wave 0: Platform services
  - name: argocd
    labels:
      profile: dashboard-only
    namespace: argocd
    chart: argo/argo-cd
    version: 7.3.11
    needs:
      - cert-manager/cert-manager
      # iter 16 audit: explicit needs:traefik because ArgoCD UI uses IngressRoute.
      - traefik/traefik
    values:
      - ../helm/argocd/values.yaml

  - name: prometheus
    namespace: monitoring
    chart: prometheus-community/prometheus
    version: 25.27.0
    values:
      - ../helm/monitoring/values-prometheus.yaml
      # Iter 13 LIVE bug fix: drill env override disables alertmanager
      # (no Slack webhook + PagerDuty Secret in drill → CrashLoopBackOff).
      # Layered values per env (T2.2 — empty stub in non-drill envs).
      - values/{{ .Environment.Name }}/prometheus.yaml.gotmpl

  - name: grafana
    namespace: monitoring
    chart: grafana/grafana
    version: 8.5.2
    needs:
      - monitoring/prometheus
    values:
      - ../helm/monitoring/values-grafana.yaml

  # Plan T7.2 (2026-05-22 v1.3) — OpenCost cost attribution per tenant.
  # Adopts external opencost-charts upstream via LoopZero wrapper at
  # infra/helm/opencost/. Per Anti-Pattern #8: NO Go gate reimplementation;
  # tool adopted as-is. Federation-friendly (single mgmt install covers all cells).
  - name: opencost
    namespace: loopzero-system
    chart: ../helm/opencost
    version: 1.0.0
    needs:
      - monitoring/prometheus
    values:
      - ../helm/opencost/values.yaml
      # Layered per-env overrides (placeholder; empty stub in standalone-multi).
      - values/{{ .Environment.Name }}/opencost.yaml.gotmpl

  - name: tempo
    namespace: monitoring
    chart: grafana/tempo
    version: 1.14.0
    values:
      - ../helm/tempo/values.yaml

  - name: otel-collector
    namespace: monitoring
    chart: open-telemetry/opentelemetry-collector
    version: 0.96.0
    needs:
      - monitoring/tempo
    values:
      - ../helm/otel/values.yaml

  - name: blackbox-exporter
    namespace: monitoring
    chart: prometheus-community/prometheus-blackbox-exporter
    version: 9.2.0
    values:
      - ../helm/blackbox-exporter/values.yaml

  # Wave 1: Identity (depends on database via env vars)
  # B22 (CHG-2026-04-28-LAYERED-BOOTSTRAP) — When inClusterPostgres=true
  # (standalone profile), ory-kratos must wait for postgresql release to
  # finish or its automigrate init container will retry forever resolving
  # `postgresql.loopzero-system.svc.cluster.local`. In dev/prod the postgres
  # is external (DO managed), so the `needs:` is conditionally rendered.
  - name: ory-kratos
    labels:
      profile: dashboard-only
    namespace: loopzero-auth
    chart: ory/kratos
    version: 0.61.0
{{- if .Values.inClusterPostgres }}
    needs:
      - loopzero-system/postgresql
{{- end }}
    values:
      - ../helm/ory-kratos/values.yaml.gotmpl
      # Layered values per env (T2.2). Drill env DSN override → managed PG.
      - values/{{ .Environment.Name }}/ory-kratos.yaml.gotmpl

  - name: ory-hydra
    labels:
      profile: dashboard-only
    namespace: loopzero-auth
    chart: ory/hydra
    version: 0.61.0
    needs:
      - loopzero-auth/ory-kratos
    values:
      - ../helm/ory-hydra/values.yaml.gotmpl
      # Layered values per env (T2.2). Drill env DSN override → managed PG.
      - values/{{ .Environment.Name }}/ory-hydra.yaml.gotmpl

  # Wave 2: LoopZero platform
  - name: loopzero-api
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    # The published chart, installed with charts/loopzero-api/values-bootstrap.yaml: there is
    # one loopzero-api chart (docs/decisions.md, "One chart per bootstrap/published pair").
    chart: ../../charts/loopzero-api
    # STANDALONE (local k3d): loopzero-api is owned by `tilt up` (self-contained
    # infra/tilt/api-deployment.yaml + docker_build hash-tagged image). The
    # helmfile chart uses image :latest which is NEVER built locally (only the
    # 5 build-pipeline images are), so installing it here produced a 2-container
    # frankenstein pod (helmfile `loopzero-api` :latest unpullable + tilt `api`) and
    # its --wait deadlocked `task setup` before the build/workload clusters
    # installed. Cloud/dev/prod/drill keep it installed (images from DOCR/CI).
    # See finding-2026-05-22-pg-password-divergence § helmfile<->tilt dual-ownership.
    installed: {{ ne (.Values | get "clusterRole" "dev") "standalone" }}
    # CANONICAL FIX 2026-06-15 dev-public Cleanroom chain-gap closure:
    # `wait: false` overrides the global `wait: true` helmDefault for THIS
    # release only. Reason: loopzero-api requires ClusterCredentials + several
    # Secrets (argocd-refresh-credentials, loopzero-openbao-approle, etc.) that
    # are provisioned by the LATER `task bootstrap:standalone` chain. With
    # the global `wait: true`, helm install timed out at 10min because pod
    # never reached Ready (CrashLoopBackOff on missing deps) BEFORE the
    # chain that creates those deps. With `wait: false`, helm install
    # returns immediately after applying manifests; the pod cycles in
    # CrashLoopBackOff until bootstrap:standalone completes, then
    # self-recovers on next restart cycle. Sponsor "sem WORKAROUNDs"
    # closure of [[feedback_task_setup_chain_gap_helm_timeout]].
    wait: false
    needs:
      - argocd/argocd
      - loopzero-system/gitea
      - loopzero-system/minio
      - loopzero-auth/ory-kratos
    values:
      - ../../charts/loopzero-api/values-bootstrap.yaml
      - config:
          giteaUrl: {{ $giteaURL | quote }}
          # One bucket name for the whole install: loopzero-build-cwts (build.helmfile)
          # clones from the same environment value.
          sourceBucket: {{ .Values | get "sourceBucket" "loopzero-builds" | quote }}
      # Layered values per env (T2.2): image channel, pull secret, per-environment
      # config. MUST be LAST in the values list to win merge precedence.
      - values/{{ .Environment.Name }}/loopzero-api.yaml.gotmpl
    set:
      # Finding 2026-05-12 — wire env-file `replicas.api` to chart
      # `replicaCount`. Before this, the env-file value was orphan config:
      # defined in prod.yaml (=3) + standalone-multi.yaml (=1) but never
      # consumed, leaving loopzero-api at hardcoded 1 replica even in prod.
      # See concepts/operations/finding-2026-05-12-loopzero-api-replica-orphan.md
      - name: replicaCount
        value: "{{ .Values | get "replicas" (dict) | get "api" 1 }}"

  # ADR-0023 / plan v1.1 T1.5 — 4 split operator charts replace the
  # deleted monolith chart `infra/helm/tenant-controller` and the
  # redundant `infra/helm/loopzero-controller` (both pointed at the
  # operators monolith binary built from the deleted `cmd/main.go`).
  #
  # Each chart deploys its own operator binary built from
  # `operators/cmd/{tenant,app,preview,platform}-operator/main.go`,
  # gets its own ServiceAccount + ClusterRole + Lease, and mounts
  # only the env vars its controllers need.
  #
  # Production deployments are still on the legacy monolith image
  # (built from commit b1a8618a or earlier) and are governed by
  # CHG-NNNN-OPERATOR-SPLIT-PROD per ADR-0023 4-stage cutover.
  - name: loopzero-tenant-operator
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    chart: ../../charts/loopzero-tenant-operator
    # STANDALONE: tilt owns operators (infra/tilt/*-operator-deployment.yaml).
    # Same dual-ownership reason as loopzero-api. See finding-2026-05-22-pg-password-divergence.
    installed: {{ ne (.Values | get "clusterRole" "dev") "standalone" }}
    # CANONICAL FIX 2026-06-15 dev-public Cleanroom chain-gap (same family
    # as loopzero-api at line 482): operator requires ClusterCredentials which
    # are provisioned by LATER task bootstrap:standalone. wait: false lets
    # helmfile sync complete; pod self-recovers when deps arrive.
    wait: false
    needs:
      - loopzero-system/loopzero-api
      # B45: LoopZero CRDs must exist before controller-runtime starts watches.
      - loopzero-system/loopzero-crds
    values:
      - ../../charts/loopzero-tenant-operator/values.yaml
      - config:
          giteaUrl: {{ $giteaURL | quote }}
        networkPolicy:
          giteaNamespace: {{ $giteaNamespace | quote }}
{{- if eq (.Values | get "clusterRole" "dev") "standalone" }}
      - ../../charts/loopzero-tenant-operator/values-standalone-multi.yaml
{{- end }}
      # Layered values per env (T2.2). Drill: DOCR registry + imagePullSecrets (Bug #23 fix).
      - values/{{ .Environment.Name }}/loopzero-tenant-operator.yaml.gotmpl

  - name: loopzero-app-operator
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    chart: ../../charts/loopzero-app-operator
    # STANDALONE: tilt owns operators. See finding-2026-05-22-pg-password-divergence.
    installed: {{ ne (.Values | get "clusterRole" "dev") "standalone" }}
    # CANONICAL FIX 2026-06-15 dev-public chain-gap (see loopzero-api at line 482).
    wait: false
    needs:
      - loopzero-system/loopzero-api
      - loopzero-system/loopzero-crds
    values:
      - ../../charts/loopzero-app-operator/values.yaml
{{- if eq (.Values | get "clusterRole" "dev") "standalone" }}
      - ../../charts/loopzero-app-operator/values-standalone-multi.yaml
{{- end }}
      # Layered values per env (T2.2). Drill: DOCR registry + imagePullSecrets.
      - values/{{ .Environment.Name }}/loopzero-app-operator.yaml.gotmpl

  - name: loopzero-preview-operator
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    chart: ../../charts/loopzero-preview-operator
    # STANDALONE: tilt owns operators. See finding-2026-05-22-pg-password-divergence.
    installed: {{ ne (.Values | get "clusterRole" "dev") "standalone" }}
    # CANONICAL FIX 2026-06-15 dev-public chain-gap (see loopzero-api at line 482).
    wait: false
    needs:
      - loopzero-system/loopzero-api
      - loopzero-system/loopzero-crds
    values:
      - ../../charts/loopzero-preview-operator/values.yaml
{{- if eq (.Values | get "clusterRole" "dev") "standalone" }}
      - ../../charts/loopzero-preview-operator/values-standalone-multi.yaml
{{- end }}
      # Layered values per env (T2.2). Drill: DOCR registry + imagePullSecrets.
      - values/{{ .Environment.Name }}/loopzero-preview-operator.yaml.gotmpl

  - name: loopzero-platform-operator
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    chart: ../../charts/loopzero-platform-operator
    # STANDALONE: tilt owns operators. See finding-2026-05-22-pg-password-divergence.
    installed: {{ ne (.Values | get "clusterRole" "dev") "standalone" }}
    # CANONICAL FIX 2026-06-15 dev-public chain-gap (see loopzero-api at line 482).
    wait: false
    needs:
      - loopzero-system/loopzero-api
      - loopzero-system/loopzero-crds
    values:
      - ../../charts/loopzero-platform-operator/values.yaml
      - networkPolicy:
          giteaNamespace: {{ $giteaNamespace | quote }}
{{- if eq (.Values | get "clusterRole" "dev") "standalone" }}
      - ../../charts/loopzero-platform-operator/values-standalone-multi.yaml
{{- end }}
      # Layered values per env (T2.2). Drill: DOCR registry + imagePullSecrets.
      - values/{{ .Environment.Name }}/loopzero-platform-operator.yaml.gotmpl

  - name: loopzero-cloud
    labels:
      profile: dashboard-only
    namespace: loopzero-system
    # The published chart, installed with charts/loopzero-cloud/values-bootstrap.yaml:
    # there is one loopzero-cloud chart (docs/decisions.md, "One chart per
    # bootstrap/published pair").
    chart: ../../charts/loopzero-cloud
    # Bug #29 LIVE fix (2026-05-17 iter 20): loopzero-cloud image not in DOCR
    # for drill. Skip — drill L2 harness goes through loopzero-api directly,
    # not loopzero-cloud dashboard. Production keeps loopzero-cloud installed.
    # STANDALONE: tilt owns loopzero-cloud (dual-ownership, same as loopzero-api).
    installed: {{ and .Values.profile.loopzeroCloud (ne (.Values | get "clusterRole" "dev") "standalone") }}
    # CANONICAL FIX 2026-06-15 dev-public chain-gap (see loopzero-api at line 482):
    # depends on loopzero-api Ready + loopzero-service-auth Secret; same self-recovery
    # pattern. helmfile sync applies manifests; pod cycles in CrashLoopBackOff
    # until bootstrap chain completes.
    wait: false
    needs:
      - loopzero-auth/ory-hydra
      - loopzero-system/loopzero-api
    values:
      - ../../charts/loopzero-cloud/values-bootstrap.yaml
      # Plan 2026-06-04-dev-public-docr-fix-forward T2.1 — env-specific
      # overlay (image channel, pull secret, per-environment URLs).
      - values/{{ .Environment.Name }}/loopzero-cloud.yaml.gotmpl
      # T3.1 of plan 2026-05-29-dashboard-public-integration-canonicalization.
      # When the environment provides publicAuthUrl (the browser-facing Kratos
      # host), the cloud API redirects the browser back to Kratos through it
      # (/v1/auth/session/token); uiBaseUrl is where Stripe checkout returns.
      # v1.1 EC-07: if-hasKey pattern (not | default) because empty string is
      # NOT treated as zero-value in Go templates.
      - config:
{{- if hasKey .Values "publicAuthUrl" }}
          kratosPublicUrl: {{ .Values.publicAuthUrl | trimSuffix "/" | quote }}
{{- end }}
{{- if hasKey .Values "uiBaseUrl" }}
          billingReturnUrl: {{ .Values.uiBaseUrl | trimSuffix "/" | quote }}
{{- end }}

  # The data plane (#446): memory, RAG and lens, one release each of one chart, every
  # service with its own Postgres. dev-public ran them as compose containers started from
  # directories that no longer exist; this is their versioned definition. Secrets come from
  # generate-secrets.sh (loopzero-data-plane namespace), images from `platformImages`.
{{- range $svc := list "loopzero-memory" "loopzero-rag" "loopzero-lens" }}
  - name: {{ $svc }}
    namespace: loopzero-data-plane
    chart: ../helm/data-plane-service
    installed: {{ has $svc ($.Values | get "dataPlane.services" list) }}
    wait: false
    values:
      - values/{{ $.Environment.Name }}/{{ $svc }}.yaml.gotmpl
{{- end }}

  # Wave 90: Chaos engineering (active-execution-plan §3.A.4, iter 2)
  # Sprint 8 T0.3 installed CRDs via separate path; this release wires the
  # controller via the `loopzero-chaos-mesh` wrapper chart (infra/helm/chaos-mesh)
  # so all clusters bootstrap the controller consistently. Opt-in: only
  # installs when `installChaosMesh: true` in environment values. Default
  # false so prod + dev don't carry the controller unnecessarily; chaos
  # validation env opts in explicitly.
  # Iter 44 of plan 2026-06-10-j22-openbao-transit-eso-sync v1.2
  # (Option B per docs/runbooks.md § B1).
  # ESO controller in mgmt cluster enables full T4.1 6/6 LIVE scenarios.
  # Same version (0.14.3) as runtime helmfile to prevent cross-cluster
  # drift — locked by infra/tests/check-option-b-eso-deploy-doc_test.sh § E1.
  # No `needs:` deps required — ESO has no transitive deps within mgmt chain.
  - name: external-secrets
    namespace: external-secrets
    chart: external-secrets/external-secrets
    version: 0.14.3
    values:
      - ../helm/external-secrets/values.yaml

  - name: chaos-mesh
    namespace: chaos-mesh
    chart: ../helm/chaos-mesh
    installed: {{ .Values | get "installChaosMesh" false }}
    values:
      - ../helm/chaos-mesh/values.yaml
{{- /* Plan T3.2 D10 — k3d/k3s containerd socket override.
       Standalone (k3d) deploys k3s under the hood, which puts containerd at
       /run/k3s/containerd/. Managed K8s (DOKS, EKS, GKE) use the default. */}}
{{- if eq (.Values | get "clusterRole" "dev") "standalone" }}
      - ../helm/chaos-mesh/values-k3d.yaml
{{- end }}

  # Wave 99: Validation
  - name: smoke-test
    namespace: loopzero-system
    chart: ../helm/smoke-test
    # Bug #29 LIVE fix: skip in drill — depends on loopzero-cloud (skipped).
    # Drill validates via Phase 6 L2 harness directly.
    # STANDALONE: depends on the tilt-owned app tier (loopzero-api/cloud/operators),
    # so skip the helmfile smoke-test locally too. See finding-2026-05-22-pg-password-divergence.
    #
    # DEV-PUBLIC (2026-06-15 canonical chain-gap closure): smoke-test is a
    # Helm POST-INSTALL HOOK (`helm.sh/hook: post-install`), so `wait: false`
    # does NOT bypass it (hooks always block helm install). The Job's
    # `init-wait` container probes loopzero-api /health which is CrashLoopBackOff
    # until LATER `task bootstrap:standalone` provisions argocd-refresh-credentials
    # + ClusterCredentials. The Job fails with BackoffLimitExceeded, taking
    # the whole helmfile sync with it. Canonical fix: skip smoke-test in
    # dev-public too — `task doctor` validates post-bootstrap health (the
    # same gate dogfood and chaos use). Matches the standalone reasoning.
    # PROD keeps smoke-test installed (no bootstrap chain race: prod Secrets
    # exist at sync time via External Secrets Operator + manual seeded SOPS).
    installed: {{ and .Values.profile.smokeTest (ne (.Values | get "clusterRole" "dev") "standalone") }}
    needs:
      - loopzero-system/loopzero-api
{{- if .Values.profile.loopzeroCloud }}
      - loopzero-system/loopzero-cloud
{{- end }}
      - loopzero-system/loopzero-tenant-operator
      - loopzero-system/loopzero-app-operator
      - loopzero-system/loopzero-preview-operator
      - loopzero-system/loopzero-platform-operator
    values:
      - ../helm/smoke-test/values.yaml

  # D4 delete guardrail (plan d4-vap-delete-guardrail, T1.2).
  #
  # Second install of the admission-policies chart. The first lives in
  # cell.helmfile.yaml.gotmpl and guards workloads; this one guards the mgmt boundary
  # resources (Application, AppProject, Tenant, Environment, ClusterCredential) and their
  # CRDs, which live HERE and had no admission policy at all before this release existed.
  #
  # Deliberately NO `needs: cosign-system/policy-controller`. That dependency belongs to the
  # runtime install, where the policies are cosign-related. ValidatingAdmissionPolicy is a
  # native Kubernetes feature (1.30+; mgmt is pinned at 1.32) and needs no controller, so
  # copying the runtime block wholesale would invent a dependency that does not exist on
  # this cluster and would block the sync.
  - name: admission-policies-mgmt
    namespace: loopzero-system
    chart: ../../charts/loopzero-admission-policies
    values:
      - ../../charts/loopzero-admission-policies/values.yaml
      - ../../charts/loopzero-admission-policies/values-mgmt.yaml
