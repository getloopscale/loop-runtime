# .themory.env — sourced by start-themory.sh BEFORE the server boots.
# Copy to .themory.env (gitignored) and fill in YOUR values.
#
# All keys here are optional; if omitted, the script falls back to defaults
# documented in start-themory.sh.

# --- PostgreSQL connection (REQUIRED if your local PG needs auth) ---
# Example values for the existing themem_pgvector Docker container:
PGURL=postgresql://themem:themem@localhost:5432/postgres
PGURL_BASE=postgresql://themem:themem@localhost:5432

# --- LLM provider (REQUIRED — TheMemory's extraction pipeline calls an LLM) ---
# OpenRouter (recommended; matches loopruntime-memory CLAUDE.md default):
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# Set OPENAI_API_KEY to your OpenRouter API key.
# OPENAI_API_KEY=sk-or-v1-...

# Optional model selection (defaults to whatever TheMemory ships):
# LOOPRUNTIMEMEM_LLM_PROVIDER=openrouter
# LOOPRUNTIMEMEM_LLM_MODEL=openai/gpt-4o-mini

# --- TheMemory port/host overrides ---
# THEMORY_PORT=8080
# THEMORY_HOST=0.0.0.0

# --- Health probe timeout (seconds) ---
# HEALTH_TIMEOUT=30
