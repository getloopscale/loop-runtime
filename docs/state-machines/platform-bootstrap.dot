digraph PlatformBootstrap {
	rankdir=LR;
	node [shape=circle, fontsize=10];
	edge [fontsize=8];

	"" [shape=circle];
	"BootstrapComplete" [shape=doublecircle];
	"ConfiguringArgoCD" [shape=circle];
	"ConfiguringGitea" [shape=circle];
	"Failed" [shape=doublecircle];
	"Pending" [shape=circle];
	"WaitingForAPI" [shape=circle];

	"" -> "Pending" [label="Start"];
	"ConfiguringArgoCD" -> "WaitingForAPI" [label="ArgoCDReady"];
	"ConfiguringArgoCD" -> "Failed" [label="RetryExhausted"];
	"ConfiguringGitea" -> "ConfiguringArgoCD" [label="GiteaReady"];
	"ConfiguringGitea" -> "Failed" [label="RetryExhausted"];
	"Pending" -> "ConfiguringGitea" [label="Start"];
	"WaitingForAPI" -> "BootstrapComplete" [label="APISeeded"];
	"WaitingForAPI" -> "Failed" [label="RetryExhausted"];
}
