digraph Environment {
	rankdir=LR;
	node [shape=circle, fontsize=10];
	edge [fontsize=8];

	"" [shape=circle];
	"Active" [shape=circle];
	"Deleting" [shape=doublecircle];
	"Failed" [shape=circle];
	"Pending" [shape=circle];

	"" -> "Pending" [label="Create"];
	"" -> "Deleting" [label="DeleteRequested"];
	"Active" -> "Deleting" [label="DeleteRequested"];
	"Failed" -> "Deleting" [label="DeleteRequested"];
	"Failed" -> "Pending" [label="Retry"];
	"Pending" -> "Deleting" [label="DeleteRequested"];
	"Pending" -> "Failed" [label="ProvisionFailed"];
	"Pending" -> "Active" [label="Provisioned"];
}
