digraph Promotion {
	rankdir=LR;
	node [shape=circle, fontsize=10];
	edge [fontsize=8];

	"COMMITTING" [shape=circle];
	"COMMIT_FAILED" [shape=doublecircle];
	"COMPLETED" [shape=doublecircle];
	"REJECTED" [shape=doublecircle];
	"SYNCING" [shape=circle];
	"SYNC_FAILED" [shape=doublecircle];
	"VALIDATING" [shape=circle];

	"COMMITTING" -> "SYNCING" [label="CommitCompleted"];
	"COMMITTING" -> "COMMIT_FAILED" [label="CommitFailed"];
	"SYNCING" -> "COMPLETED" [label="SyncCompleted"];
	"SYNCING" -> "SYNC_FAILED" [label="SyncFailed"];
	"VALIDATING" -> "REJECTED" [label="ValidationFailed"];
	"VALIDATING" -> "COMMITTING" [label="ValidationPassed"];
}
