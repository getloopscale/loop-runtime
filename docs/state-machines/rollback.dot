digraph Rollback {
	rankdir=LR;
	node [shape=circle, fontsize=10];
	edge [fontsize=8];

	"BLOCKED" [shape=doublecircle];
	"COMPLETED" [shape=doublecircle];
	"REJECTED" [shape=doublecircle];
	"REVERTING" [shape=circle];
	"REVERT_FAILED" [shape=doublecircle];
	"SYNCING" [shape=circle];
	"SYNC_FAILED" [shape=doublecircle];
	"VALIDATING" [shape=circle];

	"REVERTING" -> "SYNCING" [label="RevertCompleted"];
	"REVERTING" -> "REVERT_FAILED" [label="RevertFailed"];
	"SYNCING" -> "COMPLETED" [label="SyncCompleted"];
	"SYNCING" -> "SYNC_FAILED" [label="SyncFailed"];
	"VALIDATING" -> "BLOCKED" [label="NoPreviousRelease"];
	"VALIDATING" -> "REJECTED" [label="UnacknowledgedEffects"];
	"VALIDATING" -> "REVERTING" [label="ValidationPassed"];
}
