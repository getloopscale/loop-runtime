@startuml C4-Container-Governance-PROPOSED
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/release/2-decorations/C4_Container.puml

' <!-- PROPOSED STATE -->
title Documentation Governance — Container View (PROPOSED, post-Phase-6)

Person(reader, "Reader")

System_Boundary(governance, "Documentation Governance System (PROPOSED)") {

  ' Canonical hub
  Container(status_md, "docs/STATUS.md", "Markdown + AUTO sections", "Single source of truth — 7 mandatory sections")

  ' Evidence layer (NEW)
  ContainerDb(evidence_files, "docs/evidence/**.md", "Markdown w/ YAML frontmatter", "Per-dim per-claim 3-source evidence")

  ' Governance docs (NEW)
  ContainerDb(governance_policies, "docs/governance/", "Markdown + YAML catalog", "evidence-bar / decay-policy / bias-taxonomy / personas / claim-catalog (348)")

  ' Architecture (NEW domain)
  ContainerDb(arch_governance, "docs/architecture/governance/", "PlantUML + Excalidraw", "C4 (AS-IS + PROPOSED) + 4 concept diagrams")

  ' Redirects (formerly canonical surfaces)
  Container(claude_md, "CLAUDE.md", "Markdown ~470-char block", "Redirect to STATUS.md (was 6000 chars)")
  Container(maturity_redirect, "docs/maturity-assessment.md", "Markdown redirect", "Pointer + history index")
  ContainerDb(history, "docs/maturity-history/", "Dated snapshots", "Read-only YYYY-MM-DD snapshots")

  ' Validation scripts (NEW)
  Container(scripts, "infra/scripts/governance/", "Bash + Python", "8 scripts: validator / scanner / classifier / extractor / triangulator / bias-check / regen / spotcheck")

  ' CI automation (NEW)
  Container(ci_workflows, ".github/workflows/", "5 YAML workflows", "decay-scan / cross-validation-weekly / status-refresh / adversarial-spotcheck / status-pr-gate")

  ' Reusable action (NEW)
  Container(notify_action, ".github/actions/governance-notify/", "Composite action", "Slack/email notification (reusable)")

  ' Unchanged surfaces
  ContainerDb(plans, "docs/plans/", "Markdown", "Per-effort plans")
  ContainerDb(meetings, "docs/meetings/", "Markdown", "ADRs (now includes 0051) + records")
  ContainerDb(runbooks, "docs/runbooks/", "Markdown", "Operational procedures")
}

System_Ext(github, "GitHub Actions runner")
System_Ext(slack, "Slack (optional notify)")

Rel(reader, status_md, "Reads (single hub)")
Rel(claude_md, status_md, "Redirects")
Rel(maturity_redirect, status_md, "Redirects")
Rel(maturity_redirect, history, "Links snapshots")

Rel(status_md, evidence_files, "Cites per claim")
Rel(evidence_files, scripts, "Validated by")
Rel(scripts, governance_policies, "Consume schemas/policies")
Rel(arch_governance, status_md, "Documents")

Rel(ci_workflows, scripts, "Invoke")
Rel(ci_workflows, status_md, "Auto-refresh")
Rel(ci_workflows, evidence_files, "Pre-merge validate")
Rel(ci_workflows, notify_action, "Use for alerts")
Rel(notify_action, slack, "POST webhook")
Rel(github, ci_workflows, "Schedule + trigger")

note right of governance
  **DELTAS from AS-IS:**
  + NEW: docs/STATUS.md (canonical)
  + NEW: docs/evidence/** (50-80 files target)
  + NEW: docs/governance/** (policies + personas + catalog)
  + NEW: docs/architecture/governance/** (domain itself)
  + NEW: docs/maturity-history/** (read-only)
  + NEW: 8 governance scripts in infra/scripts/governance/
  + NEW: 5 CI workflows + 1 composite action
  ~ CHANGED: CLAUDE.md (6000 → 470 chars)
  ~ CHANGED: maturity-assessment.md (250 LOC narrative → redirect)
end note

@enduml
