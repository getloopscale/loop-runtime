    {"type":"text","version":1,"versionNonce":250001,"isDeleted":false,"id":"good-math","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":1,"opacity":100,"angle":0,"x":60,"y":400,"strokeColor":"#047857","backgroundColor":"transparent","width":500,"height":80,"seed":2500,"groupIds":[],"frameId":null,"roundness":null,"boundElements":[],"updated":1715472000000,"link":null,"locked":false,"fontSize":13,"fontFamily":3,"text":"3/3 dimensions varied + cross-vendor → cap confidence 95-97%\n  1 - (1 - 0.9)³ = 99.9% loopzeroretical\n  realistic cap 95-97% (correlation: fixtures, CI re-runs, alignment)","textAlign":"left","verticalAlign":"top","baseline":11,"containerId":null,"originalText":"3/3 dimensions varied + cross-vendor → cap confidence 95-97%\n  1 - (1 - 0.9)³ = 99.9% loopzeroretical\n  realistic cap 95-97% (correlation: fixtures, CI re-runs, alignment)"},

