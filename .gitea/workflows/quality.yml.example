# T0.2 POC: Gitea Actions workflow for PR-time `task quality:gates`.
# DISABLED-BY-DEFAULT (.example suffix). Sponsor renames after Scenario A
# meeting approval per ADR-2026-05-27-T0.2.
#
# After enabling:
#   1. Branch protection rule: require status check "quality" to PASS before
#      merge (Gitea repo settings → Branches → develop → Required checks).
#   2. PRs targeting develop trigger this workflow.
#   3. Failure → merge button disabled until fix push re-runs gates.
#
# Mirrors GHA syntax for max portability; if Scenario A trial fails, this
# file moves verbatim to .github/workflows/ for Scenario C fallback (the
# `task quality:gates` invocation is runner-agnostic).

name: quality

on:
  pull_request:
    branches: [develop, main]
  push:
    branches: [develop]

jobs:
  gates:
    name: task quality:gates
    runs-on: ubuntu-latest  # Gitea Actions matches GHA runner labels
    timeout-minutes: 15
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0  # full history for git-diff gates

      - name: Setup Go
        uses: actions/setup-go@v5
        with:
          go-version-file: api/go.mod
          cache: true

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
          cache-dependency-path: cli/package-lock.json

      - name: Install Task
        run: |
          sh -c "$(curl --location https://taskfile.dev/install.sh)" -- -d -b /usr/local/bin

      - name: Build loopruntime-ops binary
        run: |
          go build -o /tmp/loopruntime-ops ./cmd/loopruntime-ops

      - name: Run task quality:gates
        run: |
          task quality:gates
        env:
          # Gates that need git base reference for PR-diff mode
          BASE_REF: ${{ github.event.pull_request.base.sha || 'origin/main' }}

      - name: Upload artifacts on failure
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: quality-gate-output
          path: |
            /tmp/quality-*.log
            /tmp/quality-*.json
          retention-days: 7
