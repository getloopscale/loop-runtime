# LoopRuntime local development credentials
# Copy to .env.local and customize values
# Never commit .env.local to version control
#
# Usage:
#   cp .env.example .env.local
#   # Edit .env.local with your values
#   task dev:up   # Taskfile loads .env.local automatically via dotenv

PG_USER=loop_runtime
PG_PASS=your-dev-password
PG_DB=loop_runtime

# Read by generate-secrets.sh into the gitea-admin Secret, which every token
# seed takes the Gitea admin identity from.
LOOP_RUNTIME_GITEA_ADMIN_USER=gitea_admin
LOOP_RUNTIME_GITEA_ADMIN_PASSWORD=your-dev-password

MINIO_ROOT_USER=loop-runtime-admin
MINIO_ROOT_PASSWORD=your-dev-password

GRAFANA_ADMIN_PASSWORD=your-dev-password

LOOP_RUNTIME_ARGO_CALLBACK_SECRET=your-callback-secret
